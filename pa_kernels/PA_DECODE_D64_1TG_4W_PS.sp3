// ============================================================================
// Persistent Paged Attention Decode Kernel for AMD MI400 (CDNA4)
// ============================================================================
// Design based on MI400 Paged Attention plan:
//   HeadDim=64, PageSize=256, TileQ=32, GQA=8, FP8 KV Cache
//
// Reference: MXFP8_FMHA_DECODE_D128_1TG_4W_64mx4_128nx1#2.sp3
//   Adapted from dense FMHA to paged attention with block_tables lookup.
//
// Key differences from reference:
//   1. Block table lookup for K/V physical address translation
//   2. HeadDim=64 (vs 128)
//   3. Per-tensor scalar scales (query_scale, key_scale, value_scale)
//   4. Q is FP8 input in the original host layout  // kernel reads it into the
//      WMMA-B layout without changing the host buffer
//   5. Persistent/split-KV interface compatible with PA_PS.cpp
//   6. GEMM_QK uses v_wmma_f32_16x16x64_fp8 (no scale, K=64)
//   7. GEMM_PV uses v_wmma_f32_16x16x128_f8f6f4 (no scale, K=128)
//   8. Dequant is folded into softmax via scl_log2e = query_scale * key_scale * log2(e)
//   9. D = D * value_scale at finalization
//
// WMMA instruction summary:
//   GEMM_QK: v_wmma_f32_16x16x64_fp8
//     - A: 16x64 FP8 (8 VGPR), B: 16x64 FP8 (8 VGPR), C/D: 16x16 FP32 (8 VGPR)
//     - Computes S[TileQ × tokens] = Q[TileQ × 64] × K^T[64 × tokens]
//     - K=64 = HeadDim, entire reduction in one instruction per output tile
//
//   GEMM_PV: v_wmma_f32_16x16x128_f8f6f4
//     - A: 16x128 FP8 (16 VGPR), B: 16x128 FP8 (16 VGPR), C/D: 16x16 FP32 (8 VGPR)
//     - Computes D[TileQ × HeadDim] += P[TileQ × 128] × V[128 × HeadDim]
//     - K=128 tokens reduced per instruction  // one 256-token page → 2 k-batches
//
// SPI registers:
//   s2 = tgid_x  -> persistent TG slot
//   s3/s4        -> unused in persistent mode
//   v0 = thread_idx (0..31 within wave)
//
// Grid:
//   global_size_x = available_tgs * 128
//   global_size_y = 1
//   global_size_z = 1
//   local_size_x  = 128 (4 waves * 32 threads)
//   local_size_y  = 1
//   local_size_z  = 1
// ============================================================================

// ============================================================================
// Section 1: Constants & Configuration
// ============================================================================

var QK_H_DIM           = 64        // Query/Key head dimension
var V_H_DIM            = 64        // Value head dimension
var PAGE_SIZE           = 256       // KV cache page (block) size in tokens
var PAGE_SIZE_LOG2      = 8
var Q_BPP               = 1        // FP8 = 1 byte
var KV_BPP              = 1        // FP8 = 1 byte
var R_BPP               = 2        // output bfloat16 = 2 bytes
var WAVES               = 4
var WAVES_LOG2          = 2
var GQA_RATIO           = 8        // 8 query heads per KV head

// Compile-time causal-mask switch.
//   0 = non-causal (dense attention, only MTP-invalid rows zeroed)
//   1 = causal     (row r uses border = seq_len - mtp + (r / GQA_RATIO))
var CAUSAL              = 1

// Attention sink (GPT-OSS style). Per-q-head extra logit added as a virtual
// "sink" token into the softmax denominator. Implementation notes:
//   - ENABLE_SINK == 0  => ALL sink code is gated out at compile time. The
//     emitted bytecode must be byte-identical to the .btpf_ve baseline.
//   - ENABLE_SINK == 1  => SINK kArg ptr is reloaded into scratch (s_tmp0:s_tmp1)
//     inside the work loop per iteration — no new persistent SGPR needed,
//     keeping us within the 106-SGPR cap.
//   - pa_normalize_output_fp32 takes a do_sink param: pa_finalize_output passes
//     1 (merge sink into final L)  // split-KV partial path passes 0 (host
//     reduction handles sink).
var ENABLE_SINK         = 1

// WMMA instruction parameters
// GEMM_QK: v_wmma_f32_16x16x64_fp8_fp8  (K=64)
// GEMM_PV: v_wmma_f32_16x16x128_f8f6f4  (K=128)
var INST_M              = 16
var INST_N              = 16
var INST_K_QK           = 64        // Reduction dim for GEMM_QK (= HeadDim)

var BYTES_PER_VGRP      = 32 * 4   // 32 lanes * 4 bytes = 128 bytes per VGPR

// ---- FP32 bit-pattern constants (used as inline literals in v_* ALU ops) ----
var kE4M3Max            = 0x43e00000    // 448.0 f32 (OCP E4M3 absolute max finite)
var kE4M3MaxInv         = 0x3b124925    // ~1/448 f32 (inverse of kE4M3Max)
var kOneF32             = 0x3f800000    // 1.0 f32
var kLog2eF32           = 0x3fb8aa3b    // log2(e) f32
var Vsrc63_48           = 0x00000000
var Vsrc95_64           = 0x80000000
var Vsrc127_96          = 0x00020000

// KV tile design per wave (no SU concept):
//   Each wave processes one 64×256 KV tile per iteration
//   K: 256 tokens × 64 HeadDim = 16KB, split across 4 msb segments
//   V: 256 tokens × 64 HeadDim = 16KB, split across 4 msb segments
//
//   K per msb: 64 tokens × 64 dim = 4096 bytes = 32 VGPRs
//     msb 0: tokens 0-63,   msb 1: tokens 64-127
//     msb 2: tokens 128-191, msb 3: tokens 192-255
//
//   V per msb: 16 dim × 256 tokens = 4096 bytes = 32 VGPRs
//     msb 0: dim 0-15,  msb 1: dim 16-31
//     msb 2: dim 32-47, msb 3: dim 48-63

var NUM_MSB_SEGMENTS    = 4                             // 4 VGPR segments
var V_DIM_PER_MSB       = V_H_DIM / NUM_MSB_SEGMENTS    // 16 dim per msb
var KV_VGPR_PER_MSB     = 32                            // 32 VGPRs per msb segment

// For GQA_RATIO=8 query heads, TileQ=32 (2 WMMA M-tiles of 16)
var TILE_Q              = 32

// GEMM_QK tiling:
//   M tiles (Q rows) = TILE_Q / INST_M = 2
//   N tiles (KV tokens) = PAGE_SIZE / INST_N = 16
var G1_M_TILES          = TILE_Q / INST_M           // 2
var G1_N_TILES          = PAGE_SIZE / INST_N        // 16

// GEMM_PV tiling:
//   M tiles (Q rows) = TILE_Q / INST_M = 2
//   N tiles (head_dim) = V_H_DIM / INST_N = 4
var G2_M_TILES          = TILE_Q / INST_M            // 2
var G2_N_TILES          = V_H_DIM / INST_N           // 4

print "G1_M_TILES (QK): ", G1_M_TILES
print "G1_N_TILES (QK): ", G1_N_TILES
print "G2_M_TILES (PV): ", G2_M_TILES
print "G2_N_TILES (PV): ", G2_N_TILES

// ============================================================================
// Section 2: LDS Layout
// ============================================================================
// LDS is organized as 16 fixed 16KB blocks starting at 32KB:
//   Buffer 0 K: Blocks 0-3   (k0_tile0, k0_tile1, k0_tile2, k0_tile3)
//   Buffer 1 K: Blocks 4-7   (k1_tile0, k1_tile1, k1_tile2, k1_tile3)
//   Buffer 0 V: Blocks 8-11  (v0_tile0, v0_tile1, v0_tile2, v0_tile3)
//   Buffer 1 V: Blocks 12-15 (v1_tile0, v1_tile1, v1_tile2, v1_tile3)
//
// PRODUCER / CONSUMER mapping (UNILOAD Opt-40):
//   Every wave is self-contained: wave w loads ONE K tile + ONE V tile per iter
//   (page = s_loader_base_page = s_KV_start + w) and later reads back that same
//   physical tile. Producer and consumer therefore use the identical per-wave
//   LDS offset (s_TDM_wave_offset == s_LDS_wave_offset), so the slot always
//   holds the page that wave will consume — no cross-wave slot sharing.
//
//   PHYSICAL TILE PLACEMENT is bit-swapped, not monotonic (SMXBC fix):
//     wave w owns physical tile bit_swap(w):  0->0, 1->2, 2->1, 3->3.
//   This is purely an LDS-segment-conflict avoidance measure (see Section "Set
//   up LDS wave offsets" near s_LDS_wave_offset). It does NOT change which page
//   wave w processes — only where in LDS that page lives. With buffers based at
//   32KB, the swap keeps SIMD pair {0,2} in one 64KB segment and pair {1,3} in
//   the next, so the two pairs never collide on a segment.
//
// Each tile = 1 page = 256 tokens × 64 dim = 16KB (FP8).
// Ping-pong: buffer 0 and buffer 1 are filled IN FULL during prefetch.
//   The main loop consumes one buffer-half (LDS->regs) while issuing TDM
//   for the OTHER half via the loader waves.
//
// Per iteration: 4 waves process 4 consecutive pages = 1024 tokens.
// Page stride per compute wave = WAVES = 4 (compute wave i processes pages
// derived from data loaded by its assigned loader, advancing by WAVES/iter).
//
// Q is loaded directly into VGPRs from global memory (no LDS staging)

var LDS_START           = 32 * 1024     // LDS data starts at 32KB
var LDS_BLOCK_SIZE      = 16 * 1024     // Each block is 16KB (1 page per wave)
var LDS_BLOCKS_PER_BUF  = 4             // 4 blocks per buffer (1 per wave)
var LDS_PADDING         = 16            // 4 DWORDs padding per row

// K tile dimensions in LDS (each 16KB sub-block is one K page).
// PRE-TRANSPOSED K: HBM/LDS page = [head_dim/16, block_size, 16] = [4, 256, 16].
//   byte = (dim/16)*(block_size*16) + token*16 + (dim%16)
// The TDM copy is layout-agnostic — it moves a contiguous 16KB page unchanged,
// so the in-LDS byte image equals the HBM image. K_LDS_rd_addr_gen / K_LDS_load
// re-derive the WMMA-A operand from this transposed image (see those functions).
var K_TILE_DIM0         = *[PAGE_SIZE / 4, QK_H_DIM, KV_BPP]  // 4096 B (legacy; superseded by K_LDS_*_STRIDE)
// Transposed-K LDS read strides (bytes), used by every K_LDS_load offset site:
//   pair  = K[5:4] = head_dim/16 group  -> stride = block_size * 16
//   msb   = 64-token group              -> stride = 64 * 16
//   n_sub = 16-token group              -> stride = 16 * 16
//   token (lane[3:0])                   -> stride = 16   (in K_LDS_rd_addr_gen)
var K_LDS_DHI_STRIDE    = PAGE_SIZE * 16                          // 4096: between 16-dim head groups
var K_LDS_MSB_STRIDE    = (PAGE_SIZE / NUM_MSB_SEGMENTS) * 16     // 1024: 64-token msb group
var K_LDS_NSUB_STRIDE   = INST_M * 16                             // 256: 16-token n_sub group
// TDM-side tile shape: a contiguous 16KB page copied as 16 rows × 1024 bytes.
// Row count/width is just the chunking of the contiguous copy and does not
// depend on the (token-major vs transposed) interpretation of the bytes.
var K_TDM_TILE_DIM0     = *[INST_M, QK_H_DIM, KV_BPP]          // 1024 bytes per TDM row
var K_TDM_TILE_DIM1     = PAGE_SIZE / INST_M                   // 16 TDM rows (16KB total)

// V tile dimensions in LDS (each 16KB sub-block is 16×1024)
// V shape in HBM: [block_size//16, head_dim, 16] = [16, 64, 16]
// TDM sub-block view: [16, 1024] - 16 rows, 1024 bytes/row
//   Each row = 16 tokens across all HeadDim = 16 × 64 = 1024 bytes
//   16 rows × 16 tokens/row = 256 tokens per sub-block
//   One sub-block = one complete V page = 16KB
var V_TILE_DIM0         = *[V_H_DIM, 16]                   // 1024 bytes per row (64 dim × 16 tokens)
var V_TILE_DIM1         = PAGE_SIZE / 16                   // 16 rows

// Buffer sizes: 4 blocks of 16KB each per buffer = 64KB per buffer
var BLK_IN_LDS          = 2    // ping-pong buffers

var K_LDS_BUF_SIZE      = LDS_BLOCKS_PER_BUF * LDS_BLOCK_SIZE     // 64KB per K buffer
var K_LDS_SIZE          = K_LDS_BUF_SIZE * BLK_IN_LDS              // 128KB total for K

var V_LDS_BUF_SIZE      = LDS_BLOCKS_PER_BUF * LDS_BLOCK_SIZE     // 64KB per V buffer
var V_LDS_SIZE          = V_LDS_BUF_SIZE * BLK_IN_LDS              // 128KB total for V

// LDS base addresses (starting at 32KB)
var K_LDS_BASE          = LDS_START                        // blocks 0-7
var V_LDS_BASE          = K_LDS_BASE + K_LDS_SIZE          // blocks 8-15

// LDS segment size per wave: each wave has its own 16KB tile within each buffer
// Wave i uses tile i within each K/V buffer (4 waves, 4 tiles per buffer)
var LDS_SEG_SIZE        = LDS_BLOCK_SIZE      // 16KB per wave

print "LDS_START: ", LDS_START
print "K_LDS_BASE: ", K_LDS_BASE
print "K_LDS_BUF_SIZE: ", K_LDS_BUF_SIZE
print "K_LDS_SIZE: ", K_LDS_SIZE
print "V_LDS_BASE: ", V_LDS_BASE
print "V_LDS_BUF_SIZE: ", V_LDS_BUF_SIZE
print "V_LDS_SIZE: ", V_LDS_SIZE

// ds_load sizes
var DS_LOAD_64_SIZE     = 64  / 8 * 32     // 256 bytes per instruction

// ds_load instruction counts per msb segment (no SU concept)
// K per msb: 64 tokens × 64 dim = 4096 bytes → 16 ds_load_b64
//   (b64 chosen because each lane needs 4 × 8-byte chunks at K[5:4] strides
//    of 16 bytes — see K_LDS_load below  // b128 would not match WMMA-A layout.)
// V per msb: 16 dim × 256 tokens = 4096 bytes → 32 ds_load_b32
//   (b32 chosen to materialize the exact WMMA-A data-plane layout:
//    lane={K[3],M[3:0]}, vgpr={K[6],K[5],K[4],K[2]}, byte=K[1:0].)

// ============================================================================
// Section 3: Register Allocator (from reference)
// ============================================================================

var _sgpr_next = [2]
var _sgpr_max  = _sgpr_next[0]

var VGPR_SEG_SIZE = 256
var _vgpr_next = [1, VGPR_SEG_SIZE, VGPR_SEG_SIZE * 2, VGPR_SEG_SIZE * 3]
var VGPR_SEG_NUM = len(_vgpr_next)

function allocate_sgpr(param size, (param align))
  assert(size != 0)
  if !assigned(align)
    align = 1
  end
  assert((align & (align - 1)) == 0)
  var top = len(_sgpr_next) - 1
  var next = _sgpr_next[top]
  var idx = (next + align - 1) & ~(align - 1)
  if idx != next
    print "SGPR hole at :", next, " -> ", idx
  end
  next = idx + size
  _sgpr_max = next >: _sgpr_max
  _sgpr_next[top] = next
  return s[idx]
end

function allocate_vgpr(param size, (param msb), (param align))
  assert(size != 0)
  if !assigned(msb)
    msb = 0
  end
  assert(msb < VGPR_SEG_NUM)
  if !assigned(align)
    align = 1
  end
  assert((align & (align - 1)) == 0)
  var next_idx = len(_vgpr_next) - VGPR_SEG_NUM + msb
  var next = _vgpr_next[next_idx]
  var idx = (next + align - 1) & ~(align - 1)
  if idx != next
    print "VGPR hole at :", next, " -> ", idx + 0
  end
  assert(idx + size <= (msb + 1) * VGPR_SEG_SIZE)
  _vgpr_next[next_idx] = idx + size
  return v[idx]
end

function get_vgpr_msb(reg vgpr)
  var idx = get_reg_index(vgpr)
  if idx < VGPR_SEG_SIZE
    return 0
  elsif idx < VGPR_SEG_SIZE * 2
    return 1
  elsif idx < VGPR_SEG_SIZE * 3
    return 2
  elsif idx < VGPR_SEG_SIZE * 4
    return 3
  else
    assert(0)
  end
end

function v_8bit(reg vgpr)
  var idx = get_reg_index(vgpr) % VGPR_SEG_SIZE
  return v[idx]
end

function s_regs(reg sgpr, param offset)
  var idx = get_reg_index(sgpr) + offset
  return s[idx]
end

// VGPR MSB tracking (same as reference)
var MSB_SRC0_SHFT = 0
var MSB_SRC0_MASK = 0x3 << MSB_SRC0_SHFT
var MSB_SRC1_SHFT = 2
var MSB_SRC1_MASK = 0x3 << MSB_SRC1_SHFT
var MSB_SRC2_SHFT = 4
var MSB_SRC2_MASK = 0x3 << MSB_SRC2_SHFT
var MSB_DST0_SHFT = 6
var MSB_DST0_MASK = 0x3 << MSB_DST0_SHFT

var _last_vgpr_msb = 0
function reset_vgpr_msb
  // Branch targets can inherit a hardware VGPR MSB state that differs from
  // this compile-time tracker. Force both back to segment 0 before code paths
  // that use local scratch VGPRs (v_tmp0..v_tmp3).
  s_set_vgpr_msb 0
  _last_vgpr_msb = 0
end

function set_vgpr_msb(param warning, (reg dst), (reg src0), (reg src1), (reg src2))
  var msb = _last_vgpr_msb
  if !assigned(warning)
    warning = 0
  end
  if assigned(src0)
    msb = (msb & ~MSB_SRC0_MASK) | get_vgpr_msb(src0)
  end
  if assigned(src1)
    msb = (msb & ~MSB_SRC1_MASK) | (get_vgpr_msb(src1) << MSB_SRC1_SHFT)
  end
  if assigned(src2)
    msb = (msb & ~MSB_SRC2_MASK) | (get_vgpr_msb(src2) << MSB_SRC2_SHFT)
  end
  if assigned(dst)
    msb = (msb & ~MSB_DST0_MASK) | (get_vgpr_msb(dst) << MSB_DST0_SHFT)
  else
    msb = 0
  end
  if _last_vgpr_msb != msb
    s_set_vgpr_msb msb
    _last_vgpr_msb = msb
  end
end

var QUIET = 0

// ============================================================================
// Section 4: Instruction Result Tracking (from reference)
// ============================================================================

var INST_RESULT_NUM      = 5
var INST_COUNT_IDX       = 0
var INST_CYCLE_IDX       = 1
var INST_STATE_IDX       = 2
var INST_TYPE_IDX        = 3
var INST_UDATA_IDX       = 4

var INST_STATE_RUN       = 0x0
var INST_STATE_FINISHED  = 0x1
var INST_STATE_DRY_RUN   = 0x2

var INST_TYPE_VALU       = 0x1
var INST_TYPE_SALU       = 0x2
var INST_TYPE_MEM        = 0x3
var INST_TYPE_LDS        = 0x4
var INST_TYPE_TRANS       = 0x5
var INST_TYPE_WMMA       = 0x6

var START_RESULT         = zeros(INST_RESULT_NUM)
var TRUE = 1
var FALSE = 0
var NEG_INF = 0xff800000
var MIN_F32 = 0xff7fffff
// MAXINIT: running-max init sentinel. Must be (a) below any real Q·K score so it
// never wins the max, yet (b) small enough in magnitude that scl_log2e * MAX_INIT
// does NOT overflow fp32. Masked scores are set to true -inf (v_NEG_INF); a
// fully-masked row therefore keeps this init as its max. The softmax forms
// scl_log2e*curr_max - scl_log2e*new_max and the exp-arg scl_log2e*max. With the
// old MIN_F32 (-3.4e38) init, scl_log2e*MIN_F32 overflows to -INF once
// scl_log2e>1 (large query_scale*key_scale), and (-INF)-(-INF)=NaN -> the whole
// split NaNs (the scale>=2 failure). -2^66 (~-7.4e19) keeps scl*init finite for
// any scl up to ~4e18 while staying far below real scores (|score|<~1.3e7).
var MAX_INIT = 0xe0800000   // -2^66 f32 (MAXINIT overflow-safe running-max init)

function get_inst_count(param rlt[])
  return rlt[INST_COUNT_IDX]
end

function get_inst_state(param rlt[])
  return rlt[INST_STATE_IDX]
end

function get_inst_type(param rlt[])
  return rlt[INST_TYPE_IDX]
end

function get_inst_cycles(param rlt[])
  return rlt[INST_CYCLE_IDX]
end

function get_inst_user_data(param rlt[])
  return rlt[INST_UDATA_IDX]
end

function set_inst_user_data(param rlt[], param user_data)
  rlt[INST_UDATA_IDX] = user_data
  return rlt
end

function mark_inst_finished(param rlt[])
  rlt[INST_STATE_IDX] = INST_STATE_FINISHED
  return rlt
end

function is_running(param rlt[])
  return get_inst_state(rlt) != INST_STATE_FINISHED
end

function is_gt_than(param rlt1[], param rlt2[])
  return get_inst_state(rlt2) != INST_STATE_DRY_RUN && get_inst_count(rlt1) > get_inst_count(rlt2)
end

function _advance_inst_rlt(param rlt[], param type, param cycle_inc)
  var count = get_inst_count(rlt) + 1
  var cycles = get_inst_cycles(rlt) + cycle_inc
  rlt[INST_COUNT_IDX] = count
  rlt[INST_TYPE_IDX] = type
  rlt[INST_CYCLE_IDX] = cycles
  return rlt
end

function valu_rlt(param rlt[], (param cycle_inc))
  if !assigned(cycle_inc)
    cycle_inc = 1
  end
  return _advance_inst_rlt(rlt, INST_TYPE_VALU, cycle_inc)
end

function salu_rlt(param rlt[], (param cycle_inc))
  if !assigned(cycle_inc)
    cycle_inc = 1
  end
  return _advance_inst_rlt(rlt, INST_TYPE_SALU, cycle_inc)
end

function mem_rlt(param rlt[], (param cycle_inc))
  if !assigned(cycle_inc)
    cycle_inc = 1
  end
  return _advance_inst_rlt(rlt, INST_TYPE_MEM, cycle_inc)
end

function lds_rlt(param rlt[], (param cycle_inc))
  if !assigned(cycle_inc)
    cycle_inc = 1
  end
  return _advance_inst_rlt(rlt, INST_TYPE_LDS, cycle_inc)
end

function trans_rlt(param rlt[], (param cycle_inc))
  if !assigned(cycle_inc)
    cycle_inc = 2
  end
  return _advance_inst_rlt(rlt, INST_TYPE_TRANS, cycle_inc)
end

function wmma_rlt(param rlt[], (param cycle_inc))
  if !assigned(cycle_inc)
    cycle_inc = 8
  end
  return _advance_inst_rlt(rlt, INST_TYPE_WMMA, cycle_inc)
end

function issue_all(function call, (param rlt[]))
  if !assigned(rlt)
    rlt = START_RESULT
  end
  while is_running(rlt)
    rlt = call(rlt)
  end
end

// KVINTLV (Opt-26): mirror of reference's issue_n_rlts (single-fn form).
// Advance the state machine by at most n emitted instructions, then return
// rlt so the caller can resume. Only decrements n when the call actually
// emitted an inst (is_running after the call), matching reference semantics
// so mark_inst_finished tail steps don't consume budget.
function issue_n(function call, param n, (param rlt[]))
  if !assigned(rlt)
    rlt = START_RESULT
  end
  while is_running(rlt) && n > 0
    rlt = call(rlt)
    if is_running(rlt)
      n = n - 1
    end
  end
  return rlt
end

// PVSU (Opt-54): mirror of reference's array-form issue_n. Drains up to N
// instructions across a TABLE of function continuations, advancing each
// function's persistent result tracker in priority order. Used to drip
// SALU work into pv WMMA co-execution windows.
function issue_n_table(function calls[], param results[], param n)
  assert(len(calls) * INST_RESULT_NUM == len(results))
  for var i in [0:len(calls) - 1]
    var call_result = results[i * INST_RESULT_NUM: (i + 1) * INST_RESULT_NUM - 1]
    while is_running(call_result) && n > 0
      call_result = calls[i](call_result)
      if is_running(call_result)
        n = n - 1
      end
    end
    for var j in [0:INST_RESULT_NUM - 1]
      results[i * INST_RESULT_NUM + j] = call_result[j]
    end
    if n == 0
      return results
    end
  end
  return results
end

// ============================================================================
// Section 5: SGPR Allocation
// ============================================================================

var s_tg_idx            = allocate_sgpr(1)   // batch index
var s_tg_idy            = allocate_sgpr(1)   // KV head index
var s_wave_id           = allocate_sgpr(1)
var s_gqa_ratio         = allocate_sgpr(1)   // GQA ratio
var s_KV_nheads         = allocate_sgpr(1)

// Tensor descriptor groups for TDM (Q loaded via global_load, no TDM needed)
// var s_Q_g0           = allocate_sgpr(4, 4)  // freed: Q uses global_load
// var s_Q_g1           = allocate_sgpr(8)     // freed: Q uses global_load
var s_K_g0              = allocate_sgpr(4, 4)
var s_K_g1              = allocate_sgpr(8)
var s_V_g0              = allocate_sgpr(4, 4)
var s_V_g1              = allocate_sgpr(8)

// Tensor base addresses (64-bit)
var s_Q_addr            = allocate_sgpr(2)
var s_K_addr            = allocate_sgpr(2)
var s_V_addr            = allocate_sgpr(2)
var s_R_addr            = allocate_sgpr(2)    // Output address
var s_R_base_addr       = allocate_sgpr(2)

// PA_PS persistent buffers and work metadata
var s_KVIndices_addr    = allocate_sgpr(2)    // flattened physical page ids
var s_CtxLen_addr       = allocate_sgpr(2)    // [batch] context lengths
var s_KVIndptr_addr     = allocate_sgpr(2)    // [batch+1] KV page prefix
var s_WorkIdx_addr      = allocate_sgpr(2)    // [available_tgs+1]
var s_WorkInfo_addr     = allocate_sgpr(2)    // array of ps::WORK_INFO (8 dwords)
var s_PartialO_addr     = allocate_sgpr(4, 4) // split O output buffer resource
var s_PartialLSE_addr   = allocate_sgpr(4, 4) // split LSE output buffer resource

var s_seq_len           = allocate_sgpr(1)    // actual KV sequence length for current batch
var s_KV_batch_start    = allocate_sgpr(1)    // first KV page for current batch in KVIndices
var s_work_start        = allocate_sgpr(1)
var s_work_end          = allocate_sgpr(1)
var s_batch_idx         = allocate_sgpr(1)
var s_partial_idx       = allocate_sgpr(1)
var s_qo_start          = allocate_sgpr(1)
var s_qo_end            = allocate_sgpr(1)
var s_KV_start          = allocate_sgpr(1)
var s_KV_end            = allocate_sgpr(1)
var s_KV_offset         = allocate_sgpr(1)
var s_Q_head_range      = allocate_sgpr(1)
var s_KV_head           = allocate_sgpr(1)
var s_KV_work_end_token = allocate_sgpr(1)

// Scales (per-tensor, scalar)
var s_key_scale         = allocate_sgpr(1)    // FP32 scalar
var s_query_scale       = allocate_sgpr(1)    // FP32 scalar
var s_value_scale       = allocate_sgpr(1)    // FP32 scalar
var s_log2e             = allocate_sgpr(1)    // log2(e)
var s_loge2             = allocate_sgpr(1)    // ln(2)

// Strides for K/V tensors
var s_K_blk_stride      = allocate_sgpr(1)    // stride from one physical block to next
var s_K_head_stride     = allocate_sgpr(1)    // stride from one KV head to next
/* alias */ var s_V_blk_stride  = s_K_blk_stride
/* alias */ var s_V_head_stride = s_K_head_stride

// Q strides
var s_Q_batch_stride    = allocate_sgpr(1)    // stride between batch elements
var s_Q_mtp_stride      = allocate_sgpr(1)    // stride between MTP layers = Q_head_num * Q_head_stride

// Output strides
var s_R_batch_stride    = allocate_sgpr(1)    // BF16 output batch stride
var s_R_mtp_stride      = allocate_sgpr(1)    // BF16 output MTP stride

// Loop control
var s_loop_cnt          = allocate_sgpr(1)    // total pages to process per wave
var s_loop_idx          = allocate_sgpr(1)    // current page index
var s_page_idx          = allocate_sgpr(1)    // current logical page index
var s_tdm_page          = allocate_sgpr(1)    // clamped page index for TDM/block_table lookup
var s_phys_blk_idx      = allocate_sgpr(1)    // physical block index from block_table (K)
// TDM-OOB-NOP flag is carried in s_tdm_page (REPURPOSED after the BT offset is
// taken in the lookup; = s_loader_base_page - clamped_page, i.e. 0 in-range, >0
// when the target page is OOB). The load's OOB decision MUST use this, NOT the
// live s_loader_base_page, because page_advance_step bumps s_loader_base_page
// between lookup and load (steady loop) and V reuses K's looked-up page via
// BTMERGE. No dedicated SGPR — the kernel is already at the 106-SGPR limit.
// W3: companion SGPRs so the two block_table_lookups inside K/V_TDM_load_half
// can issue their s_loads back-to-back and share a single s_wait_kmcnt 0.
// UNILOAD (Opt-40): s_tdm_page_aux unused (only one tile/wave/call). s_phys_blk_idx_aux
// repurposed as V phys block idx so K and V phys blocks can coexist within an iter.
var s_tdm_page_aux      = allocate_sgpr(1)    // TDM-OOB-NOP flag (was unused under UNILOAD)
var s_phys_blk_idx_aux  = allocate_sgpr(1)    // V physical block index
/* alias */ var s_V_phys_blk_idx = s_phys_blk_idx_aux
var s_total_pages_m1    = allocate_sgpr(1)    // total_pages - 1 (clamp upper bound)
var s_kv_cur_offset     = allocate_sgpr(1)    // s_page_idx * PAGE_SIZE, for per-iter mask

// MTP mask control (CAUSAL is compile-time  // see top-of-file `var CAUSAL`)
var s_mtp               = allocate_sgpr(1)    // MTP value (0..3)
var s_valid_rows        = allocate_sgpr(1)    // (mtp + 1) * gqa_ratio

// LDS wave offset
var s_LDS_wave_offset   = allocate_sgpr(1)    // ds_load tile base = bit_swap(wave)*16KB (== s_TDM_wave_offset); SMXBC seg-conflict fix
var s_TDM_wave_offset   = allocate_sgpr(1)    // for TDM store: base of loader's first owned tile
                                              // within a buffer-half = 2*loader_idx*LDS_BLOCK_SIZE

// Loader-side state (loader waves only). All waves still allocate the SGPRs
// for layout uniformity, but only K loaders (wave 0/1) and V loaders (wave
// 2/3) actually maintain s_loader_base_page in their own SGPR copy.
var s_loader_idx        = allocate_sgpr(1)    // = s_wave_id & 1, position within loader pair
var s_loader_base_page  = allocate_sgpr(1)    // base logical page for the next TDM half-issue  //
                                              // each *_TDM_load_half loads pages {base, base+2}

// Temporaries
var s_tmp0              = allocate_sgpr(1, 2)
var s_tmp1              = allocate_sgpr(1)
var s_tmp2              = allocate_sgpr(1)
var s_tmp3              = allocate_sgpr(1)
var s_permlanex16_sel   = allocate_sgpr(2, 2)

// ============================================================================
// Section 6: VGPR Allocation
// ============================================================================

// Score/Probability matrix S = Q·K^T, then P = softmax(S).
// Per-wave S shape = TileQ × PageSize = 32 × 256 FP32 (after GEMM_QK).
// Split across 4 msb segments to match K/V msb partitioning:
//   sp_msb = n >> 2    (0..3, same as K msb: tokens 0-63 / 64-127 / 128-191 / 192-255)
//   Within one msb (32 × 64 FP32): 2 M-tiles × 4 N-sub-tiles × 8 VGPR = 64 VGPR
//   f32 address: sp_idx = m*32 + (n & 3)*8 + v
// After FP8 quant each msb holds 4·n_sub·2 × M-tiles = 16 FP8 VGPR per msb.
//   fp8 address: v_SP[msb][m*8 + j]   j in 0..7  (8 FP8 per msb per m-tile)
// After shuffle (pa_shuffle_P) each (m, k_batch) pair is contiguous in
// one segment, addressed as v_SP[2*m + k_batch][P_SHUFFLE_OFFSET + v], v in 0..15.
// No double-buffering on SP (KV LDS buffers provide the pipeline overlap).
var SP_VGPR_PER_MSB     = G1_M_TILES * 4 * 8        // 2 · 4 · 8 = 64 f32 VGPR / msb
var SP_VGPR_SIZE        = NUM_MSB_SEGMENTS * SP_VGPR_PER_MSB  // 4 · 64 = 256
var P_SHUFFLE_OFFSET    = 16                        // shuffled P lives at VGPR 16..31
print "SP_VGPR_PER_MSB (f32): ", SP_VGPR_PER_MSB
print "SP vgpr size total: ", SP_VGPR_SIZE

// Output accumulator: D = P * V accumulated in FP32
var R_VGPR_SIZE         = *[TILE_Q, V_H_DIM, 4] / BYTES_PER_VGRP
var R_VGPR_SECT_SIZE    = R_VGPR_SIZE / VGPR_SEG_NUM
print "D vgpr size: ", R_VGPR_SIZE

// Q in FP8: TILE_Q * INST_K_QK * KV_BPP (no padding—K=64=HeadDim)
// v_wmma_f32_16x16x64_fp8 needs A: 16x64 FP8 = 8 VGPR per M-tile
var Q_VGPR_SIZE         = *[TILE_Q, INST_K_QK, KV_BPP] / BYTES_PER_VGRP
print "Q vgpr size: ", Q_VGPR_SIZE

// K/V tile VGPRs per msb (32 VGPRs each):
//   K per msb: 64 tokens × 64 dim × 1 byte = 4096 bytes = 32 VGPRs
//   V per msb: 256 tokens × 16 dim × 1 byte = 4096 bytes = 32 VGPRs
// K and V use separate VGPR files so their LDS loads can be scheduled
// independently without clobbering the other operand.
var KV_VGPR_SIZE        = *[PAGE_SIZE, QK_H_DIM, KV_BPP] / BYTES_PER_VGRP  // 256*64/128 = 128
var KV_VGPR_PER_MSB     = KV_VGPR_SIZE / VGPR_SEG_NUM                      // 32

print "KV_VGPR_SIZE: ", KV_VGPR_SIZE
print "KV_VGPR_PER_MSB: ", KV_VGPR_PER_MSB

// Allocate VGPRs across segments.
// NOTE: align=2 is REQUIRED on every WMMA operand VGPR group because seg 0
// starts at v1 (odd) and v_wmma_* requires VDST/VSRC bases to be 2-aligned.
var v_SP                = [allocate_vgpr(SP_VGPR_SIZE / VGPR_SEG_NUM, 0, 2)]
var v_R                 = [allocate_vgpr(R_VGPR_SIZE / VGPR_SEG_NUM, 0, 2)]
// Q: 8 VGPRs per M-tile (v_wmma B operand = 16x64 FP8 = 8 VGPR).
// Only G1_M_TILES=2 M-tiles → allocate in seg 0 and seg 1 only.
var Q_VGPR_PER_MTILE    = Q_VGPR_SIZE / G1_M_TILES       // 16/2 = 8
var v_Q                 = [allocate_vgpr(Q_VGPR_PER_MTILE, 0, 2)]
var v_K                 = [allocate_vgpr(KV_VGPR_PER_MSB, 0, 2)]
var v_V                 = [allocate_vgpr(KV_VGPR_PER_MSB, 0, 2)]

// Per-segment helper VGPRs
var v_K_LDS_rd          = [allocate_vgpr(1, 0)]       // K LDS read address
var v_V_LDS_rd          = [allocate_vgpr(2, 0, 2)]    // V LDS read base
// Per-(msb, buf_idx) stable seg0 LDS issue addresses.
// Splitting by buf_idx (×2) avoids the SCHED_MODE 2 VM_VSRC WAR that would
// otherwise occur when a later K_LDS_load / V_LDS_load on the same msb
// rewrites the address VGPR while the previous call's ds_loads are still
// outstanding. Indexing convention: v_X_LDS_issue_addr[msb*2 + buf_idx].
var v_K_LDS_issue_addr  = allocate_vgpr(NUM_MSB_SEGMENTS * 2, 0)
var v_V_LDS_issue_addr  = allocate_vgpr(NUM_MSB_SEGMENTS * 2, 0, 2)
var v_L                 = [allocate_vgpr(1, 0, 2)]     // Running sum for softmax denominator

// Per-lane attention-sink logit. Allocated unconditionally (SP3 `var`
// is scoped to its enclosing block, so gating with `if ENABLE_SINK` would
// hide the names from later references). v_SINK_addr is a 64-bit VGPR
// PAIR — global_load_b32 in the codebase always uses the (vaddr64, off)
// form, never the (vaddr32, saddr64) form. Costs 3 VGPRs in segment 0
// even when ENABLE_SINK == 0, which is fine — the slots are just unused.
var v_SINK              = allocate_vgpr(1, 0)
var v_SINK_addr         = allocate_vgpr(2, 0, 2)

// Cross-segment temporaries
var v_tmp0              = allocate_vgpr(1, 0, 2)
var v_tmp1              = allocate_vgpr(1)
var v_max               = [allocate_vgpr(1, 0, 2)]     // Running max for online softmax
var v_delta_max         = [allocate_vgpr(2, 0, 2)]     // exp(old_max - new_max); per-rb (seg 0=rb0, seg 1=rb1 appended below)

// Per-iteration PartialLSE store address / data VGPRs (one set per m-tile),
// allocated so iteration N+1's VALU writes target a different VGPR than the
// store of iteration N — sidesteps the VM_VSRC WAR without an s_wait_alu.
var v_LSE_addr          = allocate_vgpr(G1_M_TILES, 0)
var v_LSE_data          = allocate_vgpr(G1_M_TILES, 0)

// Allocate remaining segments
// Q: only seg 1 needed (M-tile 1). Segs 2,3 have no Q.
v_Q = [v_Q, allocate_vgpr(Q_VGPR_PER_MTILE, 1, 2)]

// Per-M-tile softmax scale VGPR (packed pair: [0]=value, [1]=duplicate for v_pk_fma_f32)
// v_scl_log2e[m] = query_scale * key_scale * log2(e), zeroed on invalid MTP rows.
// The scalar absorbs dequant and log2(e) so softmax can use exp2 directly.
var v_scl_log2e         = [allocate_vgpr(2, 0, 2)]
v_scl_log2e = [v_scl_log2e, allocate_vgpr(2, 1, 2)]

// Per-iteration PV accumulator (same shape as v_R, folded into v_R via v_ScaleS after PV).
// Enables dynamic per-row P FP8 quant: v_R += v_ScaleS[m] * v_R_iter (see pa_fold_R_iter).
var v_R_iter            = [allocate_vgpr(R_VGPR_SIZE / VGPR_SEG_NUM, 0, 2)]

// Per-M-tile dynamic-quant inverse scale for P: v_ScaleS[m] = row_max(P_m) / kE4M3Max.
// Packed pair ([0]=value, [1]=duplicate for v_pk_fma_f32).
var v_ScaleS            = [allocate_vgpr(2, 0, 2)]
v_ScaleS = [v_ScaleS, allocate_vgpr(2, 1, 2)]

// Dynamic-quant forward multiplier for P: v_p_quant_mul[msb*2+rb] = kE4M3Max / row_max(P_rb).
// Duplicated per msb (4 msb × 2 rb = 8 packed pairs) so each msb's exp_chain
// Phase 3-4 pk_mul reads src1 from seg msb (matching dst/src0 = v_SP[msb] in seg msb),
// eliminating set_vgpr_msb toggles in (pk_add, pk_mul) windows.
// Master copies (msb=0 rb=0, msb=0 rb=1) computed by Stage 1 prep in seg 0,
// then broadcast to msb=1/2/3 entries at end of prep.
var v_p_quant_mul       = [allocate_vgpr(2, 0, 2), allocate_vgpr(2, 0, 2)]

// Shared saved curr-iteration row max (softmax-local scratch).
// 2 vgpr packed pair: v_curr_max[0]=rb0 (m=0), v_curr_max[1]=rb1 (m=1).
// Both row-bands are computed jointly by the per-msb reduction (msb=3 tail);
// each row-band's exp chain reads its own v_curr_max[rb] in Step 2.
var v_curr_max          = allocate_vgpr(2, 0, 2)

for var i in [1:VGPR_SEG_NUM - 1]
  v_SP     = [v_SP,     allocate_vgpr(SP_VGPR_SIZE / VGPR_SEG_NUM, i, 2)]
  v_R      = [v_R,      allocate_vgpr(R_VGPR_SIZE / VGPR_SEG_NUM, i, 2)]
  v_R_iter = [v_R_iter, allocate_vgpr(R_VGPR_SIZE / VGPR_SEG_NUM, i, 2)]
  v_K      = [v_K,      allocate_vgpr(KV_VGPR_PER_MSB, i, 2)]
  v_V      = [v_V,      allocate_vgpr(KV_VGPR_PER_MSB, i, 2)]
  v_K_LDS_rd = [v_K_LDS_rd, allocate_vgpr(1, i)]
  v_V_LDS_rd = [v_V_LDS_rd, allocate_vgpr(2, i, 2)]
  v_L      = [v_L,      allocate_vgpr(1, i, 2)]
  v_max    = [v_max,    allocate_vgpr(1, i, 2)]
  // Per-msb copies of v_p_quant_mul (rb=0 then rb=1). After loop:
  //   v_p_quant_mul[msb*2 + rb] is the packed pair in seg msb for row-band rb.
  v_p_quant_mul = [v_p_quant_mul, allocate_vgpr(2, i, 2), allocate_vgpr(2, i, 2)]
end

// Scale-related VGPRs
var v_NEG_INF           = allocate_vgpr(1, 1)          // -Infinity for masking

// Per-M-tile per-row border value for MTP/CAUSAL masking (one f32 per lane).
//   lane l owns row (l & 0xf) + m*16  // v_mask_border[m] holds its border.
var v_mask_border       = [allocate_vgpr(1, 0), allocate_vgpr(1, 1)]

// Per-wave-per-M-tile correction factors used during cross-wave reduce
//   v_corr[w*2 + m]  (4 waves × 2 m-tiles = 8 VGPRs, packed pair for v_pk_mul_f32)
// Placed in seg 0 / seg 1 for accessibility from v_L / v_R segments.
var v_corr              = [allocate_vgpr(2, 0, 2), allocate_vgpr(2, 0, 2), \
                           allocate_vgpr(2, 1, 2), allocate_vgpr(2, 1, 2), \
                           allocate_vgpr(2, 0, 2), allocate_vgpr(2, 0, 2), \
                           allocate_vgpr(2, 1, 2), allocate_vgpr(2, 1, 2)]

// Block table VGPRs
var v_blk_table_rd      = allocate_vgpr(1, 1)          // for reading block table entries

// Q global load address
var v_Q_addr            = allocate_vgpr(2, 0, 2)       // per-lane 64-bit Q address

/* reuse */ var v_tmp2     = allocate_vgpr(1, 0, 2)
/* reuse */ var v_tmp3     = allocate_vgpr(1, 0, 2)

// Softmax row-sum packed accumulators. v_tmp0/v_tmp1 form the msb0 packed
// accumulator pair  // these three pairs hold msb1..3 so Step 6 can reduce four
// independent chains and merge them at the end.
var v_sum_msb1          = allocate_vgpr(2, 0, 2)
var v_sum_msb2          = allocate_vgpr(2, 0, 2)
var v_sum_msb3          = allocate_vgpr(2, 0, 2)

// Per-rb (m_tile) packed pair for delta_max Stage 1 prep output.
// rb=0 in seg 0 (alloc'd at the v_delta_max line above); rb=1 in seg 1 here.
// (v_p_quant_mul moved to per-msb dup — alloc'd in the per-msb loop above.)
v_delta_max   = [v_delta_max,   allocate_vgpr(2, 1, 2)]

// ----------------------------------------------------------------------------
// Softmax cross-msb max-reduction partial stash.
// 16 vgpr/msb (8 vp_rb0 + 8 vp_rb1), allocated at the SAME relative offset in
// each segment so one 8-bit-encoded index covers all 4 msb (set_vgpr_msb
// tracker supplies the high bits). Pad seg 1/2/3 to the max of current
// _vgpr_next so all 4 segs start allocating from the same point; the pad
// shows up as "VGPR hole at:" prints, intentionally.
// ----------------------------------------------------------------------------
// _vgpr_next[msb] holds ABSOLUTE vgpr index (= msb*VGPR_SEG_SIZE + offset),
// so pad target is computed in relative-offset domain then mapped back per seg.
var pa_softmax_pad_target = 0
for var msb in [0:VGPR_SEG_NUM - 1]
  var idx = len(_vgpr_next) - VGPR_SEG_NUM + msb
  var rel = _vgpr_next[idx] - msb * VGPR_SEG_SIZE
  if rel > pa_softmax_pad_target
    pa_softmax_pad_target = rel
  end
end
for var msb in [0:VGPR_SEG_NUM - 1]
  var idx = len(_vgpr_next) - VGPR_SEG_NUM + msb
  var abs_target = pa_softmax_pad_target + msb * VGPR_SEG_SIZE
  if _vgpr_next[idx] < abs_target
    print "VGPR hole at :", _vgpr_next[idx], " -> ", abs_target
    _vgpr_next[idx] = abs_target
  end
end
var vp_rb0 = [allocate_vgpr(8, 0), allocate_vgpr(8, 1), allocate_vgpr(8, 2), allocate_vgpr(8, 3)]
var vp_rb1 = [allocate_vgpr(8, 0), allocate_vgpr(8, 1), allocate_vgpr(8, 2), allocate_vgpr(8, 3)]
// CURMAXFIX: dedicated seg0 VGPR pairs for v_curr_max_scaled.
// The old WILLASMX aliasing onto vp_rb0[0][6]/vp_rb1[0][6] was UNSAFE: vp_rb*[0]
// is the max-reduction partial stash and Phase 1 writes vp_rb*[0][0..7] (incl.
// [6:7]) on every page, so the scaled running-max addend (scl·NEW) got clobbered
// mid-flight between its Stage-1-prep producer and the exp_chain Phase-2 v_pk_fma
// consumers -> softmax denominator L inflated (~256x on the colliding lanes,
// outputs = V/256) and fully-masked rows no longer zeroed. Each rb needs a 2-vgpr
// packed pair (read as -v_curr_max_scaled[rb] in v_pk_fma_f32), align 2. Seg0
// watermark after vp_rb1 = v252; these two pairs occupy v252..255 (seg0 full=256).
var v_curr_max_scaled = [allocate_vgpr(2, 0, 2), allocate_vgpr(2, 0, 2)]

// ============================================================================
// Section 7: Utility Functions
// ============================================================================

function wgp_barrier
  s_barrier_signal -1
  s_barrier_wait   -1
end

function nop(param n)
  for var _ in [1:n]
    s_nop 0
  end
end

function set_sched_mode(param mode)
  s_setreg_imm32_b32 { id : HW_REG_WAVE_SCHED_MODE, offset : 0, size : 1 }, mode
end

// ============================================================================
// Instruction prefetch (ported from MXFP8_FMHA_DECODE reference)
//
// `prefetch_instructions(index, size, padding, all_waves)` issues
// `s_prefetch_inst`s to warm the instruction cache for the next `size` bytes of
// code starting from the current PC.
//
// XWR-IPF (per-SIMD I$): the L0 I$ is effectively per-SIMD here — the TG's 4
// waves run on SIMD 0/1/2/3, so a wave-0-only prefetch only warms one SIMD's I$.
// For the hot loop that is fine (every SIMD re-fetches and warms naturally after
// iter 0). But the POST-LOOP tail (cross_wave_reduce + finalize/store) runs once,
// after the ~80 KB main loop has evicted those lines from the stragglers' I$, so
// waves 1/2/3 enter cross_wave_reduce on a COLD I$ and stall on instruction fetch
// while wave 0 (warm) parks at the Phase-2 wgp_barrier waiting for them.
//
// all_waves=1 issues the explicit s_prefetch_inst on EVERY wave so each SIMD
// warms its own I$. The HW lookahead enable (set_inst_prefetch) stays WAVE-0
// ONLY regardless — re-arming the HW prefetcher on all waves is unnecessary and
// is what previously ran off the end of the mapped code (see ICACHE-GUARD /
// SQC(inst) fault). all_waves defaults to 0 (wave-0-only) so the hot-path sites
// are byte-identical to before.
//
// Call sites:
//   prefetch_instructions(0, ...)            — early in main, covers hot path
//   prefetch_instructions(1, ..., 0, 1)      — core_loop_exit, post-proc (ALL waves)
// ============================================================================
var INST_PREF_START = 0
var INST_PREF_STOP  = 0
label skip_inst_prefetch[4]
label skip_inst_pref_hw[4]

function set_inst_prefetch(enable)
  s_setreg_imm32_b32 { id : HW_REG_WAVE_MODE, offset : 24, size : 0 }, enable  // actual size = size + 1
end

function prefetch_instructions(param index, param size, (param padding), (param all_waves))
  if !assigned(padding)
    padding = 0
  end
  if !assigned(all_waves)
    all_waves = 0
  end

  // all_waves==0: gate the whole routine on wave 0 (original behavior).
  // all_waves==1: every wave runs the SW prefetch (warms its own SIMD's I$).
  if !all_waves
    s_cmp_eq_u32   s_wave_id, 0
    s_cbranch_scc0 skip_inst_prefetch[index]
  end

  var inst_pref_start = get_dword_offset()
  print "Instruction prefetching at: ", inst_pref_start * 4, " BYTES offset"

  // HW lookahead enable: WAVE-0 ONLY, even when all_waves==1 (see header note).
  if all_waves
    s_cmp_eq_u32   s_wave_id, 0
    s_cbranch_scc0 skip_inst_pref_hw[index]
  end
  s_getreg_b32       s_tmp0, { id : HW_REG_WAVE_MODE }
  set_inst_prefetch(1)
  s_getreg_b32       s_tmp0, { id : HW_REG_WAVE_MODE }
skip_inst_pref_hw[index]:

  s_get_pc_i64       s_tmp0
  s_mov_b32          s_tmp2, 31

  var remaining = ((size & 0xfff) + padding) >> 7

  var times = (size + 4095) / 4096
  for var i in [0:times - 1]
    if i == times - 1 && remaining != 0
      s_mov_b32 s_tmp2, remaining
    end
    s_prefetch_inst  s_tmp0, i * 4096, s_tmp2, 0
  end

  if INST_PREF_START == 0
    INST_PREF_START = inst_pref_start
  end
  INST_PREF_STOP = inst_pref_start + size/4
skip_inst_prefetch[index]:
end

function get_grid_coords
  s_mov_b32   s_tg_idx, ttmp9
  s_and_b32   s_tg_idy, ttmp7, 0xffff
  s_bfe_u32   s_wave_id, ttmp8, 0x50019
end

// TDM helper functions (from reference)
function setup_TDM_init(reg grp0, reg grp1)
  s_mov_b32 grp0, 0x1
end

function setup_TDM_lds_addr(reg grp0, reg grp1, lds_addr)
  s_mov_b32 grp0[1], lds_addr
end

function setup_TDM_global_addr(reg grp0, reg grp1, reg global_addr)
  s_mov_b64 grp0[2], global_addr
  s_or_b32  grp0[3], grp0[3], 0x80000000
end

function init_buffer_default(reg s_buf)
  s_mov_b32 s_buf[2], Vsrc95_64
  s_mov_b32 s_buf[3], Vsrc127_96
  s_and_b32 s_buf[1], s_buf[1], 0x1ffffff
  s_or_b32  s_buf[1], s_buf[1], Vsrc63_48
end

function setup_TDM_tensor_dim(reg grp0, reg grp1, param dim0, dim1)
  assert(dim0 < 65535)
  s_mov_b32 grp1[1], dim0 << 16
  s_lshl_b32 grp1[2], dim1, 16
end

function setup_TDM_tensor_dim0(reg grp0, reg grp1, param dim0)
  assert(dim0 < 65535)
  s_mov_b32 grp1[1], dim0 << 16
end

function setup_TDM_tile_dim(reg grp0, reg grp1, param dim0, dim1, param padding_amount)
  var bytes = dim0 / 4
  var interval = 0
  while bytes > 2
    bytes = bytes >> 1
    ++interval
  end
  assert(interval >= 0 && interval <= 7)
  assert(padding_amount % 4 == 0)
  if padding_amount == 0
    // No LDS padding: leave pad_enable/pad_interval/pad_amount clear.
    // Encoding padding_amount=0 as (0/4 - 1) sets all high pad bits
    // (e.g. 0xffd00000) and produces invalid TDM LDS row placement.
    s_mov_b32 grp1[0], 0
  else
    padding_amount = padding_amount / 4 - 1
    s_mov_b32 grp1[0], (padding_amount << 25) | (interval << 22) | (1 << 20)
  end
  s_mov_b32 grp1[3], dim0 << 16
  s_mov_b32 grp1[4], dim1
end

function setup_TDM_strides(reg grp0, reg grp1, stride0, reg stride1)
  s_mov_b32 grp1[5], stride0
  // stride1 is a scalar 32-bit stride. Do not use s_lshl_b64 here: it reads
  // stride1[1] as the high half, which can contain stale SGPR state and corrupt
  // the TDM row-stride high dword (observed on V loads).
  s_lshl_b32 grp1[6], stride1[0], 16
  s_mov_b32  grp1[7], 0
end

// ============================================================================
// Section 8: Block Table Lookup (PAGED ATTENTION SPECIFIC)
// ============================================================================

// UNILOAD (Opt-40) + BTMERGE (Opt-42): K and V at the same iter target the
// SAME logical page → SAME physical block. One BT lookup serves both. K_TDM
// lookup writes s_phys_blk_idx; K_TDM_load_half copies s_V_phys_blk_idx <-
// s_phys_blk_idx after the kmcnt drain. V_TDM_lookup_issue is gone.
function K_TDM_lookup_issue
  s_min_i32    s_tdm_page, s_loader_base_page, s_total_pages_m1
  s_lshl_b32   s_tmp2, s_tdm_page, 2
  // TDM-OOB-NOP flag in s_tdm_page_aux (UNILOAD-freed, no new SGPR): loader -
  // clamped = 0 in-range, >0 when this load's page is OOB. Captured here at
  // lookup (s_loader_base_page = true target page); the loads must use this,
  // not the live s_loader_base_page (advanced by page_advance_step before load).
  s_sub_i32    s_tdm_page_aux, s_loader_base_page, s_tdm_page
  s_add_u32    s_tmp0, s_KVIndices_addr[0], s_tmp2
  s_addc_u32   s_tmp1, s_KVIndices_addr[1], 0
  s_and_b32    s_tmp1, s_tmp1, 0x1ffffff              // 25-bit aperture mask
  s_load_dword s_phys_blk_idx, s_tmp0, 0x0
end

function compute_K_phys_addr
  // ADDR64: phys_blk_idx * blk_stride is the byte offset into the KV cache and
  // can exceed 2^32 on a multi-GB cache (e.g. 32K blocks * 128KB/block = 4GB).
  // s_mul_i32 alone truncates to 32 bits, so capture the high half with
  // s_mul_hi_u32 and carry it into the base's high dword. The head term
  // (kv_head * head_stride) is bounded by num_kv_heads * page bytes (<<4GB), so
  // it stays 32-bit and is folded into the low word (carry propagated).
  s_mul_i32    s_tmp0, s_phys_blk_idx, s_K_blk_stride   // block offset low
  s_mul_hi_u32 s_tmp3, s_phys_blk_idx, s_K_blk_stride   // block offset high (>4GB safe)
  s_mul_i32    s_tmp1, s_KV_head, s_K_head_stride        // head offset (32-bit)
  s_add_u32    s_tmp0, s_tmp0, s_tmp1                     // low += head offset
  s_addc_u32   s_tmp3, s_tmp3, 0                          // propagate carry into high
  s_add_u32    s_tmp0, s_K_addr[0], s_tmp0               // + base low
  s_addc_u32   s_tmp1, s_K_addr[1], s_tmp3               // + base high + offset high (+carry)
  s_and_b32    s_tmp1, s_tmp1, 0x1ffffff              // 25-bit aperture mask
  setup_TDM_global_addr(s_K_g0, s_K_g1, s_tmp0)
end

function compute_V_phys_addr
  // ADDR64: see compute_K_phys_addr. V_phys_blk_idx * V_blk_stride is the byte
  // offset into the (multi-GB) V cache and must be computed in 64 bits.
  s_mul_i32    s_tmp0, s_V_phys_blk_idx, s_V_blk_stride  // block offset low
  s_mul_hi_u32 s_tmp3, s_V_phys_blk_idx, s_V_blk_stride  // block offset high (>4GB safe)
  s_mul_i32    s_tmp1, s_KV_head, s_V_head_stride         // head offset (32-bit)
  s_add_u32    s_tmp0, s_tmp0, s_tmp1                     // low += head offset
  s_addc_u32   s_tmp3, s_tmp3, 0                          // propagate carry into high
  s_add_u32    s_tmp0, s_V_addr[0], s_tmp0               // + base low
  s_addc_u32   s_tmp1, s_V_addr[1], s_tmp3               // + base high + offset high (+carry)
  s_and_b32    s_tmp1, s_tmp1, 0x1ffffff              // 25-bit aperture mask
  setup_TDM_global_addr(s_V_g0, s_V_g1, s_tmp0)
end

// PVSU (Opt-54): SALU step continuations for slot-based dripping into pv
// WMMA co-execution windows. Each step emits ONE salu instruction per call
// and returns its result tracker so issue_n_table can advance through the
// table. The compile-time `is_gt_than(rlt, result)` guards work the same
// way as the WMMA state machine — they're emission filters, not runtime
// branches. Total per-iter SALU budget across all 3 steps = 5 (lookup) +
// 9 (V_TDM body) + 1 (page advance) = 15. Distributing 15 across 16 pv
// WMMAs leaves 1 WMMA window unused.

function K_TDM_lookup_step(param result[])
  var rlt = salu_rlt(START_RESULT)
  if is_gt_than(rlt, result)
    s_min_i32 s_tdm_page, s_loader_base_page, s_total_pages_m1
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_lshl_b32 s_tmp2, s_tdm_page, 2
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    // TDM-OOB-NOP flag in s_tdm_page_aux (UNILOAD-freed): loader-clamped
    // (>0 iff OOB). No new SGPR (kernel at 106 SGPR limit).
    s_sub_i32 s_tdm_page_aux, s_loader_base_page, s_tdm_page
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_add_u32 s_tmp0, s_KVIndices_addr[0], s_tmp2
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_addc_u32 s_tmp1, s_KVIndices_addr[1], 0
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_load_dword s_phys_blk_idx, s_tmp0, 0x0
    return rlt
  end
  return mark_inst_finished(rlt)
end

// V_TDM_load_half body except the leading s_wait_kmcnt 0 (which must
// remain ordered as the FIRST inst before this step machine runs — the
// caller is responsible) and the trailing tensor_load_to_lds (emitted
// here as the last step so the TDM dispatch happens after the setup).
// 9 SALU total. `buf_idx` is closed over via the caller's compile-time
// invocation chain (passed as param via wrapper below).
function V_TDM_setup_step(param result[], param buf_idx)
  var rlt = salu_rlt(START_RESULT)
  if is_gt_than(rlt, result)
    s_mul_i32 s_tmp0, s_V_phys_blk_idx, s_V_blk_stride
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_mul_i32 s_tmp1, s_KV_head, s_V_head_stride
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_add_i32 s_tmp0, s_tmp0, s_tmp1
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_add_u32 s_tmp0, s_V_addr[0], s_tmp0
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_addc_u32 s_tmp1, s_V_addr[1], 0
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_mov_b64 s_V_g0[2], s_tmp0
    s_or_b32  s_V_g0[3], s_V_g0[3], 0x80000000
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_add_i32 s_tmp0, s_TDM_wave_offset, V_LDS_BASE + V_LDS_BUF_SIZE * buf_idx
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_mov_b32 s_V_g0[1], s_tmp0
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_lshl_b32 s_tmp0, V_TILE_DIM1, 16
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    s_mov_b32 s_V_g1[2], s_tmp0
    return rlt
  end
  rlt = salu_rlt(rlt)
  if is_gt_than(rlt, result)
    tensor_load_to_lds s_V_g0, s_V_g1, null, null
    return rlt
  end
  return mark_inst_finished(rlt)
end

// Wrapper: closes V_TDM_setup_step over buf_idx for use in a salu_calls
// table (which expects `(param result[]) -> result[]` signature only).
// Two wrappers for the two possible buf_idx values, picked at compile-time
// in gemm_pv_phase via if-statement.
function V_TDM_setup_step_b0(param result[])
  return V_TDM_setup_step(result, 0)
end
function V_TDM_setup_step_b1(param result[])
  return V_TDM_setup_step(result, 1)
end

function page_advance_step(param result[])
  var rlt = salu_rlt(START_RESULT)
  if is_gt_than(rlt, result)
    s_add_i32 s_loader_base_page, s_loader_base_page, WAVES
    return rlt
  end
  return mark_inst_finished(rlt)
end

// ============================================================================
// Section 9: Q Direct Global Load
// ============================================================================
// Q is loaded directly from global memory into VGPRs (no LDS staging).
// Q layout in HBM: Q[batch, num_heads, head_dim] in raw FP8
// For GQA: 8 query heads per KV head 
// WMMA lane mapping: lane l → row = l & 0xf
//   Rows 0..7 = valid query heads, rows 8..15 = padding (set to zero)
//   Lanes 0-15 and 16-31 map to same rows (wave32 16x16 redundancy)

function Q_compute_addr
  // Q global layout: [batch, num_heads, head_dim] FP8, mtp-major where
  //   num_heads = mtp_layers * kv_heads * gqa_ratio
  //   i.e. flat layout = [batch, mtp_lvl, kv_head, gqa, head_dim]
  //
  // HOST CONTRACT (required for correctness):
  //   - s_Q_mtp_stride   = kv_heads * gqa_ratio * head_dim bytes (FP8 Q)
  //   - s_Q_batch_stride = (mtp + 1) * s_Q_mtp_stride
  //   - Q head stride is HeadDim bytes  // R remains HeadDim * sizeof(bf16).
  //
  // Output (D) is assumed to share the same shape & layout (see R_store_to_global).
  //
  // Row assignment in VGPR M-tiles (WMMA B operand 16x64):
  //   M-tile m, local row r (0..15)  →  mtp_lvl = 2*m + (r >> 3), gqa = r & 7
  //   lane l within M-tile 0         →  row = l & 0xf
  //   k_half = l >> 4 selects WMMA B operand's K[3] (interleaved-half), so
  //   each lane consumes one 8-byte half from each 16-byte raw chunk.
  //
  // Base address for this batch & kv_head (mtp_lvl / gqa / row handled per-lane):
  //   base = Q_addr + batch*batch_stride + kv_head*gqa_ratio*head_stride

  s_mul_i32    s_tmp0, s_tg_idx, s_Q_batch_stride
  s_mul_i32    s_tmp1, s_tg_idy, s_gqa_ratio
  s_mul_i32    s_tmp1, s_tmp1,   QK_H_DIM * Q_BPP
  s_add_u32    s_tmp0, s_tmp0,   s_tmp1
  s_add_u32    s_tmp0, s_Q_addr[0], s_tmp0
  s_addc_u32   s_tmp1, s_Q_addr[1], 0
  s_and_b32    s_tmp1, s_tmp1, 0x1ffffff              // 25-bit aperture mask

  // Per-lane offset for M-tile 0:
  //   row    = l & 0xf
  //   mtp_lvl = row >> 3                                  (0 or 1)
  //   gqa    = row & 7
  //   k_half = l >> 4                                     (0 or 1) -> K[3]
  //   offset = mtp_lvl * Q_mtp_stride + gqa * Q_head_stride
  // k_half is handled inside Q_global_load: each raw 16-byte chunk contains
  // both K[3] halves, and lane[4] selects the low/high 8-byte half.
  set_vgpr_msb(QUIET)
  v_and_b32     v_tmp0, v0, 0xf                            // row (0..15)
  v_and_b32     v_tmp1, v_tmp0, 7                          // gqa = row & 7
  v_mul_lo_u32  v_tmp1, v_tmp1, QK_H_DIM * Q_BPP           // gqa * head_stride
  v_lshrrev_b32 v_tmp0, 3, v_tmp0                          // mtp_lvl = row >> 3
  v_mul_lo_u32  v_tmp0, v_tmp0, s_Q_mtp_stride             // mtp_lvl * mtp_stride
  v_add_nc_u32  v_tmp0, v_tmp0, v_tmp1                     // + gqa * head_stride

  v_add_co_u32  v_Q_addr[0], vcc, s_tmp0, v_tmp0
  v_add_co_ci_u32    v_Q_addr[1], vcc, s_tmp1, 0, vcc
end

// QOVL-DEFER: Q_global_load is split into _issue (global_load_b128 + addr
// advances, async, no wait) and _finalize (s_wait_loadcnt 0 + cndmask into
// v_Q). The caller runs Q_apply_per_tensor_scale + load_initial_data between
// the two, so Q's HBM fetch (~2730 cyc cold in att_dump_b64_08_1 PC 1836)
// overlaps load_initial_data's tensorcnt wait (~4588 cyc cold) instead of
// serializing in front of it.
function Q_global_load_issue
  // Load raw Q FP8 from global memory into WMMA-B operand VGPRs.
  // WMMA B operand (16x64 FP8) per lane = 8 VGPRs = 32 FP8.
  // Host Q remains row-major. For each 16-byte group we load both lane[4]
  // halves, then select either the low 8 bytes or high 8 bytes into v_Q.
  //
  // Per-lane K-element coverage (matches WMMA B operand bit layout):
  //   K[3]   = lane[4]                            (low/high half of each 16B group)
  //   K[5:4] = raw b128 load index n (0..3)       (4 loads, stride 16 bytes)
  //   K[2]   = selected dword within the 8B half  (v_Q[2*n + 0/1])
  //   K[1:0] = byte within dword
  //
  // Row assignment (matches Q_compute_addr):
  //   M-tile 0 row r ∈ [0..15] → mtp_lvl = r>>3 ∈ {0,1}
  //   M-tile 1 row r ∈ [0..15] → mtp_lvl = 2 + r>>3 ∈ {2,3}
  //
  // valid_rows_per_mtile depends on s_mtp:
  //   s_mtp = 0 → M0 rows 0..7 valid (8),   M1 all padding
  //   s_mtp = 1 → M0 rows 0..15 valid (16), M1 all padding
  //   s_mtp = 2 → M0 rows 0..15 valid (16), M1 rows 0..7 valid (8)
  //   s_mtp = 3 → M0 rows 0..15 valid (16), M1 rows 0..15 valid (16)

  // Zero both M-tiles (padding rows + aliased spillover).
  set_vgpr_msb(QUIET, v_Q[0])
  for var i in [0:2:Q_VGPR_PER_MTILE - 1]
    v_mov_b32 v_8bit(v_Q[0][i]), 0
    v_mov_b32 v_8bit(v_Q[0][i + 1]), 0
  end
  set_vgpr_msb(QUIET, v_Q[1])
  for var i in [0:2:Q_VGPR_PER_MTILE - 1]
    v_mov_b32 v_8bit(v_Q[1][i]), 0
    v_mov_b32 v_8bit(v_Q[1][i + 1]), 0
  end

  // QMERGE: issue M-tile 0 and M-tile 1 global_load_b128s back-to-back, with
  // a SINGLE s_wait_loadcnt 0 covering both. The two cold HBM Q-load waits
  // previously cost ~1144 + 989 = 2133 cyc (ATT 256_6). With both batches in
  // flight together, the combined wait collapses to ~max(latencies) and saves
  // roughly the second wait's worth on the cold path.

  // ----- M-tile 0 load (always) -----
  // exec mask: 0x00FF00FF (rows 0..7 only) if s_mtp==0, else 0xFFFFFFFF
  s_cmp_ge_u32 s_mtp, 1
  s_cselect_b32 s_tmp0, 0xFFFFFFFF, 0x00FF00FF
  s_mov_b32 exec_lo, s_tmp0

  // v_Q_addr is a full 64-bit pointer (base+per-lane offset). Use vaddr-only
  // (saddr=off) mode so both halves of v_Q_addr are used. Passing a zero
  // saddr pair would make HW treat v_Q_addr[0] as a 32-bit offset only, which
  // truncated the high bits of the global pointer and triggered IOMMU OOB.
  set_vgpr_msb(QUIET, v_K[0], v_Q_addr)
  for var i in [0:Q_VGPR_PER_MTILE / 2 - 1]
    global_load_b128 v_8bit(v_K[0][i * 4]), v_Q_addr, off offset: i * 16
  end

  // ----- M-tile 1 load (only when s_mtp >= 2) -----
  // The M0 loads above sampled v_Q_addr at issue, so we can safely advance
  // v_Q_addr now to set up M1 in parallel with M0's in-flight HBM fetches.
  s_cmp_ge_u32 s_mtp, 2
  s_cbranch_scc0 q_load_skip_mtile1_issue

  // Advance v_Q_addr by 2 * Q_mtp_stride (all lanes for vcc carry chain)
  s_mov_b32 exec_lo, 0xFFFFFFFF
  s_lshl_b32 s_tmp1, s_Q_mtp_stride, 1
  set_vgpr_msb(QUIET, v_Q_addr, v_Q_addr)
  v_add_co_u32 v_Q_addr[0], vcc, s_tmp1, v_Q_addr[0]
  v_add_co_ci_u32    v_Q_addr[1], vcc, 0, v_Q_addr[1], vcc

  // exec mask: 0xFFFFFFFF if s_mtp==3, else 0x00FF00FF (s_mtp==2)
  s_cmp_ge_u32 s_mtp, 3
  s_cselect_b32 s_tmp0, 0xFFFFFFFF, 0x00FF00FF
  s_mov_b32 exec_lo, s_tmp0

  // v_Q_addr was just updated by VALU  // protect against VMEM consuming an
  // unretired vaddr under sched_mode 2.
  s_wait_alu { va_vdst: 0 }
  set_vgpr_msb(QUIET, v_K[1], v_Q_addr)
  for var i in [0:Q_VGPR_PER_MTILE / 2 - 1]
    global_load_b128 v_8bit(v_K[1][i * 4]), v_Q_addr, off offset: i * 16
  end
q_load_skip_mtile1_issue:
  // Restore full exec mask so Q_apply_per_tensor_scale + load_initial_data
  // (which run between _issue and _finalize) see all 32 lanes active.
  s_mov_b32 exec_lo, 0xFFFFFFFF
end

function Q_global_load_finalize
  // Drain the in-flight Q HBM loads and cndmask v_K staging into v_Q.
  // v_Q padding rows were already pre-zeroed in Q_global_load_issue, so
  // inactive lanes keep their 0 (cndmask runs under M0/M1 exec masks).

  // ----- Single combined wait for both batches -----
  s_wait_loadcnt 0

  // QOVL-DEFER-FIX: explicit msb reset. Q_global_load_issue starts with
  // set_vgpr_msb(QUIET) to clear all msbs; _finalize needs the same because
  // intervening code (setup_mask_border, V_LDS_rd_addr_gen, K_LDS_load) can
  // leave src1_msb=1 or dst_msb=1 in the assembler tracker. The lane[4]
  // selector below does `v_lshrrev_b32 v_tmp0, 4, v0` — if src1_msb is stale
  // at 1, v0 (lane id) is read from msb 1 (= uninitialized 0), VCC=0xFFFFFFFF,
  // and cndmask selects the same src1 for ALL lanes → wrong v_Q.
  set_vgpr_msb(QUIET)

  // ----- M-tile 0 cndmask (always) -----
  // Re-apply M0 exec mask in case the M1 path changed it (cndmask must run
  // only on valid M0 rows  // inactive lanes keep their pre-zeroed v_Q[0]).
  s_cmp_ge_u32 s_mtp, 1
  s_cselect_b32 s_tmp0, 0xFFFFFFFF, 0x00FF00FF
  s_mov_b32 exec_lo, s_tmp0

  // lane[4]==0 takes dwords 0..1  // lane[4]==1 takes dwords 2..3.
  set_vgpr_msb(QUIET, v_tmp0, v0)
  v_lshrrev_b32 v_tmp0, 4, v0
  set_vgpr_msb(QUIET, v0, v_tmp0)
  v_cmp_lt_u32 vcc, v_tmp0, 1
  set_vgpr_msb(QUIET, v_Q[0], v_K[0], v_K[0])
  for var i in [0:Q_VGPR_PER_MTILE / 2 - 1]
    v_cndmask_b32 v_8bit(v_Q[0][i * 2]),     v_8bit(v_K[0][i * 4 + 2]), v_8bit(v_K[0][i * 4]),     vcc
    v_cndmask_b32 v_8bit(v_Q[0][i * 2 + 1]), v_8bit(v_K[0][i * 4 + 3]), v_8bit(v_K[0][i * 4 + 1]), vcc
  end

  // ----- M-tile 1 cndmask (only when s_mtp >= 2) -----
  s_cmp_ge_u32 s_mtp, 2
  s_cbranch_scc0 q_load_skip_mtile1

  // Re-apply M1 exec mask
  s_cmp_ge_u32 s_mtp, 3
  s_cselect_b32 s_tmp0, 0xFFFFFFFF, 0x00FF00FF
  s_mov_b32 exec_lo, s_tmp0

  // Reuse the same lane[4] selector for M-tile 1.
  set_vgpr_msb(QUIET, v_tmp0, v0)
  v_lshrrev_b32 v_tmp0, 4, v0
  set_vgpr_msb(QUIET, v0, v_tmp0)
  v_cmp_lt_u32 vcc, v_tmp0, 1
  set_vgpr_msb(QUIET, v_Q[1], v_K[1], v_K[1])
  for var i in [0:Q_VGPR_PER_MTILE / 2 - 1]
    v_cndmask_b32 v_8bit(v_Q[1][i * 2]),     v_8bit(v_K[1][i * 4 + 2]), v_8bit(v_K[1][i * 4]),     vcc
    v_cndmask_b32 v_8bit(v_Q[1][i * 2 + 1]), v_8bit(v_K[1][i * 4 + 3]), v_8bit(v_K[1][i * 4 + 1]), vcc
  end

q_load_skip_mtile1:
  // Restore full exec mask
  s_mov_b32 exec_lo, 0xFFFFFFFF
end

function Q_apply_per_tensor_scale
  // Q is already FP8. s_key_scale has been folded to
  // query_scale * key_scale * log2(e), so the only per-row work here is to zero
  // invalid MTP rows and duplicate the scalar for packed FMA.
  s_add_u32 s_tmp0, s_mtp, 1
  s_mul_i32 s_tmp0, s_tmp0, s_gqa_ratio

  for var m in [0:G1_M_TILES - 1]
    set_vgpr_msb(QUIET, v_tmp0, v0)
    v_and_b32 v_tmp0, v0, 0xf
    if m > 0
      v_add_nc_u32 v_tmp0, v_tmp0, m * 16
    end

    set_vgpr_msb(QUIET, v0, v_tmp0)
    v_cmp_lt_u32 vcc, v_tmp0, s_tmp0

    set_vgpr_msb(QUIET, v_scl_log2e[m])
    v_cndmask_b32 v_8bit(v_scl_log2e[m][0]), 0, s_key_scale, vcc
    set_vgpr_msb(QUIET, v_scl_log2e[m], v_scl_log2e[m])
    v_mov_b32     v_8bit(v_scl_log2e[m][1]), v_8bit(v_scl_log2e[m][0])
  end
end

// ============================================================================
// Section 10: K/V TDM Setup & Load (with Block Table)
// ============================================================================

function K_TDM_init
  // K sub-block: 16×1024 (16 TDM rows × 1024 bytes/row = 16KB).
  // LDS-side view (used by K_LDS_load) stays 4×4096 = same 16KB.
  setup_TDM_init(s_K_g0, s_K_g1)
  // stride1 = row-to-row global byte stride within one page.
  // Each page is contiguous (kv_head, token, dim) so consecutive TDM rows
  // (each = 16 tokens × 64 bytes = 1024B) are 1024B apart in HBM.
  // Using s_K_blk_stride (16KB page-to-page) here would make TDM scan
  // 16 rows × 16KB = 256KB per call → IOMMU OOB.
  // Transposed K page [head_dim/16, block_size, 16] is still a contiguous 16KB
  // region, so the 16×1024 contiguous TDM copy is byte-identical to before.
  s_mov_b32 s_tmp0, K_TDM_TILE_DIM0
  setup_TDM_strides(s_K_g0, s_K_g1, K_TDM_TILE_DIM0, s_tmp0)
  setup_TDM_tile_dim(s_K_g0, s_K_g1, K_TDM_TILE_DIM0, K_TDM_TILE_DIM1, 0)  // no padding
  setup_TDM_tensor_dim0(s_K_g0, s_K_g1, K_TDM_TILE_DIM0)
  // Initial LDS addr placeholder (overridden per-tile in K_TDM_load_half).
  // Loader wave's first owned tile lives at K_LDS_BASE + s_TDM_wave_offset.
  s_add_i32 s_tmp0, s_TDM_wave_offset, K_LDS_BASE
  setup_TDM_lds_addr(s_K_g0, s_K_g1, s_tmp0)
end

function K_TDM_load_half(param buf_idx)
  // UNILOAD (Opt-40): single K tile per call (was 2). Wave w fills slot w in
  // buffer-half buf_idx (LDS offset = s_TDM_wave_offset = w*LDS_BLOCK_SIZE).
  // Page = s_loader_base_page (clamped). All 4 waves call this (no role gate).

  // BTPREFETCH: K_TDM_lookup_issue already issued the scalar block-table
  // load. Drain kmcnt before compute_K_phys_addr reads s_phys_blk_idx.
  s_wait_kmcnt 0

  // BTMERGE (Opt-42): K and V share the same logical page this iter, so V
  // reuses the K lookup result. Set s_V_phys_blk_idx for the V_TDM_load_half
  // that will fire at pv-tail of this iter. Cheap scalar mov, no kmcnt cost.
  s_mov_b32 s_V_phys_blk_idx, s_phys_blk_idx

  compute_K_phys_addr()

  s_add_i32 s_tmp0, s_TDM_wave_offset, K_LDS_BASE + K_LDS_BUF_SIZE * buf_idx
  setup_TDM_lds_addr(s_K_g0, s_K_g1, s_tmp0)

  // TDM-OOB-NOP (de-peel enabler): if this load's page is beyond the last valid
  // page, zero DIM1 + TILE0 + TILE1 so the TDM transfers 0 rows = nop. Lets the
  // unified (de-peeled) loop's last / overflow prefetch run harmlessly without a
  // peeled codepath. In-range branch restores the exact K_TDM_init dims, so
  // in-bounds behavior is byte-identical. The page is still clamped (s_min in
  // K_TDM_lookup) for the global address, so a mis-decision could only do a
  // redundant FULL load — it can never fault.
  // BUGFIX: use s_tdm_page_aux (captured at LOOKUP, where s_loader_base_page is
  // the true target page), NOT the live s_loader_base_page — page_advance_step
  // bumps it between lookup and load (steady loop) and V reuses K's page via
  // BTMERGE, so the live value is for the wrong page and was nop'ing VALID loads.
  s_cmp_gt_i32  s_tdm_page_aux, 0                        // scc = OOB (flag from lookup)
  s_cselect_b32 s_tmp0, 0, K_TDM_TILE_DIM1 << 16
  s_mov_b32     s_K_g1[2], s_tmp0                        // DIM1
  s_cselect_b32 s_tmp0, 0, K_TDM_TILE_DIM0 << 16
  s_mov_b32     s_K_g1[3], s_tmp0                        // TILE0
  s_cselect_b32 s_tmp0, 0, K_TDM_TILE_DIM1
  s_mov_b32     s_K_g1[4], s_tmp0                        // TILE1

  tensor_load_to_lds s_K_g0, s_K_g1, null, null
end

function V_TDM_init
  // V sub-block: 16×1024 (16 rows × 1024 bytes/row = 16KB)
  setup_TDM_init(s_V_g0, s_V_g1)
  // stride1 = row-to-row global byte stride within one page (see K_TDM_init).
  // V layout: [phys, kv_head, token/16, dim, token%16] -> consecutive TDM rows
  // (each = 64 dim × 16 tokens = 1024B) are 1024B apart in HBM.
  s_mov_b32 s_tmp0, V_TILE_DIM0
  setup_TDM_strides(s_V_g0, s_V_g1, V_TILE_DIM0, s_tmp0)
  setup_TDM_tile_dim(s_V_g0, s_V_g1, V_TILE_DIM0, V_TILE_DIM1, 0)  // no padding
  setup_TDM_tensor_dim0(s_V_g0, s_V_g1, V_TILE_DIM0)
  // Initial LDS addr placeholder (overridden per-tile in V_TDM_load_half).
  s_add_i32 s_tmp0, s_TDM_wave_offset, V_LDS_BASE
  setup_TDM_lds_addr(s_V_g0, s_V_g1, s_tmp0)
end

function V_TDM_load_half(param buf_idx)
  // UNILOAD (Opt-40): single V tile per call (was 2). Wave w fills slot w in
  // buffer-half buf_idx. Page = s_loader_base_page. All 4 waves call this.

  s_wait_kmcnt 0

  compute_V_phys_addr()

  s_add_i32 s_tmp0, s_TDM_wave_offset, V_LDS_BASE + V_LDS_BUF_SIZE * buf_idx
  setup_TDM_lds_addr(s_V_g0, s_V_g1, s_tmp0)

  // VOOBLOAD (small-seq NaN fix): do NOT nop the V load on OOB. The OOB-NOP left
  // the OOB wave's V LDS tile UNWRITTEN (stale). V is not masked (only the P/
  // scores are), so the PV WMMA computes P_fp8(=0) * V_stale; when the stale tile
  // holds an fp8-NaN byte, 0*NaN = NaN, which cross_wave_reduce then spreads
  // (correction=0 * NaN = NaN) into the whole row's O. Only bites SHORT seqs:
  // for long seqs the OOB waves clamp to a valid neighbouring page that IS loaded
  // (finite). Always loading the clamped page (s_min in lookup keeps it valid →
  // never faults; the comment in K_TDM_load_half confirms a redundant full load
  // is safe) makes V finite, so the masked PV is a clean 0. K keeps its OOB-NOP:
  // K-stale only affects scores, which the border mask overwrites with -INF
  // before any reduction, so K never produces NaN.
  s_lshl_b32 s_tmp0, V_TILE_DIM1, 16
  s_mov_b32  s_V_g1[2], s_tmp0                           // DIM1 (in-range; TILE0/1 from V_TDM_init)

  tensor_load_to_lds s_V_g0, s_V_g1, null, null
end

// ============================================================================
// Section 11: K/V LDS Read Address Generation
// ============================================================================

function K_LDS_rd_addr_gen
  set_vgpr_msb(QUIET)
  // PRE-TRANSPOSED K layout in LDS (= HBM page, written by TDM unchanged):
  //   page = [head_dim/16, block_size, 16]; byte = (dim/16)*4096 + token*16 + (dim%16)
  //   The 16 contiguous (dim%16) bytes per token map directly onto a b64 payload.
  //
  // WMMA-A operand (16x64 FP8) requires per-lane bit assignment:
  //   lane[3:0] = M  (token within a 16-token N-sub-tile)
  //   lane[4]   = K[3]                              (low/high 8 dims of a 16-dim group)
  //   vgpr[0]   = K[2]                              (within a b64's 8-byte payload)
  //   vgpr[1]   = K[4], vgpr[2] = K[5]              (head_dim/16 group → K[5:4])
  //   byte[1:0] = K[1:0]
  // Because (dim%16) is contiguous in the transposed page, a single ds_load_b64
  // of 8 contiguous bytes yields exactly {K[2], K[1:0]} for the lane's K[3] half.
  //
  // LDSB64-CO: lane[4] * 8 — K[3] selects the upper 8 dims of the 16-dim group.
  //
  // Per-lane base address (independent of msb / n_sub / pair, those are static
  // offsets in K_LDS_load):
  //   addr = K_LDS_BASE + wave_offset + lane[3:0] * 16 + lane[4] * 8

  v_and_b32     v_tmp0, v0, 0xf            // l[3:0] = token within N-sub-tile
  v_lshlrev_b32 v_tmp0, 4, v_tmp0          // * 16 (transposed token stride)

  v_lshrrev_b32 v_tmp1, 4, v0              // l[4]
  v_lshlrev_b32 v_tmp1, 3, v_tmp1          // * 8 (K[3] selects upper 8 dims of group)

  v_add_nc_i32  v_K_LDS_rd[0], v_tmp0, v_tmp1
  v_add_nc_i32  v_K_LDS_rd[0], v_K_LDS_rd[0], s_LDS_wave_offset
  v_add_nc_i32  v_K_LDS_rd[0], v_K_LDS_rd[0], K_LDS_BASE

  // Segments 1..3: same base address (segment index used in MSB / static offset)
  for var i in [1:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_K_LDS_rd[i], v_K_LDS_rd[0])
    v_mov_b32 v_8bit(v_K_LDS_rd[i]), v_K_LDS_rd[0]
  end
end

function V_LDS_rd_addr_gen
  set_vgpr_msb(QUIET)
  // V layout in LDS: 16×1024 (16 rows × 1024 bytes/row) per 16KB tile
  //   Row r contains tokens [r*16, r*16+15] × 64 HeadDim = 1024 bytes
  //
  // Build the per-lane invariant part of the WMMA-A operand address for PV.
  // v_wmma_f32_16x16x128_f8f6f4 A layout:
  //   lane = {K[3], M[3:0]}
  //   vgpr = {K[6], K[5], K[4], K[2]}
  //   byte = K[1:0]
  //
  // V is stored as [token/16, dim, token%16]. For one 16-dim tile:
  //   M = lane[3:0] selects dim within the 16-dim group.
  //   msb selects the 16-dim group itself, so it advances by
  //   16 dims * 16 token bytes = 256 bytes.
  //
  //   K[3] = lane[4] selects the low/high 8-token half within a 16-token row.
  // The remaining K bits are static offsets in V_LDS_load().
  v_and_b32     v_tmp0, v0, 0xf
  v_lshlrev_b32 v_tmp0, 4, v_tmp0               // M * 16

  v_lshrrev_b32 v_tmp1, 4, v0
  v_lshlrev_b32 v_tmp1, 3, v_tmp1               // K[3] * 8

  v_add_nc_i32  v_V_LDS_rd[0][0], v_tmp0, v_tmp1
  v_add_nc_i32  v_V_LDS_rd[0][0], v_V_LDS_rd[0][0], s_LDS_wave_offset
  v_add_nc_i32  v_V_LDS_rd[0][0], v_V_LDS_rd[0][0], V_LDS_BASE

  for var i in [1:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_V_LDS_rd[i], v_V_LDS_rd[0])
    v_mov_b32 v_8bit(v_V_LDS_rd[i][0]), v_V_LDS_rd[0][0]
  end
end

// ============================================================================
// Section 12: K/V LDS Load to VGPRs
// ============================================================================

function K_LDS_load(param msb, param buf_idx)
  // LDSB64-CO: 4 N-sub-tiles × 4 ds_load_b64 = 16 issues per msb. b64 chosen
  // over b128 because the permlane16_swap that b128 needs to restore WMMA-A
  // layout cannot co-execute with WMMA  // b64 has no permute and the extra
  // ds issues co-execute with WMMA in the gemm_pv_phase interleave.
  //
  // VGPR layout within msb's 32 VGPRs:
  //   v_K[msb][n_sub*8 + pair*2 + 0..1]   for n_sub in 0..3, pair in 0..3
  //     pair = 0..3 → K[5:4] = 00,01,10,11
  //   8-VGPR block at v_K[msb][n_sub*8 ..] = WMMA-A operand for (msb, n_sub).
  //
  // Static offset (per b64), transposed K [head_dim/16, block_size, 16]:
  //   msb   * K_LDS_MSB_STRIDE   (1024 B): 64-token group  (token = msb*64+...)
  //   n_sub * K_LDS_NSUB_STRIDE   (256 B): 16-token group within msb
  //   pair  * K_LDS_DHI_STRIDE   (4096 B): head_dim/16 group → K[5:4]

  // Per-(msb, buf_idx) dedicated address VGPR so prior K_LDS_load /
  // V_LDS_load on different (msb, buf_idx) does not WAR this v_add under
  // SCHED_MODE 2.
  var addr_idx = msb * 2 + buf_idx
  set_vgpr_msb(QUIET, v_K_LDS_issue_addr, v_K_LDS_rd[msb])
  v_add_nc_i32 v_K_LDS_issue_addr[addr_idx], v_8bit(v_K_LDS_rd[msb]), K_LDS_BUF_SIZE * buf_idx

  s_wait_alu { va_vdst: 0 }
  for var n_sub in [0:G1_N_TILES / VGPR_SEG_NUM - 1]    // 0..3
    for var pair in [0:3]
      var idx    = n_sub * 8 + pair * 2
      var offset = msb * K_LDS_MSB_STRIDE \
                 + n_sub * K_LDS_NSUB_STRIDE \
                 + pair * K_LDS_DHI_STRIDE
      set_vgpr_msb(QUIET, v_K[msb], v_K_LDS_issue_addr)
      ds_load_b64 v_8bit(v_K[msb][idx]), v_K_LDS_issue_addr[addr_idx] offset: offset
    end
  end
  // MSB-CO: break this call's last ds_load -> next K_LDS_load(msb+1)'s
  // s_set_vgpr_msb adjacency (load_initial_data calls this per-msb back-to-back).
  v_nop
end

// KVINTLV (Opt-26): K_LDS_load split for interleaved emission in pv_phase
// tail. K_LDS_addr_setup emits the v_add  // K_LDS_ds_issue emits the 16
// ds_load_b64 that consume it. The va_vdst drain between them is hoisted to
// the caller so a SINGLE drain covers all 4 msbs' addr_setups.
//
// K_LDS_load (combined form above) is retained for load_initial_data which
// has no interleave context.
function K_LDS_addr_setup(param msb, param buf_idx)
  var addr_idx = msb * 2 + buf_idx
  set_vgpr_msb(QUIET, v_K_LDS_issue_addr, v_K_LDS_rd[msb])
  v_add_nc_i32 v_K_LDS_issue_addr[addr_idx], v_8bit(v_K_LDS_rd[msb]), K_LDS_BUF_SIZE * buf_idx
end

function K_LDS_ds_issue(param msb, param buf_idx)
  // Caller MUST have emitted K_LDS_addr_setup(msb, buf_idx) earlier and
  // drained the resulting v_add via s_wait_alu { va_vdst: 0 } before calling.
  var addr_idx = msb * 2 + buf_idx
  for var n_sub in [0:G1_N_TILES / VGPR_SEG_NUM - 1]
    for var pair in [0:3]
      var idx    = n_sub * 8 + pair * 2
      var offset = msb * K_LDS_MSB_STRIDE \
                 + n_sub * K_LDS_NSUB_STRIDE \
                 + pair * K_LDS_DHI_STRIDE
      set_vgpr_msb(QUIET, v_K[msb], v_K_LDS_issue_addr)
      ds_load_b64 v_8bit(v_K[msb][idx]), v_K_LDS_issue_addr[addr_idx] offset: offset
    end
  end
end

// WMMACO (Opt-27): emit only the (msb, n_sub) quad = 4 ds_load_b64. Total
// matches K_LDS_ds_issue: 4 n_sub × this helper = 16 ds_loads per msb.
// Designed to be called once per WMMA in pa_gemm_pv so 32 K ds_loads (2 msb
// × 4 n_sub × 4 pair) co-execute with WMMA windows.
function K_LDS_ds_issue_pair(param msb, param buf_idx, param n_sub)
  var addr_idx = msb * 2 + buf_idx
  for var pair in [0:3]
    var idx    = n_sub * 8 + pair * 2
    var offset = msb * K_LDS_MSB_STRIDE \
               + n_sub * K_LDS_NSUB_STRIDE \
               + pair * K_LDS_DHI_STRIDE
    set_vgpr_msb(QUIET, v_K[msb], v_K_LDS_issue_addr)
    ds_load_b64 v_8bit(v_K[msb][idx]), v_K_LDS_issue_addr[addr_idx] offset: offset
  end
end

// VDS (Opt-48): split V_LDS_load into addr_setup + ds_issue so caller can
// hoist 4 addr_setups (single va_vdst drain) and distribute the 64 b64 across
// qk WMMA windows — mirror of K_LDS_addr_setup/_ds_issue used in pv_phase tail.
function V_LDS_addr_setup(param msb, param buf_idx)
  var addr_idx = msb * 2 + buf_idx
  set_vgpr_msb(QUIET, v_V_LDS_issue_addr, v_V_LDS_rd[msb])
  v_add_nc_i32 v_V_LDS_issue_addr[addr_idx], v_8bit(v_V_LDS_rd[msb][0]), V_LDS_BUF_SIZE * buf_idx
end

function V_LDS_ds_issue(param msb, param buf_idx)
  var addr_idx = msb * 2 + buf_idx
  for var k_batch in [0:1]
    for var jp in [0:7]
      var j   = jp * 2
      var idx = k_batch * 16 + j
      var k6  = (j / 8) % 2
      var k5  = (j / 4) % 2
      var k4  = (j / 2) % 2
      var offset = k_batch * 8 * V_TILE_DIM0 \
                 + k6 * 4 * V_TILE_DIM0 \
                 + k5 * 2 * V_TILE_DIM0 \
                 + k4 * V_TILE_DIM0 \
                 + msb * V_DIM_PER_MSB * 16
      set_vgpr_msb(QUIET, v_V[msb], v_V_LDS_issue_addr)
      ds_load_b64 v_8bit(v_V[msb][idx]), v_V_LDS_issue_addr[addr_idx] offset: offset
    end
  end
end

function V_LDS_load(param msb, param buf_idx)
  // LDSB64-CO: 2 k_batch × 8 jp = 16 ds_load_b64 per V_LDS_load call. Reverted
  // from b128 (k_batch × jp_pair = 8 b128) because the b128 form required 8
  // v_permlane16_swap_b32 per msb to restore WMMA-A layout, and permlane
  // cannot co-execute with WMMA. b64 needs no permute  // ds issue count
  // is absorbed by WMMA co-exec.
  //
  // For each output VGPR j: j[3:0] = {K[6], K[5], K[4], K[2]}.
  // VDS64: even/odd j-pairs share (k6,k5,k4) and differ only in k2 → 4 B
  // apart  // each pair collapses to one ds_load_b64 writing v_V[msb][idx,
  // idx+1] (v_V is align=2, even idx is b64-legal).

  // Per-(msb, buf_idx) stable seg0 address VGPR. Splitting by buf_idx (×2)
  // removes the SCHED_MODE 2 VM_VSRC WAR with the prior double-buffer half.
  var addr_idx = msb * 2 + buf_idx
  set_vgpr_msb(QUIET, v_V_LDS_issue_addr, v_V_LDS_rd[msb])
  v_add_nc_i32 v_V_LDS_issue_addr[addr_idx], v_8bit(v_V_LDS_rd[msb][0]), V_LDS_BUF_SIZE * buf_idx
  s_wait_alu { va_vdst: 0 }

  for var k_batch in [0:1]
    for var jp in [0:7]                                   // k2-pair: j_even = jp*2, j_odd = jp*2+1
      var j   = jp * 2
      var idx = k_batch * 16 + j
      var k6  = (j / 8) % 2
      var k5  = (j / 4) % 2
      var k4  = (j / 2) % 2
      var offset = k_batch * 8 * V_TILE_DIM0 \
                 + k6 * 4 * V_TILE_DIM0 \
                 + k5 * 2 * V_TILE_DIM0 \
                 + k4 * V_TILE_DIM0 \
                 + msb * V_DIM_PER_MSB * 16
      set_vgpr_msb(QUIET, v_V[msb], v_V_LDS_issue_addr)
      ds_load_b64 v_8bit(v_V[msb][idx]), v_V_LDS_issue_addr[addr_idx] offset: offset
    end
  end
end

// ============================================================================
// Section 13: GEMM Functions
// ============================================================================
//
// GEMM_QK: v_wmma_f32_16x16x64_fp8  (no scale)
//   S[TileQ × 256] = Q[TileQ × 64] × K^T[64 × 256]
//   Loop: G1_N_TILES=16 × G1_M_TILES=2 = 32 WMMA instructions
//   Output written to v_SP, clear-on-first (no accumulate for QK)
//
// GEMM_PV: v_wmma_f32_16x16x128_f8f6f4  (no scale)
//   D[TileQ × HeadDim] += P[TileQ × 256] × V[256 × HeadDim]
//   2 batches × 128 tokens × 4 HeadDim tiles × 2 M-tiles = 16 WMMA instructions
//   Accumulates into v_R

function pa_gemm_qk(param result[])
  // GEMM_QK: S[TileQ × 256] = Q[TileQ × 64] × K^T[64 × 256]
  // M-tiles along Q: G1_M_TILES=2 (TileQ=32 / INST_M=16)
  // N-tiles along tokens: G1_N_TILES=16 (PAGE_SIZE=256 / INST_N=16)
  // K=64=INST_K_QK: entire HeadDim reduced in one shot
  //
  // K data layout in v_K: 4 msb segments × 32 VGPRs
  //   msb 0: tokens 0-63 (N-tiles 0-3)
  //   msb 1: tokens 64-127 (N-tiles 4-7)
  //   msb 2: tokens 128-191 (N-tiles 8-11)
  //   msb 3: tokens 192-255 (N-tiles 12-15)
  //
  // SP f32 layout: 4 msb segments × 64 VGPRs (matches K msb partition)
  //   sp_msb = n >> 2   (0..3 = which 64-token group)
  //   Within msb: 2 M-tiles × 4 N-sub-tiles × 8 VGPR
  //   sp_idx = m*32 + (n & 3)*8
  var rlt = START_RESULT

  for var n in [0:G1_N_TILES - 1]
    for var m in [0:G1_M_TILES - 1]
      rlt = wmma_rlt(rlt)
      if is_gt_than(rlt, result)
        var sp_msb = n / 4
        var sp_idx = m * 32 + (n % 4) * 8
        var k_msb = n / 4         // same grouping as SP
        var kv_idx = (n % 4) * 8  // offset within K msb
        set_vgpr_msb(QUIET, v_SP[sp_msb], v_K[k_msb], v_Q[m])
        // v_wmma_f32_16x16x64_fp8: A=K[8vgpr], B=Q[8vgpr], D=S[8vgpr], no scale
        v_wmma_f32_16x16x64_fp8_fp8 v_8bit(v_SP[sp_msb][sp_idx]), v_8bit(v_K[k_msb][kv_idx]), v_8bit(v_Q[m]), 0
        return rlt
      end
    end
  end
  
  return mark_inst_finished(rlt)
end

function pa_gemm_pv(param result[])
  // GEMM_PV: R_iter[TileQ × HeadDim] += P[TileQ × 256] × V[256 × HeadDim]
  // Accumulates into v_R_iter (zeroed before every PV). After PV, pa_fold_R_iter
  // folds v_R_iter into the global v_R with per-M-tile v_ScaleS, implementing
  // the dynamic P-quant inverse scaling.
  // M-tiles along Q: G2_M_TILES=2
  // N-tiles along HeadDim: G2_N_TILES=4 (V_H_DIM=64 / INST_N=16)
  // K=128=INST_K_PV: 128 tokens reduced per instruction → 2 iterations for 256 tokens
  //
  // V data layout in v_V: 4 msb segments × 32 VGPRs
  //   msb 0: dim 0-15 for all 256 tokens
  //   msb 1: dim 16-31 for all 256 tokens
  //   msb 2: dim 32-47 for all 256 tokens
  //   msb 3: dim 48-63 for all 256 tokens
  //   Within msb: 2 batches × 16 VGPRs = 32 VGPRs (128 tokens per batch)
  //
  // P data: after pa_shuffle_P() each (m, k_batch) pair is coalesced into
  // 16 contiguous FP8 VGPRs at v_SP[2*m + k_batch][P_SHUFFLE_OFFSET .. +15].
  var rlt = START_RESULT

  for var k_batch in [0:1]          // 2 batches of 128 tokens
    for var n in [0:G2_N_TILES - 1] // 4 HeadDim N-tiles
      for var m in [0:G2_M_TILES - 1] // 2 M-tiles
        rlt = wmma_rlt(rlt)
        if is_gt_than(rlt, result)
          var r_msb = 2 * m + n / 2
          var r_idx = 8 * (n % 2)
          var v_msb = n                 // V msb = HeadDim N-tile index
          var kv_idx = k_batch * 16     // 16 VGPRs per 128-token batch
          // WILLACVT: 2-seg P layout. P-quant FP8 lives in v_SP[k_batch] (segs
          // 0/1 only), with the two M-tiles at byte-offset m*32 (m0 -> [0..15],
          // m1 -> [32..47]). Replaces the 4-seg NSM layout (v_SP[2m+k][PSO]).
          var p_msb = k_batch           // P seg = k_batch (msb/2), segs 0/1
          var p_idx = m * 32            // m-tile at offset 0 (m0) or 32 (m1)
          set_vgpr_msb(QUIET, v_R_iter[r_msb], v_V[v_msb], v_SP[p_msb], v_R_iter[r_msb])
          // v_wmma_f32_16x16x128_f8f6f4: D = A*B + C, where A=V[16vgpr], B=P[16vgpr],
          // D=R_iter[8vgpr], no scale. matrix_a_fmt:0 matrix_b_fmt:0 -> both operands
          // are FP8 (E4M3FNUZ). Without explicit format selectors the assembler defaults
          // A/B to FP4, so each FP8 byte gets decoded as two FP4 nibbles -> systematic
          // mis-scaling of D (~1.6x for the all-ones probe). Required for FP8.
          //
          // k_batch=0 (first WMMA per (m,n) tile): C = literal 0 → D = A*B (no
          //   accumulate from prior v_R_iter, replaces pa_zero_R_iter).
          // k_batch=1 (second WMMA same r_msb/r_idx): C = v_R_iter → D += A*B
          //   accumulates k_batch=0's partial.
          if k_batch == 0
            v_wmma_f32_16x16x128_f8f6f4 v_8bit(v_R_iter[r_msb][r_idx]), v_8bit(v_V[v_msb][kv_idx]), v_8bit(v_SP[p_msb][p_idx]), 0 matrix_a_fmt:MATRIX_FMT_FP8 matrix_b_fmt:MATRIX_FMT_FP8
          else
            v_wmma_f32_16x16x128_f8f6f4 v_8bit(v_R_iter[r_msb][r_idx]), v_8bit(v_V[v_msb][kv_idx]), v_8bit(v_SP[p_msb][p_idx]), v_8bit(v_R_iter[r_msb][r_idx]) matrix_a_fmt:MATRIX_FMT_FP8 matrix_b_fmt:MATRIX_FMT_FP8
          end
          return rlt
        end
      end
    end
  end
  
  return mark_inst_finished(rlt)
end

// ============================================================================
// Section 14: Folded Dequant after GEMM_QK
// ============================================================================
// v_wmma_f32_16x16x64_fp8 produces raw QK products. The scalar
// query_scale * key_scale * log2(e) is folded into v_scl_log2e so softmax can
// compute exp2(scale * S - scale * max) without a separate S dequant pass.
//
// Row max is still computed on raw S values  // every correction/exponent path
// applies the folded scale through v_scl_log2e.

// ============================================================================
// Section 15: Online Softmax (Flash Attention)
// ============================================================================
// For each GEMM_QK output tile S (raw, unscaled QK product):
//   1. Compute row max of raw S: curr_raw_max = max(S[row,:])
//   2. new_max = max(old_max, curr_raw_max)
//   3. delta = exp2(scl_log2e * (old_max - new_max))
//      [scl_log2e = query_scale * key_scale * log2(e)]
//      - D *= delta (rescale accumulator)
//      - L *= delta (rescale denominator)
//   4. P = exp2(scl_log2e * S - scl_log2e * new_max)  [folds dequant into exp input]
//   5. L += row_sum(P)
//   6. Quantize P to FP8 for GEMM_PV
//   7. old_max <- new_max

// ----------------------------------------------------------------------------
// Merged Max Reduction (both m_tiles jointly) — replaces Step 1 of old per-m softmax.
//
// Computes this-iter row max for BOTH rb0 (m=0, rows 0..15) and rb1 (m=1, rows 16..31).
//
// Output contract:
//   v_curr_max[0] = this-iter full row max for rb0      (NO history fold)
//   v_curr_max[1] = this-iter full row max for rb1      (NO history fold)
//
// History merge (max with v_max[m]) is handled by Step 2 of each pa_fuesed_softmax(m).
//
// Algorithm (per my_softmax_max.md):
//   Stage A (per-msb, 24 ops each = 96 total):
//     Phase 1: 16 indep max3 → vp_rb0/rb1[msb][0..7]  (covers v_SP[msb][0..23] / [32..55])
//     Phase 2:  8 RMW   max3 → vp_rb0/rb1[msb][0..3]  (absorbs v_SP[msb][24..31] / [56..63])
//   Cross-msb 2.1 (msb=3 tail, 16 ops): 3-way merge msb0/1/2 into vp_rb*[0]
//   Cross-msb 2.2 (8 ops): absorb msb3's 8 partials into vp_rb*[0][0..3]
//   Step 3 (8 ops): vp_rb*[0][0..7] → vp_rb*[0][0]    (D = 2-input max, no history fold)
//   Permlane + final (4 ops): cross-lane swap + final max → v_curr_max[0/1]
//
// Total: 132 ops. ~7 unique set_vgpr_msb tuples (tracker dedups runtime emits).
// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------
// Per-msb reduction call. msb=0/1/2 do their stage A only; msb=3 also does
// the cross-msb tail (2.1, 2.2, step 3, permlane, final → v_curr_max[0/1]).
//
// Splitting into 4 calls (one per msb) is groundwork for P3: msb=3 reduction
// can then chain directly into msb=3's exp chain, while msb=0/1/2 reduction
// calls and exp_chain calls can be reordered around each other.
//
// P1: pure restructure — emits exactly the same op sequence as the previous
// monolithic pa_softmax_max_merged(). Expected bit-identical to baseline.
// ----------------------------------------------------------------------------
function pa_softmax_reduce_msb(param msb, param result[])
  var rlt = set_inst_user_data(START_RESULT, get_inst_user_data(result))

  // -------- Stage A: this msb's 32-vgpr → 8 partials per row-band --------
  // Phase 1: 16 indep max3 (rb0/rb1 interleaved)
  for var i in [0:7]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb0[msb], v_SP[msb], v_SP[msb], v_SP[msb])
      v_max3_f32 v_8bit(vp_rb0[msb][i]), \
                 v_8bit(v_SP[msb][3*i]), \
                 v_8bit(v_SP[msb][3*i+1]), \
                 v_8bit(v_SP[msb][3*i+2])
    end
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb1[msb], v_SP[msb], v_SP[msb], v_SP[msb])
      v_max3_f32 v_8bit(vp_rb1[msb][i]), \
                 v_8bit(v_SP[msb][32+3*i]), \
                 v_8bit(v_SP[msb][32+3*i+1]), \
                 v_8bit(v_SP[msb][32+3*i+2])
    end
  end
  // Phase 2: 8 RMW max3 (eat remaining v_SP[msb][24..31] for rb0, [56..63] for rb1)
  for var i in [0:3]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb0[msb], vp_rb0[msb], v_SP[msb], v_SP[msb])
      v_max3_f32 v_8bit(vp_rb0[msb][i]), \
                 v_8bit(vp_rb0[msb][i]), \
                 v_8bit(v_SP[msb][24+2*i]), \
                 v_8bit(v_SP[msb][24+2*i+1])
    end
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb1[msb], vp_rb1[msb], v_SP[msb], v_SP[msb])
      v_max3_f32 v_8bit(vp_rb1[msb][i]), \
                 v_8bit(vp_rb1[msb][i]), \
                 v_8bit(v_SP[msb][56+2*i]), \
                 v_8bit(v_SP[msb][56+2*i+1])
    end
  end

  if msb == 3

  // -------- Cross-msb 2.1: 3-way merge msb0/1/2 → vp_rb*[0] (16 ops) --------
  for var i in [0:7]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[1], vp_rb0[2])
      v_max3_f32 v_8bit(vp_rb0[0][i]), \
                 v_8bit(vp_rb0[0][i]), \
                 v_8bit(vp_rb0[1][i]), \
                 v_8bit(vp_rb0[2][i])
    end
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[1], vp_rb1[2])
      v_max3_f32 v_8bit(vp_rb1[0][i]), \
                 v_8bit(vp_rb1[0][i]), \
                 v_8bit(vp_rb1[1][i]), \
                 v_8bit(vp_rb1[2][i])
    end
  end

  // -------- Cross-msb 2.2: absorb msb3's 8 partials into vp_rb*[0][0..3] (8 ops) --------
  for var i in [0:3]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[3], vp_rb0[3])
      v_max3_f32 v_8bit(vp_rb0[0][i]), \
                 v_8bit(vp_rb0[0][i]), \
                 v_8bit(vp_rb0[3][2*i]), \
                 v_8bit(vp_rb0[3][2*i+1])
    end
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[3], vp_rb1[3])
      v_max3_f32 v_8bit(vp_rb1[0][i]), \
                 v_8bit(vp_rb1[0][i]), \
                 v_8bit(vp_rb1[3][2*i]), \
                 v_8bit(vp_rb1[3][2*i+1])
    end
  end

  // -------- Step 3: vp_rb*[0][0..7] → vp_rb*[0][0] per rb (8 ops; D is 2-in max) --------
  // BUBBLE [1 slot]: 2.2 → step 3 A (A_rb0 reads vp_rb0[0][0/2/4]; [0],[2] written by 2.2 ≤ 4 cyc ago).
  //   TODO fill: e.g. pre_max_log2e_rb0 prep mul (reads OLD v_max[0], not written by max_merged).
  // A: vp_rb*[0][0] = max3(vp_rb*[0][0], vp_rb*[0][2], vp_rb*[0][4])
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0], vp_rb0[0])
        v_max3_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][2]), v_8bit(vp_rb0[0][4])
      else
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0], vp_rb1[0])
        v_max3_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][2]), v_8bit(vp_rb1[0][4])
      end
    end
  end
  // B: vp_rb*[0][1] = max3(vp_rb*[0][1], vp_rb*[0][3], vp_rb*[0][5])
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0], vp_rb0[0])
        v_max3_f32 v_8bit(vp_rb0[0][1]), v_8bit(vp_rb0[0][1]), v_8bit(vp_rb0[0][3]), v_8bit(vp_rb0[0][5])
      else
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0], vp_rb1[0])
        v_max3_f32 v_8bit(vp_rb1[0][1]), v_8bit(vp_rb1[0][1]), v_8bit(vp_rb1[0][3]), v_8bit(vp_rb1[0][5])
      end
    end
  end
  // BUBBLE [1 slot]: A → C (C reads vp_rb*[0][0] just written by A, 4-cyc dep).
  //   TODO fill: 1 prep op (e.g. pre_max_log2e_rb1 mul).
  // C: vp_rb*[0][0] = max3(vp_rb*[0][0], vp_rb*[0][6], vp_rb*[0][7])  (RAW on A's vp_rb*[0][0])
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0], vp_rb0[0])
        v_max3_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][6]), v_8bit(vp_rb0[0][7])
      else
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0], vp_rb1[0])
        v_max3_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][6]), v_8bit(vp_rb1[0][7])
      end
    end
  end
  // BUBBLE [3 slots]: C → D (D reads vp_rb*[0][0] just written by C; only 2 cyc between C_rb0 and D_rb0 → 3 slot stall).
  //   TODO fill: 3 prep ops (e.g. v_mov tmp0_rb0/rb1 prep + 1 more delta_max precomputation).
  // D: vp_rb*[0][0] = max(vp_rb*[0][0], vp_rb*[0][1])  (RAW on B,C; 2-in max — history NOT folded here)
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0])
        v_max_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][1])
      else
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0])
        v_max_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][1])
      end
    end
  end

  // BUBBLE [3 slots]: D → permlane (permlane reads vp_rb*[0][0] just written by D; only 1 cyc between D_rb1 and permlane_rb0 → 3 slot stall, permlane has longer issue latency than normal VALU).
  //   TODO fill: 3 prep ops (e.g. delta_max prep fma×2 + tmp1 mov).
  // -------- Permlane swap (2 ops) --------
  // Cross-lane: read vp_rb*[0][0] from sibling lane (col_group 0 ↔ 1), write to v_curr_max[rb]
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, v_curr_max, vp_rb0[0])
        v_permlanex16_b32 v_curr_max[0], v_8bit(vp_rb0[0][0]), s_permlanex16_sel[0], s_permlanex16_sel[1]
      else
        set_vgpr_msb(QUIET, v_curr_max, vp_rb1[0])
        v_permlanex16_b32 v_curr_max[1], v_8bit(vp_rb1[0][0]), s_permlanex16_sel[0], s_permlanex16_sel[1]
      end
    end
  end
  // BUBBLE [2 slots]: permlane → final max (cyc 44 and cyc 46 in design — 1 slot before each rb's final max op due to permlane's dep latency).
  //   permlanex16 and v_max_f32 are both VALU pipe → hardware auto-stalls the
  //   5-cyc RAW, no s_wait_alu needed.
  //   TODO fill: 2 prep ops (e.g. v_pk_fma_f32 for delta_max[m] precomputation).
  // Final max (2 ops): combine swapped value with own half → v_curr_max[rb]
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, v_curr_max, v_curr_max, vp_rb0[0])
        v_max_f32 v_curr_max[0], v_curr_max[0], v_8bit(vp_rb0[0][0])
      else
        set_vgpr_msb(QUIET, v_curr_max, v_curr_max, vp_rb1[0])
        v_max_f32 v_curr_max[1], v_curr_max[1], v_8bit(vp_rb1[0][0])
      end
    end
  end

  // ============================================================================
  // Stage 1 prep (P2) + priming-fma interleave.
  //
  // dep chain (Flash + Quant) is rb-interleaved; the 48 priming v_pk_fma_f32 that
  // used to live in exp_chain Phase 1 are pulled in as 8 blocks of 6 (one block
  // per (msb, mtile)) and packed into the dep-chain bubbles. Pure reorder.
  // Schedule + cycle table: prep_fma_interleave.md.
  //
  // Per rb (rb=m_tile) produces (unchanged outputs):
  //   v_delta_max[rb]       = exp2(scl·(OLD - NEW))   (D/L rescale)
  //   v_max[rb]             = NEW
  //   v_ScaleS[rb]          = row_max(P) / kE4M3Max   (fold_R_iter)
  //   v_p_quant_mul[rb]     = kE4M3Max / row_max(P)   (NaN-guarded)
  //   v_curr_max_scaled[rb] = scl·NEW                 (read by exp_chain Phase 2)
  //
  // Formula vs the older ①–⑯ split: NEW is kept in v_tmp1/v_tmp0 so v_max stays
  // OLD until the commit mov; v_curr_max_scaled = scl·NEW is hoisted to the front
  // as the shared addend; delta_max & scaleS become single v_fma_f32 reading
  // -v_curr_max_scaled (drops old ① tmp1 and ⑨). Plain sequential emit
  // (issue_all fires in source order → source order IS the schedule).
  // first_iter comes from the result's user_data (set by the caller).
  // ============================================================================

  // new_max[rb] = max(v_curr_max[rb], v_max[rb]_OLD) → v_tmp1/v_tmp0 (v_max stays OLD)
  set_vgpr_msb(QUIET, v_tmp1, v_curr_max, v_max[0])
  v_max_f32 v_tmp1, v_8bit(v_curr_max[0]), v_8bit(v_max[0])
  set_vgpr_msb(QUIET, v_tmp0, v_curr_max, v_max[1])
  v_max_f32 v_tmp0, v_8bit(v_curr_max[1]), v_8bit(v_max[1])

  // ⑦ v_curr_max_scaled[rb][0] = scl_log2e[rb] · NEW  (shared -addend; persistent)
  set_vgpr_msb(QUIET, v_curr_max_scaled[0], v_scl_log2e[0], v_tmp1)
  v_mul_f32 v_curr_max_scaled[0][0], v_8bit(v_scl_log2e[0]), v_tmp1
  set_vgpr_msb(QUIET, v_curr_max_scaled[1], v_scl_log2e[1], v_tmp0)
  v_mul_f32 v_curr_max_scaled[1][0], v_8bit(v_scl_log2e[1]), v_tmp0

  // ⑦b dup v_curr_max_scaled[rb][1] = [0]  (packed src2 for the fmas)
  set_vgpr_msb(QUIET, v_curr_max_scaled[0], v_curr_max_scaled[0])
  v_mov_b32 v_curr_max_scaled[0][1], v_curr_max_scaled[0][0]
  set_vgpr_msb(QUIET, v_curr_max_scaled[1], v_curr_max_scaled[1])
  v_mov_b32 v_curr_max_scaled[1][1], v_curr_max_scaled[1][0]

  // ③ v_delta_max[rb] = fma(v_max_OLD, scl, -v_curr_max_scaled) = scl·(OLD-NEW)
  //    first page for this M-tile: delta_max = 1.0 → arg 0
  set_vgpr_msb(QUIET, v_delta_max[0], v_max[0], v_scl_log2e[0], v_curr_max_scaled[0])
  if get_inst_user_data(result)
    v_mov_b32 v_8bit(v_delta_max[0]), 0
  else
    v_fma_f32 v_8bit(v_delta_max[0]), v_8bit(v_max[0]), v_8bit(v_scl_log2e[0]), -v_curr_max_scaled[0][0]
  end
  set_vgpr_msb(QUIET, v_delta_max[1], v_max[1], v_scl_log2e[1], v_curr_max_scaled[1])
  if get_inst_user_data(result)
    v_mov_b32 v_8bit(v_delta_max[1]), 0
  else
    v_fma_f32 v_8bit(v_delta_max[1]), v_8bit(v_max[1]), v_8bit(v_scl_log2e[1]), -v_curr_max_scaled[1][0]
  end

  // ⑧⑨ v_ScaleS[rb][0] = fma(v_curr_max, scl, -v_curr_max_scaled) = scl·(curr_iter_max - NEW) ≤ 0
  set_vgpr_msb(QUIET, v_ScaleS[0], v_curr_max, v_scl_log2e[0], v_curr_max_scaled[0])
  v_fma_f32 v_8bit(v_ScaleS[0]), v_8bit(v_curr_max[0]), v_8bit(v_scl_log2e[0]), -v_curr_max_scaled[0][0]
  set_vgpr_msb(QUIET, v_ScaleS[1], v_curr_max, v_scl_log2e[1], v_curr_max_scaled[1])
  v_fma_f32 v_8bit(v_ScaleS[1]), v_8bit(v_curr_max[1]), v_8bit(v_scl_log2e[1]), -v_curr_max_scaled[1][0]

  // ▸ priming fma block (msb=0, mtile=0): S[0..11] step 2
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[0], v_SP[0], v_scl_log2e[0], v_curr_max_scaled[0])
    v_pk_fma_f32 v_8bit(v_SP[0][0 * 32 + 2 * k]), v_8bit(v_SP[0][0 * 32 + 2 * k]), v_8bit(v_scl_log2e[0]), -v_curr_max_scaled[0]
  end

  // ⑤ exp2(delta_max[rb]) interleaved with commit mov v_max[rb]=NEW.
  // co-exec needs strict exp/alu/exp/alu: each exp must be immediately followed
  // by one independent ALU so the HW co-issues it in the trans 2-cyc window.
  // commit mov reads new_max (v_tmp1/v_tmp0), independent of delta_max.
  set_vgpr_msb(QUIET, v_delta_max[0], v_delta_max[0])
  v_exp_f32 v_8bit(v_delta_max[0]), v_8bit(v_delta_max[0])
  set_vgpr_msb(QUIET, v_max[0], v_tmp1)
  v_mov_b32 v_8bit(v_max[0]), v_tmp1
  set_vgpr_msb(QUIET, v_delta_max[1], v_delta_max[1])
  v_exp_f32 v_8bit(v_delta_max[1]), v_8bit(v_delta_max[1])
  set_vgpr_msb(QUIET, v_max[1], v_tmp0)
  v_mov_b32 v_8bit(v_max[1]), v_tmp0

  // ▸ priming fma block (msb=1, mtile=0)
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[1], v_SP[1], v_scl_log2e[0], v_curr_max_scaled[0])
    v_pk_fma_f32 v_8bit(v_SP[1][0 * 32 + 2 * k]), v_8bit(v_SP[1][0 * 32 + 2 * k]), v_8bit(v_scl_log2e[0]), -v_curr_max_scaled[0]
  end

  // ⑩ exp2(ScaleS[rb]) interleaved with ⑥ dup delta_max[rb][1]=[0] (for D/L
  //   rescale pk_mul). exp/alu/exp/alu for co-exec. dup reads the earlier ⑤ exp
  //   result (gap ≥8 already met), independent of ScaleS exp.
  set_vgpr_msb(QUIET, v_ScaleS[0], v_ScaleS[0])
  v_exp_f32 v_8bit(v_ScaleS[0]), v_8bit(v_ScaleS[0])
  set_vgpr_msb(QUIET, v_delta_max[0], v_delta_max[0])
  v_mov_b32 v_8bit(v_delta_max[0][1]), v_8bit(v_delta_max[0][0])
  set_vgpr_msb(QUIET, v_ScaleS[1], v_ScaleS[1])
  v_exp_f32 v_8bit(v_ScaleS[1]), v_8bit(v_ScaleS[1])
  set_vgpr_msb(QUIET, v_delta_max[1], v_delta_max[1])
  v_mov_b32 v_8bit(v_delta_max[1][1]), v_8bit(v_delta_max[1][0])

  // ▸ priming fma block (msb=2, mtile=0)
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[2], v_SP[2], v_scl_log2e[0], v_curr_max_scaled[0])
    v_pk_fma_f32 v_8bit(v_SP[2][0 * 32 + 2 * k]), v_8bit(v_SP[2][0 * 32 + 2 * k]), v_8bit(v_scl_log2e[0]), -v_curr_max_scaled[0]
  end

  // ⑪ v_ScaleS[rb][0] *= 1/448   (src0 literal — pass v_ScaleS[rb] as src0 reg to
  //   avoid forcing SRC0_MSB to 0 and double-toggling the tuple)
  set_vgpr_msb(QUIET, v_ScaleS[0], v_ScaleS[0], v_ScaleS[0])
  v_mul_f32 v_8bit(v_ScaleS[0]), kE4M3MaxInv, v_8bit(v_ScaleS[0])
  set_vgpr_msb(QUIET, v_ScaleS[1], v_ScaleS[1], v_ScaleS[1])
  v_mul_f32 v_8bit(v_ScaleS[1]), kE4M3MaxInv, v_8bit(v_ScaleS[1])

  // ▸ priming fma block (msb=3, mtile=0)   [feeds the gap for ⑫ and ⑬ below]
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[3], v_SP[3], v_scl_log2e[0], v_curr_max_scaled[0])
    v_pk_fma_f32 v_8bit(v_SP[3][0 * 32 + 2 * k]), v_8bit(v_SP[3][0 * 32 + 2 * k]), v_8bit(v_scl_log2e[0]), -v_curr_max_scaled[0]
  end

  // ⑬ rcp(ScaleS[rb]) interleaved with ⑫ dup v_ScaleS[rb][1]=[0] (for fold_R_iter
  //   pk_fma). exp/alu/exp/alu for co-exec. rcp and dup both only READ ScaleS[0]
  //   (no write conflict); dup writes ScaleS[1] → independent of rcp.
  set_vgpr_msb(QUIET, v_p_quant_mul[0], v_ScaleS[0])
  v_rcp_f32 v_8bit(v_p_quant_mul[0]), v_8bit(v_ScaleS[0])
  set_vgpr_msb(QUIET, v_ScaleS[0], v_ScaleS[0])
  v_mov_b32 v_8bit(v_ScaleS[0][1]), v_8bit(v_ScaleS[0][0])
  set_vgpr_msb(QUIET, v_p_quant_mul[1], v_ScaleS[1])
  v_rcp_f32 v_8bit(v_p_quant_mul[1]), v_8bit(v_ScaleS[1])
  set_vgpr_msb(QUIET, v_ScaleS[1], v_ScaleS[1])
  v_mov_b32 v_8bit(v_ScaleS[1][1]), v_8bit(v_ScaleS[1][0])

  // L rescale: v_L[rb] *= v_delta_max[rb]  (moved here from exp_chain msb=0 step
  //   (2); both rb done once per iter in prep, before any L += sum(P) in exp_chain
  //   Phase 3-4. delta_max is the ⑤ exp result, ready long ago. v_L[1] is seg 1.)
  set_vgpr_msb(QUIET, v_L[0], v_L[0], v_delta_max[0])
  v_mul_f32 v_8bit(v_L[0]), v_8bit(v_L[0]), v_8bit(v_delta_max[0])
  set_vgpr_msb(QUIET, v_L[1], v_L[1], v_delta_max[1])
  v_mul_f32 v_8bit(v_L[1]), v_8bit(v_L[1]), v_8bit(v_delta_max[1])

  // ▸ priming fma block (msb=0, mtile=1)   [垫 rcp 8-cyc gap → ⑭⑮ 推到 ready 之后]
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[0], v_SP[0], v_scl_log2e[1], v_curr_max_scaled[1])
    v_pk_fma_f32 v_8bit(v_SP[0][1 * 32 + 2 * k]), v_8bit(v_SP[0][1 * 32 + 2 * k]), v_8bit(v_scl_log2e[1]), -v_curr_max_scaled[1]
  end

  // ⑭⑮ NaN guard, paired per rb (cmp writes vcc, cndmask reads vcc; HW forwards
  //   vcc with no dep cost, so cmp must be immediately followed by its cndmask).
  set_vgpr_msb(QUIET, v_p_quant_mul[0], v_ScaleS[0])
  v_cmp_eq_f32 vcc, v_8bit(v_ScaleS[0]), 0
  set_vgpr_msb(QUIET, v_p_quant_mul[0], v_p_quant_mul[0])
  v_cndmask_b32 v_8bit(v_p_quant_mul[0]), v_8bit(v_p_quant_mul[0]), 0, vcc
  set_vgpr_msb(QUIET, v_p_quant_mul[1], v_ScaleS[1])
  v_cmp_eq_f32 vcc, v_8bit(v_ScaleS[1]), 0
  set_vgpr_msb(QUIET, v_p_quant_mul[1], v_p_quant_mul[1])
  v_cndmask_b32 v_8bit(v_p_quant_mul[1]), v_8bit(v_p_quant_mul[1]), 0, vcc

  // ▸ priming fma block (msb=1, mtile=1)   [gap for ⑯ below]
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[1], v_SP[1], v_scl_log2e[1], v_curr_max_scaled[1])
    v_pk_fma_f32 v_8bit(v_SP[1][1 * 32 + 2 * k]), v_8bit(v_SP[1][1 * 32 + 2 * k]), v_8bit(v_scl_log2e[1]), -v_curr_max_scaled[1]
  end

  // ⑯ dup v_p_quant_mul[rb][1] = [0]  (for pk_mul P-scaling, msb=0 master)
  set_vgpr_msb(QUIET, v_p_quant_mul[0], v_p_quant_mul[0])
  v_mov_b32 v_8bit(v_p_quant_mul[0][1]), v_8bit(v_p_quant_mul[0][0])
  set_vgpr_msb(QUIET, v_p_quant_mul[1], v_p_quant_mul[1])
  v_mov_b32 v_8bit(v_p_quant_mul[1][1]), v_8bit(v_p_quant_mul[1][0])

  // ▸ priming fma block (msb=2, mtile=1)
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[2], v_SP[2], v_scl_log2e[1], v_curr_max_scaled[1])
    v_pk_fma_f32 v_8bit(v_SP[2][1 * 32 + 2 * k]), v_8bit(v_SP[2][1 * 32 + 2 * k]), v_8bit(v_scl_log2e[1]), -v_curr_max_scaled[1]
  end

  // ---- Broadcast v_p_quant_mul[0..1] (msb=0 master in seg 0) → msb=1/2/3 copies ----
  // Lets Phase 3-4 (pk_add, pk_mul) windows keep one MSB tuple (src1 in seg msb).
  // dst_msb outer / rb inner: tuple only changes on dst_msb (src always seg 0)
  // → 3 set_vgpr_msb (vs 5 with rb outer). rb=0/rb=1 are independent (distinct
  // master + dst). rb=1 master (⑮) → its broadcast read is still ~3 ops apart,
  // enough to hide the RAW.
  for var dst_msb in [1:NUM_MSB_SEGMENTS - 1]
    for var rb in [0:1]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, v_p_quant_mul[dst_msb * 2 + rb], v_p_quant_mul[rb])
        v_mov_b32 v_8bit(v_p_quant_mul[dst_msb * 2 + rb][0]), v_8bit(v_p_quant_mul[rb][0])
      end
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, v_p_quant_mul[dst_msb * 2 + rb], v_p_quant_mul[rb])
        v_mov_b32 v_8bit(v_p_quant_mul[dst_msb * 2 + rb][1]), v_8bit(v_p_quant_mul[rb][0])
      end
    end
  end

  // ▸ priming fma block (msb=3, mtile=1)   [last block; fills the broadcast tail]
  for var k in [0:5]
    set_vgpr_msb(QUIET, v_SP[3], v_SP[3], v_scl_log2e[1], v_curr_max_scaled[1])
    v_pk_fma_f32 v_8bit(v_SP[3][1 * 32 + 2 * k]), v_8bit(v_SP[3][1 * 32 + 2 * k]), v_8bit(v_scl_log2e[1]), -v_curr_max_scaled[1]
  end

  end  // if msb == 3 (cross-msb tail + Stage 1 prep)

  return mark_inst_finished(rlt)
end

// ============================================================================
// pa_softmax_exp_chain_msb(msb): per-msb softmax post-reduction work (P3).
//
// Replaces pa_fuesed_softmax(m). Called 4×, msb=0..3.
//
// On entry (Stage 1 prep done in pa_softmax_reduce_msb(3) for both rb):
//   v_max[rb]         = NEW row max (history folded)
//   v_delta_max[rb]   = exp2(scl·(OLD - NEW))    packed pair  (=1.0 on first_iter)
//   v_ScaleS[rb]      = row_max(P) / kE4M3Max    packed pair  (consumed by pa_fold_R_iter)
//   v_p_quant_mul[rb] = kE4M3Max / row_max(P)    packed pair  (NaN-guarded)
//   v_curr_max[rb]    = this-iter row max (no history)
//
// Per call (msb=msb):
//   (1) D rescale: v_R[r_seg=msb] *= v_delta_max[m=msb/2]  (8 pk_mul)
//   (2) msb=0 only: L rescale v_L[rb] *= v_delta_max[rb] for rb=0,1
//   (3) For rb=0,1: exp chain on this msb's S slice (32 vgpr at v_SP[msb][rb*32+0..31])
//         Phase 1 (6 priming pk_fma) — MOVED to Stage 1 prep (reduce_msb(3))
//         Phase 2 (10 exp || 10 pk_fma)
//         Phase 3-4 (22 exp || (pk_add accum | pk_mul P×p_quant))
//         Phase 5 tail (pk_add S[26,27], 3 pk_mul, pk_add tmp4/5 init, 2 pk_mul)
//         cvt P → fp8 (16 cvt)
//   (4) msb=3 only: cross-msb fold of per-msb-per-rb row_sum partials → v_L[rb]
//
// Per-rb partial-sum stash (reuses post-reduction-dead vp_rb*[msb][0..5]):
//   tmp0/1 @ vp_rb*[msb][0..1]   tmp2/3 @ vp_rb*[msb][2..3]   tmp4/5 @ vp_rb*[msb][4..5]
//   (vp_rb* = vp_rb0 for rb=0, vp_rb1 for rb=1)
//
// CRITICAL: every v_exp_f32 is followed in SOURCE by an independent ALU op so
// the HW dispatches both into the trans+ALU pipes during exp's 2-cyc window.
// Batching all fma → all exp (as in original pa_fuesed_softmax / failed P3)
// wastes the ALU pipe entirely. See progress.md for the failure mode.
// ============================================================================
function pa_softmax_exp_chain_msb(param msb, param result[])
  var rlt = set_inst_user_data(START_RESULT, get_inst_user_data(result))
  var m    = msb / 2                            // r_seg=msb → m-tile m=msb/2
  var F32N = 32
  var FP8N = 8

  // -------- (1) D rescale: v_R[r_seg=msb] *= v_delta_max[m] (8 pk_mul) --------
  for var i in [0:2:R_VGPR_SECT_SIZE - 1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, v_R[msb], v_R[msb], v_delta_max[m])
      v_pk_mul_f32 v_8bit(v_R[msb][i]), v_8bit(v_R[msb][i]), v_8bit(v_delta_max[m])
    end
  end

  // -------- (2) L rescale MOVED to Stage 1 prep (reduce_msb(3), after scaleS) --------
  // v_L[rb] *= v_delta_max[rb] now runs once in prep for both rb (was here under
  // msb==0). See pa_softmax_reduce_msb / prep_fma_interleave.md.

  // -------- (3) Two-row-band exp chain (Phase 2-4 interleaved, Phase 5 combined) --------
  // curr_max_scaled[rb] precomputed in prep (step ⑦/⑦b); Phase 1 (priming fma)
  // also moved to prep. Phase 2-4 interleave rb0/rb1 (same seg → no extra set_msb)
  // so BOTH bands' exp finish before the combined Phase 5. S[26..31] quant is
  // DEFERRED to msb=3 step (4) (fills the 6→1 fold). See my_softmax_post.md.
  // Pure reorder vs the old per-rb chain (each band's accumulation order preserved)
  // → bit-exact.

  // ----- Phase 2: 10 windows × 2 rb (exp S[k] | pk_fma S[12+2k,13+2k]) -----
  for var k in [0:9]
    for var rb in [0:1]
      // exp S[rb*32+k]
      rlt = trans_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, v_SP[msb], v_SP[msb])
        v_exp_f32 v_8bit(v_SP[msb][rb * 32 + k]), v_8bit(v_SP[msb][rb * 32 + k])
      end
      // pk_fma S[rb*32+12+2k, rb*32+13+2k]   (paired with exp above for co-execution)
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, v_SP[msb], v_SP[msb], v_scl_log2e[rb], v_curr_max_scaled[rb])
        v_pk_fma_f32 v_8bit(v_SP[msb][rb * 32 + 12 + 2 * k]), v_8bit(v_SP[msb][rb * 32 + 12 + 2 * k]), v_8bit(v_scl_log2e[rb]), -v_curr_max_scaled[rb]
      end
    end
  end

  // ----- Phase 3-4: 22 windows × 2 rb (exp S[10+w] | ALU). ALU pattern by w:
  //   even w == 0:                  init tmp0/1 = S[0,1] + S[2,3]
  //   even w == 2:                  init tmp2/3 = S[4,5] + S[6,7]
  //   even w >= 4, (w%4)==0:        tmp0/1 += S[w+4, w+5]
  //   even w >= 4, (w%4)==2:        tmp2/3 += S[w+4, w+5]
  //   odd w:                        pk_mul S[w-1, w] in-place by v_p_quant_mul[rb]
  for var w in [0:21]
    for var rb in [0:1]
      // exp S[rb*32 + 10 + w]
      rlt = trans_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, v_SP[msb], v_SP[msb])
        v_exp_f32 v_8bit(v_SP[msb][rb * 32 + 10 + w]), v_8bit(v_SP[msb][rb * 32 + 10 + w])
      end

      // paired ALU (independent of the exp above for co-execution)
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        if w % 2 == 1
          // odd w: pk_mul S[w-1, w] in-place by v_p_quant_mul[msb*2+rb] (per-msb dup
          //   so src1 stays in seg msb across all Phase 3-4 windows, no toggle vs pk_add)
          set_vgpr_msb(QUIET, v_SP[msb], v_SP[msb], v_p_quant_mul[msb * 2 + rb])
          v_pk_mul_f32 v_8bit(v_SP[msb][rb * 32 + w - 1]), v_8bit(v_SP[msb][rb * 32 + w - 1]), v_8bit(v_p_quant_mul[msb * 2 + rb])
        else
          // even w: pk_add (init or accumulate)
          if w == 0
            if rb == 0
              set_vgpr_msb(QUIET, vp_rb0[msb], v_SP[msb], v_SP[msb])
              v_pk_add_f32 v_8bit(vp_rb0[msb][0]), v_8bit(v_SP[msb][rb * 32 + 0]), v_8bit(v_SP[msb][rb * 32 + 2])
            else
              set_vgpr_msb(QUIET, vp_rb1[msb], v_SP[msb], v_SP[msb])
              v_pk_add_f32 v_8bit(vp_rb1[msb][0]), v_8bit(v_SP[msb][rb * 32 + 0]), v_8bit(v_SP[msb][rb * 32 + 2])
            end
          else
            if w == 2
              if rb == 0
                set_vgpr_msb(QUIET, vp_rb0[msb], v_SP[msb], v_SP[msb])
                v_pk_add_f32 v_8bit(vp_rb0[msb][2]), v_8bit(v_SP[msb][rb * 32 + 4]), v_8bit(v_SP[msb][rb * 32 + 6])
              else
                set_vgpr_msb(QUIET, vp_rb1[msb], v_SP[msb], v_SP[msb])
                v_pk_add_f32 v_8bit(vp_rb1[msb][2]), v_8bit(v_SP[msb][rb * 32 + 4]), v_8bit(v_SP[msb][rb * 32 + 6])
              end
            else
              if w % 4 == 0
                // tmp0/1 += S[w+4, w+5]
                if rb == 0
                  set_vgpr_msb(QUIET, vp_rb0[msb], vp_rb0[msb], v_SP[msb])
                  v_pk_add_f32 v_8bit(vp_rb0[msb][0]), v_8bit(vp_rb0[msb][0]), v_8bit(v_SP[msb][rb * 32 + w + 4])
                else
                  set_vgpr_msb(QUIET, vp_rb1[msb], vp_rb1[msb], v_SP[msb])
                  v_pk_add_f32 v_8bit(vp_rb1[msb][0]), v_8bit(vp_rb1[msb][0]), v_8bit(v_SP[msb][rb * 32 + w + 4])
                end
              else
                // tmp2/3 += S[w+4, w+5]
                if rb == 0
                  set_vgpr_msb(QUIET, vp_rb0[msb], vp_rb0[msb], v_SP[msb])
                  v_pk_add_f32 v_8bit(vp_rb0[msb][2]), v_8bit(vp_rb0[msb][2]), v_8bit(v_SP[msb][rb * 32 + w + 4])
                else
                  set_vgpr_msb(QUIET, vp_rb1[msb], vp_rb1[msb], v_SP[msb])
                  v_pk_add_f32 v_8bit(vp_rb1[msb][2]), v_8bit(vp_rb1[msb][2]), v_8bit(v_SP[msb][rb * 32 + w + 4])
                end
              end
            end
          end
        end
      end
    end
  end

  // ----- Phase 5: combined both rb (exp all done). S[26..31] quant DEFERRED to
  //   msb=3 step (4). 4 groups × 2 rb; the last group (pk_add tmp4/5) reads S31
  //   (last exp) but has 7 indep fillers before its rb1 op → target 0 stall. -----
  // pk_add tmp2/3 += S[26,27]
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, vp_rb0[msb], vp_rb0[msb], v_SP[msb])
        v_pk_add_f32 v_8bit(vp_rb0[msb][2]), v_8bit(vp_rb0[msb][2]), v_8bit(v_SP[msb][rb * 32 + 26])
      else
        set_vgpr_msb(QUIET, vp_rb1[msb], vp_rb1[msb], v_SP[msb])
        v_pk_add_f32 v_8bit(vp_rb1[msb][2]), v_8bit(vp_rb1[msb][2]), v_8bit(v_SP[msb][rb * 32 + 26])
      end
    end
  end
  // pk_mul S[22,23]
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, v_SP[msb], v_SP[msb], v_p_quant_mul[msb * 2 + rb])
      v_pk_mul_f32 v_8bit(v_SP[msb][rb * 32 + 22]), v_8bit(v_SP[msb][rb * 32 + 22]), v_8bit(v_p_quant_mul[msb * 2 + rb])
    end
  end
  // pk_mul S[24,25]
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      set_vgpr_msb(QUIET, v_SP[msb], v_SP[msb], v_p_quant_mul[msb * 2 + rb])
      v_pk_mul_f32 v_8bit(v_SP[msb][rb * 32 + 24]), v_8bit(v_SP[msb][rb * 32 + 24]), v_8bit(v_p_quant_mul[msb * 2 + rb])
    end
  end
  // pk_add tmp4/5 = S[28,29] + S[30,31]
  for var rb in [0:1]
    rlt = valu_rlt(rlt)
    if is_gt_than(rlt, result)
      if rb == 0
        set_vgpr_msb(QUIET, vp_rb0[msb], v_SP[msb], v_SP[msb])
        v_pk_add_f32 v_8bit(vp_rb0[msb][4]), v_8bit(v_SP[msb][rb * 32 + 28]), v_8bit(v_SP[msb][rb * 32 + 30])
      else
        set_vgpr_msb(QUIET, vp_rb1[msb], v_SP[msb], v_SP[msb])
        v_pk_add_f32 v_8bit(vp_rb1[msb][4]), v_8bit(v_SP[msb][rb * 32 + 28]), v_8bit(v_SP[msb][rb * 32 + 30])
      end
    end
  end
  // S[26,27] / S[28,29] / S[30,31] pk_mul (quant) DEFERRED → msb=3 step (4),
  //   interleaved into the 6→1 fold. add-before-mul still holds (their pk_add
  //   above already read P). P_quant FP32 (and these P) stay alive in v_SP[msb]
  //   for cvt (pa_softmax_cvt_msb, separate 2nd pass).

  // -------- (4) msb=3 only: cross-msb fold of per-rb partial sums → v_L[rb] --------
  if msb == 3
    // Cross-msb accumulate: for src_msb in {1,2,3}, accumulate 3 partial pairs
    // into vp_rb*[0][*] for both rb. Tuple groups by src_msb so set_msb fires
    // once per src_msb (covers rb0 and rb1 since vp_rb0[X] and vp_rb1[X] share seg X).
    for var src_msb in [1:3]
      // tmp0/1: vp_rb*[0][0..1] += vp_rb*[src_msb][0..1]   for rb=0 then rb=1
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[src_msb])
        v_pk_add_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[src_msb][0])
      end
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[src_msb])
        v_pk_add_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[src_msb][0])
      end
      // tmp2/3: vp_rb*[0][2..3] += vp_rb*[src_msb][2..3]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[src_msb])
        v_pk_add_f32 v_8bit(vp_rb0[0][2]), v_8bit(vp_rb0[0][2]), v_8bit(vp_rb0[src_msb][2])
      end
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[src_msb])
        v_pk_add_f32 v_8bit(vp_rb1[0][2]), v_8bit(vp_rb1[0][2]), v_8bit(vp_rb1[src_msb][2])
      end
      // tmp4/5: vp_rb*[0][4..5] += vp_rb*[src_msb][4..5]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[src_msb])
        v_pk_add_f32 v_8bit(vp_rb0[0][4]), v_8bit(vp_rb0[0][4]), v_8bit(vp_rb0[src_msb][4])
      end
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[src_msb])
        v_pk_add_f32 v_8bit(vp_rb1[0][4]), v_8bit(vp_rb1[0][4]), v_8bit(vp_rb1[src_msb][4])
      end
    end

    // ----- 6→1 fold within msb0, interleaved with the DEFERRED S[26..31] quant
    //   (24 pk_mul = 6/msb × 4 msb). Each 6-pk_mul block (independent) fills the
    //   RAW gap of the serial fold step that follows it (these gaps were the
    //   msb=3 fold stalls in the old design). add-before-mul holds (the S26..31
    //   pk_add already ran in each msb's Phase 5). Pure reorder → bit-exact. -----

    // group1: vp_rb*[0][0..1] += vp_rb*[0][2..3]
    for var rb in [0:1]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        if rb == 0
          set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0])
          v_pk_add_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][2])
        else
          set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0])
          v_pk_add_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][2])
        end
      end
    end
    // deferred quant msb0: S[26,27]/[28,29]/[30,31] × 2 rb (6 pk_mul)
    for var rb in [0:1]
      for var qoff in [26:2:30]
        rlt = valu_rlt(rlt)
        if is_gt_than(rlt, result)
          set_vgpr_msb(QUIET, v_SP[0], v_SP[0], v_p_quant_mul[0 * 2 + rb])
          v_pk_mul_f32 v_8bit(v_SP[0][rb * 32 + qoff]), v_8bit(v_SP[0][rb * 32 + qoff]), v_8bit(v_p_quant_mul[0 * 2 + rb])
        end
      end
    end

    // group2: vp_rb*[0][0..1] += vp_rb*[0][4..5]
    for var rb in [0:1]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        if rb == 0
          set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0])
          v_pk_add_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][4])
        else
          set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0])
          v_pk_add_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][4])
        end
      end
    end
    // deferred quant msb1
    for var rb in [0:1]
      for var qoff in [26:2:30]
        rlt = valu_rlt(rlt)
        if is_gt_than(rlt, result)
          set_vgpr_msb(QUIET, v_SP[1], v_SP[1], v_p_quant_mul[1 * 2 + rb])
          v_pk_mul_f32 v_8bit(v_SP[1][rb * 32 + qoff]), v_8bit(v_SP[1][rb * 32 + qoff]), v_8bit(v_p_quant_mul[1 * 2 + rb])
        end
      end
    end

    // group3: pair fold vp_rb*[0][0] = vp_rb*[0][0] + vp_rb*[0][1]   (scalar)
    for var rb in [0:1]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        if rb == 0
          set_vgpr_msb(QUIET, vp_rb0[0], vp_rb0[0], vp_rb0[0])
          v_add_f32 v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][0]), v_8bit(vp_rb0[0][1])
        else
          set_vgpr_msb(QUIET, vp_rb1[0], vp_rb1[0], vp_rb1[0])
          v_add_f32 v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][0]), v_8bit(vp_rb1[0][1])
        end
      end
    end
    // deferred quant msb2
    for var rb in [0:1]
      for var qoff in [26:2:30]
        rlt = valu_rlt(rlt)
        if is_gt_than(rlt, result)
          set_vgpr_msb(QUIET, v_SP[2], v_SP[2], v_p_quant_mul[2 * 2 + rb])
          v_pk_mul_f32 v_8bit(v_SP[2][rb * 32 + qoff]), v_8bit(v_SP[2][rb * 32 + qoff]), v_8bit(v_p_quant_mul[2 * 2 + rb])
        end
      end
    end

    // group4: v_L[rb] += scalar partial   (L already rescaled by delta_max in prep)
    for var rb in [0:1]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        if rb == 0
          set_vgpr_msb(QUIET, v_L[rb], v_L[rb], vp_rb0[0])
          v_add_f32 v_8bit(v_L[rb]), v_8bit(v_L[rb]), v_8bit(vp_rb0[0][0])
        else
          set_vgpr_msb(QUIET, v_L[rb], v_L[rb], vp_rb1[0])
          v_add_f32 v_8bit(v_L[rb]), v_8bit(v_L[rb]), v_8bit(vp_rb1[0][0])
        end
      end
    end
    // deferred quant msb3
    for var rb in [0:1]
      for var qoff in [26:2:30]
        rlt = valu_rlt(rlt)
        if is_gt_than(rlt, result)
          set_vgpr_msb(QUIET, v_SP[3], v_SP[3], v_p_quant_mul[3 * 2 + rb])
          v_pk_mul_f32 v_8bit(v_SP[3][rb * 32 + qoff]), v_8bit(v_SP[3][rb * 32 + qoff]), v_8bit(v_p_quant_mul[3 * 2 + rb])
        end
      end
    end
  end  // if msb == 3

  return mark_inst_finished(rlt)
end

// ----------------------------------------------------------------------------
// pa_softmax_cvt_msb(msb): cvt one S msb's BOTH row-bands (64 FP32 → 16 FP8) to
// the 2-seg P layout, interleaving rb0/rb1 to hide the sel_lo/sel_hi RMW dep.
//
// dst = v_SP[msb/2][rb*32 + (msb%2)*8 + i/4]  (seg = k_batch; rb0→[0..15],
//   rb1→[32..47]). rb0/rb1 share the dst seg, so both row-bands interleave in
//   one call with NO set_vgpr_msb toggle (all 32 cvt share dst=seg msb/2,
//   src=seg msb).
//
// Order: 4 phases × 8 = (A-lo, A-hi, B-lo, B-hi); each phase does rb0 then rb1
//   over its 4 i's. A={0,4,16,20} (dst regs 0,1,4,5), B={8,12,24,28} (dst regs
//   2,3,6,7). Each dst's lo and hi end up 8 ops apart → ~4-cyc RMW fully hidden.
//
// WAR (msb=0 only, same-seg seg0; msb=1/2/3 cross-seg, no WAR): A reads the
//   overlap src s0-7 early (i=0 rd s0-3, i=4 rd s4-7); B writes dst regs 2,3,6,7
//   = src s2,3,6,7, and runs only after the A-hi reads of s2,3,6,7. rb1 (src
//   s32-63 / dst s32-39) is symmetric. Verified WAR-safe.
//
// Caller: msb ASCENDING. cross-block WAR: cvt_msb(1) writes seg0 = cvt_msb(0)'s
//   src; cvt_msb(2)/(3) write seg1 = cvt_msb(1)'s src. Ascending msb covers it
//   (no rb-outer / 2-pass needed).
// ----------------------------------------------------------------------------
function pa_softmax_cvt_msb(param msb, param result[])
  var rlt = set_inst_user_data(START_RESULT, get_inst_user_data(result))
  var ALL_I = [0, 4, 16, 20, 8, 12, 24, 28]   // [0:3]=group A, [4:7]=group B
  for var g in [0:1]            // A (overlap-early) then B (overwrite-late)
    for var h in [0:1]          // lo batch then hi batch
      for var rb in [0:1]
        for var gi in [0:3]
          var i = ALL_I[g * 4 + gi]
          rlt = valu_rlt(rlt)
          if is_gt_than(rlt, result)
            set_vgpr_msb(QUIET, v_SP[msb / 2], v_SP[msb], v_SP[msb])
            if h == 0
              v_cvt_pk_fp8_f32 sel_lo(v_8bit(v_SP[msb / 2][rb * 32 + (msb % 2) * 8 + i / 4])), v_8bit(v_SP[msb][rb * 32 + i]), v_8bit(v_SP[msb][rb * 32 + i + 1])
            else
              v_cvt_pk_fp8_f32 sel_hi(v_8bit(v_SP[msb / 2][rb * 32 + (msb % 2) * 8 + i / 4])), v_8bit(v_SP[msb][rb * 32 + i + 2]), v_8bit(v_SP[msb][rb * 32 + i + 3])
            end
          end
        end
      end
    end
  end
  return mark_inst_finished(rlt)
end

// ============================================================================
// Section 16: Border Masking (MTP + CAUSAL)
// ============================================================================
// Per-row border values support three cases:
//   1. Non-causal, mtp=0:   all valid rows see border = seq_len
//   2. Non-causal, mtp>0:   all valid rows see border = seq_len
//   3. Causal,     mtp>=0:  row r sees border = (seq_len - mtp) + (r / gqa_ratio)
//                           where row index r = (l & 0xf) + m_tile * 16
// Invalid rows (r >= (mtp+1)*gqa_ratio) always get border = 0 → SP = -INF.
//
// GQA_RATIO is assumed to be 8 (compile-time constant). r / gqa_ratio = r >> 3.
//
// v_mask_border[m] is computed once in setup_mask_border() and holds per-lane
// border value for the row owned by that lane in M-tile m.

function setup_mask_border
  // Compute s_valid_rows = (mtp + 1) * gqa_ratio
  s_add_u32       s_tmp0, s_mtp, 1
  s_mul_i32       s_valid_rows, s_tmp0, s_gqa_ratio

if CAUSAL
  // ---- Causal path: border[r] = max(0, seq_len - mtp + (r / 8)) clamped to seq_len,
  //                   zeroed for r >= valid_rows ----
  s_sub_u32       s_tmp0, s_seq_len, s_mtp            // base = seq_len - mtp
  for var m in [0:G1_M_TILES - 1]
    // DST must be v_tmp0 (seg 0) for the next three ALU ops  // earlier the
    // call passed v_mask_border[m] as dst, which for m==1 put DST MSB=1 and
    // made the writes land in seg 1 instead of seg 0.
    set_vgpr_msb(QUIET, v_tmp0, v0)
    // row r = (l & 0xf) + m * 16
    v_and_b32       v_tmp0, v0, 0xf
    if m > 0
      v_add_nc_u32  v_tmp0, v_tmp0, m * 16
    end
    // mtp_token = r >> 3 (assumes GQA_RATIO = 8)
    v_lshrrev_b32   v_tmp1, 3, v_tmp0
    // border = base + mtp_token. v_tmp1 is SRC1 here (SGPR is SRC0).
    set_vgpr_msb(QUIET, v_mask_border[m], v0, v_tmp1)
    v_add_nc_u32    v_8bit(v_mask_border[m]), s_tmp0, v_tmp1
    // Clamp to this work's exclusive token end (and therefore to seq_len).
    set_vgpr_msb(QUIET, v_mask_border[m], v_mask_border[m])
    v_min_i32       v_8bit(v_mask_border[m]), v_8bit(v_mask_border[m]), s_KV_work_end_token
    // Invalid rows -> border = work_end (NOT 0).
    // Q for invalid rows has been zeroed in Q_global_load, so S = Q@K = 0.
    // Using border=seq_len keeps those lanes unmasked, so softmax sees finite
    // S=0 values instead of -INF. This avoids 0*(-INF)=NaN in
    // v_pk_fma_f32(scl_log2e, S, -max) when scl_log2e[m]=0 for inactive M-tile.
    // D stays 0 (Q=0 ⇒ S=0 ⇒ P uniform ⇒ D accumulates 0*V = 0), final output
    // for inactive rows is still 0 (via scl_log2e=0 path / zeroed Q).
    set_vgpr_msb(QUIET, v0, v_tmp0)
    v_cmp_lt_u32    vcc, v_tmp0, s_valid_rows
    // v_cndmask_b32 dst, sgpr, vgpr, vcc -> DST=mask_border, SRC0=sgpr,
    //   SRC1=mask_border (seg m). Put mask_border in SRC1 slot explicitly.
    set_vgpr_msb(QUIET, v_mask_border[m], v0, v_mask_border[m])
    v_cndmask_b32   v_8bit(v_mask_border[m]), s_KV_work_end_token, v_8bit(v_mask_border[m]), vcc
  end
else
  // ---- Non-causal path: border[r] = work_end for all rows (valid or invalid).
  // Invalid rows have Q=0 ⇒ S=0  // leaving them unmasked avoids 0*(-INF)=NaN.
  // Inactive M-tile's scl_log2e=0 forces the FMA output to 0 regardless,
  // and the zeroed Q path keeps D=0 for those rows. ----
  for var m in [0:G1_M_TILES - 1]
    set_vgpr_msb(QUIET, v_mask_border[m])
    v_mov_b32     v_8bit(v_mask_border[m]), s_KV_work_end_token
  end
end
end

// Apply per-row border mask to SP buffer using current wave's kv page offset.
//   Global token idx for value at v_SP[sp_msb][m*32 + n_sub*8 + v]:
//     token = s_kv_cur_offset + sp_msb*64 + n_sub*INST_N + (l>>4)*8 + v
//   Compared against per-row border v_mask_border[m]  // OOB lanes → -INF.
// Called every unified core-loop iteration so CAUSAL/partial/OOB pages are
// handled uniformly.
function pa_border_mask
  // OPT-E: most decode pages are fully before every row's border. In that
  // common case the whole 256-token page needs no element mask, so skip the
  // 4*2*4*8 cmp/cndmask body. Tail/causal-partial/OOB pages still take the
  // original path below.
  s_add_i32 s_tmp0, s_kv_cur_offset, PAGE_SIZE
if CAUSAL
  s_sub_u32 s_tmp1, s_seq_len, s_mtp
  s_min_i32 s_tmp1, s_tmp1, s_KV_work_end_token
else
  s_mov_b32 s_tmp1, s_KV_work_end_token
end
  // If min_border >= page_end, all tokens in this page are valid for all rows.
  // SIGNED: min_border = seq_len - mtp + (r/8) can be NEGATIVE when seq_len < mtp
  // (e.g. seq_len=1, mtp=2 → -1). An unsigned compare reads -1 as 0xFFFFFFFF and
  // wrongly skips ALL masking → early-MTP rows that should be fully masked keep
  // real scores (L != 0, never zeroed). Border is built with signed min_i32.
  s_cmp_lt_i32 s_tmp1, s_tmp0
  s_cbranch_scc0 pa_border_mask_done

  for var sp_msb in [0:NUM_MSB_SEGMENTS - 1]
    // v_tmp0 = s_kv_cur_offset + sp_msb*64 + (l >> 4)*8
    // v_lshrrev_b32 dst, imm, vsrc uses vsrc in SRC1  // set both literal and
    // vsrc slots to segment 0 so stale MSB state cannot redirect v0 to v256.
    set_vgpr_msb(QUIET, v_tmp0, v0, v0)
    v_lshrrev_b32 v_tmp0, 4, v0
    set_vgpr_msb(QUIET, v_tmp0, v0, v_tmp0)
    v_lshlrev_b32 v_tmp0, 3, v_tmp0
    set_vgpr_msb(QUIET, v_tmp0, v0, v_tmp0)
    v_add_nc_u32  v_tmp0, s_kv_cur_offset, v_tmp0
    if sp_msb > 0
      set_vgpr_msb(QUIET, v_tmp0, v_tmp0)
      v_add_nc_u32 v_tmp0, v_tmp0, sp_msb * 64
    end

    for var m in [0:G1_M_TILES - 1]
      for var n_sub in [0:3]          // 4 N-sub-tiles within this msb
        for var v in [0:7]            // 8 f32 VGPR per 16x16 output tile
          var sp_idx = m * 32 + n_sub * 8 + v
          var static_offset = n_sub * INST_N + v

          set_vgpr_msb(QUIET, v_tmp1, v_tmp0)
          v_add_nc_u32 v_tmp1, v_tmp0, static_offset

          // v_cmp_lt_i32 has SRC0=v_tmp1, SRC1=v_mask_border[m].
          // Pass them in matching positions so SRC1 MSB tracks v_mask_border
          // (lives in seg 0 for m=0, seg 1 for m=1).
          // SIGNED: v_mask_border[m] can be NEGATIVE for early-MTP rows when
          // seq_len < mtp (token_idx >= 0, so signed token < negative border is
          // false → correctly masked). Unsigned would mis-keep those rows.
          set_vgpr_msb(QUIET, v0, v_tmp1, v_mask_border[m])
          v_cmp_lt_i32 vcc, v_tmp1, v_8bit(v_mask_border[m])

          set_vgpr_msb(QUIET, v_SP[sp_msb], v_NEG_INF, v_SP[sp_msb])
          v_cndmask_b32 v_8bit(v_SP[sp_msb][sp_idx]), v_8bit(v_NEG_INF), v_8bit(v_SP[sp_msb][sp_idx]), vcc
        end
      end
    end
  end
pa_border_mask_done:
end

// ============================================================================
// VMASK: zero V entries whose token index >= s_seq_len (kv_seq_len padding).
// ============================================================================
// When kv_seq_len is not a multiple of PAGE_SIZE the last KV page holds
// uninitialized V bytes for tokens [seq_len, page_end). The score border mask
// already drives P=0 for those tokens, but a stale fp8-NaN V byte makes the PV
// WMMA compute 0*NaN = NaN, which cross_wave_reduce then spreads across the
// whole row (same failure class as the VOOBLOAD note in V_TDM_load_half).
// Zeroing the OOB V bytes makes the masked PV a clean 0. Mirrors apply_V_mask
// in PA_A16W8_BLK1024_1TG_8W_48mx1_64nx4_MTP_PS_PB.sp3 (adapted to this
// kernel's wave32 16x16x128 V WMMA-A layout).
//
// V WMMA-A operand layout (see V_LDS_rd_addr_gen / pa_gemm_pv):
//   lane = {K[3], M[3:0]}, vgpr = {K[6], K[5], K[4], K[2]}, byte = K[1:0]
//   For v_V[msb][k_batch*16 + j], lane l, byte b the global token is
//     tok = s_kv_cur_offset + k_batch*128
//         + 64*((j>>3)&1) + 32*((j>>2)&1) + 16*((j>>1)&1) + 4*(j&1)  // vgpr bits
//         + 8*(l>>4)                                                  // K[3]=lane[4]
//         + b                                                         // K[1:0]
//   The 4 bytes of one vgpr are 4 consecutive tokens, so a per-vgpr byte mask
//   keeps the low (seq_len - tok_base) bytes, exactly like the score tail mask.
//   msb selects only the HeadDim group, so the same token mask applies to all 4.
function apply_V_mask
  // OPT: skip when the whole page is < seq_len (no padding tokens this page).
  // SIGNED compare: s_kv_cur_offset and s_seq_len share the batch-token domain.
  s_add_i32    s_tmp0, s_kv_cur_offset, PAGE_SIZE
  s_cmp_ge_i32 s_seq_len, s_tmp0
  s_cbranch_scc1 apply_V_mask_done

  // Scalar base = s_kv_cur_offset - s_seq_len + 4. Adding the per-vgpr static
  // token offset below yields (tok_base + 4 - seq_len) for the byte-mask trick.
  s_sub_i32 s_tmp1, s_kv_cur_offset, s_seq_len
  s_add_i32 s_tmp1, s_tmp1, 4

  // Per-lane: v_tmp0 = s_tmp1 + 8*lane[4]   (lane[4] = v0>>4 selects K[3])
  set_vgpr_msb(QUIET, v_tmp1, v0, v0)
  v_lshrrev_b32 v_tmp1, 4, v0
  set_vgpr_msb(QUIET, v_tmp1, v0, v_tmp1)
  v_lshlrev_b32 v_tmp1, 3, v_tmp1
  set_vgpr_msb(QUIET, v_tmp0, v0, v_tmp1)
  v_add_nc_u32  v_tmp0, s_tmp1, v_tmp1

  for var k_batch in [0:1]
    for var j in [0:KV_VGPR_PER_MSB / 2 - 1]      // j = 0..15 (vgpr within batch)
      var base_wb    = 64 * ((j >> 3) & 1) + 32 * ((j >> 2) & 1) \
                     + 16 * ((j >> 1) & 1) + 4 * (j & 1)
      var static_off = k_batch * 128 + base_wb
      var idx        = k_batch * 16 + j

      // v_tmp1 = tok_base + 4 - seq_len   // vcc = (>=1 valid byte in this vgpr).
      set_vgpr_msb(QUIET, v_tmp1, v_tmp0)
      v_add_nc_i32  v_tmp1, v_tmp0, static_off
      set_vgpr_msb(QUIET, v0, v_tmp1, v0)
      v_cmp_lt_i32  vcc, v_tmp1, 4
      // byte-mask = 0xffffffff >> (min_u32(4, v_tmp1) * 8): keeps the low valid
      // bytes. min_u32 maps fully-valid (v_tmp1<0 → huge unsigned) to 4 → the
      // <<3=32 shift wraps mod 32 to 0 → mask 0xffffffff (keep all).
      set_vgpr_msb(QUIET, v_tmp1, v0, v_tmp1)
      v_min_u32     v_tmp1, 4, v_tmp1
      v_lshlrev_b32 v_tmp1, 3, v_tmp1
      set_vgpr_msb(QUIET, v_tmp2, v_tmp1, v0)
      v_lshrrev_b32 v_tmp2, v_tmp1, 0xffffffff

      for var msb in [0:NUM_MSB_SEGMENTS - 1]
        // Fully-OOB vgprs (vcc==0) -> 0  // partial vgprs keep low bytes via AND.
        set_vgpr_msb(QUIET, v_V[msb], v0, v_V[msb])
        v_cndmask_b32 v_8bit(v_V[msb][idx]), 0, v_8bit(v_V[msb][idx]), vcc
        set_vgpr_msb(QUIET, v_V[msb], v_V[msb], v_tmp2)
        v_and_b32     v_8bit(v_V[msb][idx]), v_8bit(v_V[msb][idx]), v_tmp2
      end
    end
  end
  // The V-mask VALU writes must retire before the PV WMMA reads v_V. Only the
  // non-skipped (padding) path needs this; full pages branch over it above.
  s_wait_alu { va_vdst: 0 }
apply_V_mask_done:
end

// Shuffle FP8 P from softmax-quant layout to GEMM_PV-contiguous layout.
//
// After softmax-quant, for each (sp_msb, m_tile) the 8 FP8 VGPRs occupying
// v_SP[sp_msb][m*8 .. m*8+7] hold 32 cols (a 128-token N-sub-group of one
// m-tile). We need 16 contiguous FP8 VGPRs per (m_tile, k_batch) in ONE
// segment for the 16x16x128 WMMA B operand. Since k_batch 0 spans sp_msb
// 0 and 1 (tokens 0..127), and k_batch 1 spans sp_msb 2 and 3 (tokens
// 128..255), the shuffle is a pure cross-segment VGPR copy (lane-preserving,
// no LDS required):
//   v_SP[2*m + k][P_SHUFFLE_OFFSET + src_j*8 + v] <-
//     v_SP[2*k + src_j][m*8 + v]       for m,k,src_j in {0,1}, v in 0..7
// Source offsets 0..15 and dst offsets 16..31 never overlap, so the copy is
// safe even when src_msb == dst_msb.
function pa_shuffle_P
  for var m in [0:G2_M_TILES - 1]
    for var k in [0:1]
      var dst_msb = 2 * m + k
      for var src_j in [0:1]
        var src_msb = 2 * k + src_j
        for var v in [0:7]
          set_vgpr_msb(QUIET, v_SP[dst_msb], v_SP[src_msb])
          v_mov_b32 v_8bit(v_SP[dst_msb][P_SHUFFLE_OFFSET + src_j * 8 + v]), \
                    v_8bit(v_SP[src_msb][m * 8 + v])
        end
      end
    end
  end
end

// Zero the per-iteration PV accumulator v_R_iter.
// Must be called BEFORE every pa_gemm_pv() since WMMA accumulates onto its
// destination. v_R_iter layout mirrors v_R (4 msb × R_VGPR_SECT_SIZE).
function pa_zero_R_iter
  for var r_msb in [0:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_R_iter[r_msb])
    for var i in [0:2:R_VGPR_SECT_SIZE - 1]
      v_mov_b32 v_8bit(v_R_iter[r_msb][i]), 0
      v_mov_b32 v_8bit(v_R_iter[r_msb][i + 1]), 0
    end
  end
end

// Fold per-iteration v_R_iter into the global v_R with per-M-tile dynamic
// P-quant inverse scale:  v_R[m] += v_ScaleS[m] * v_R_iter[m].
// Issued via issue_all so the framework inserts WMMA->VALU wait counters.
// r_msb → m-tile mapping: msb 0,1 → m=0  // msb 2,3 → m=1 (same as pa_gemm_pv).
function pa_fold_R_iter(param result[])
  var rlt = START_RESULT
  for var r_msb in [0:VGPR_SEG_NUM - 1]
    var m = r_msb / (VGPR_SEG_NUM / G1_M_TILES)   // 0 or 1
    for var i in [0:2:R_VGPR_SECT_SIZE - 1]
      rlt = valu_rlt(rlt)
      if is_gt_than(rlt, result)
        set_vgpr_msb(QUIET, v_R[r_msb], v_R_iter[r_msb], v_ScaleS[m], v_R[r_msb])
        v_pk_fma_f32 v_8bit(v_R[r_msb][i]), v_8bit(v_R_iter[r_msb][i]), v_8bit(v_ScaleS[m]), v_8bit(v_R[r_msb][i])
      end
    end
  end
  return mark_inst_finished(rlt)
end

// ============================================================================
// Section 17: Initial Data Loading
// ============================================================================

function load_initial_data
  // DBLPRE: init fills BOTH buf 0 AND buf 1 for K and V. Buf 0 is consumed by
  // iter 0, buf 1 by iter 1. This raises the per-loader-wave inflight TDM
  // depth from 1 K_TDM_load_half (32 KB) to 2 (64 KB), matching the full LDS
  // ping-pong budget. Steady-state pipeline: each iter consumes buf_idx and
  // re-prefetches K_TDM_load_half(buf_idx) for iter N+2, keeping 4 TDMs
  // (= 64 KB) inflight per K-loader wave through the K wait at gemm_qk_phase
  // start. Same shape for V.
  //
  // The K/V waits below use s_wait_tensorcnt 2 to drain only the buf-0 pair
  // (FIFO)  // the buf-1 pair stays inflight and is drained at iter 0's
  // gemm_pv_phase KHOIST (K) / iter 1's gemm_pv_phase V wait.
  // OPT-H: independent V LDS address + mask-border setup runs while the
  // initial TDMs are in flight to shorten the first wait window.

  // ===== UNILOAD (Opt-40) + BTMERGE (Opt-42): all 4 waves fill K+V buf 0+1 =====
  // Per-wave issue order: K_b0, V_b0, K_b1, V_b1 (= 4 TDMs inflight per wave).
  // K_TDM_load_half internally copies s_V_phys_blk_idx for the following V.

  // BTEARLY: the first K_TDM_lookup_issue() was hoisted to the main prologue
  // (before Q_compute_addr) so its kmcnt overlaps Q setup. s_phys_blk_idx /
  // s_tdm_page_aux are already valid here; s_loader_base_page is unchanged
  // since the hoist point, so K_TDM_load_half(0) consumes the correct page.
  K_TDM_load_half(0)
  V_TDM_load_half(0)
  s_add_i32 s_loader_base_page, s_loader_base_page, WAVES

  K_TDM_lookup_issue()
  K_TDM_load_half(1)
  V_TDM_load_half(1)
  s_add_i32 s_loader_base_page, s_loader_base_page, WAVES

  // BTPF-HOIST-PV-K (Opt-29): seed K BT lookup for iter 0's qk_phase K_TDM
  // consumer. s_loader_base_page now = iter 2's K page (DBLPRE + 2 advances).
  K_TDM_lookup_issue()

  // These do not consume K/V LDS contents  // they only prepare VGPR/SGPR state
  // used later by V_LDS_load and pa_border_mask. Run them while initial TDM is
  // in flight to shorten the first s_wait_tensorcnt.
  V_LDS_rd_addr_gen()
  setup_mask_border()

  // VINIT-PAR (Opt-23): K-loader waves (0/1) hold only K TDMs outstanding,
  // V-loader waves (2/3) hold only V TDMs outstanding (each wave's tensorcnt
  // is private). A single unconditional s_wait_tensorcnt 2 therefore drains
  // each wave's own buf-0 pair in parallel — K loaders and V loaders no
  // longer serialize their ~2900 cyc cold-TDM waits. The single barrier
  // publishes both K buf 0 AND V buf 0 cross-wave at once, replacing the
  // baseline's two barriers.
  //
  // DBLPRE preserved: tensorcnt=2 drains the older (buf 0) pair while
  // leaving the buf 1 pair inflight for iter 0's pv_phase KHOIST (K) and
  // iter 1's pv_phase V wait (V). Measured savings vs. baseline (att_dump
  // b64_new vs b64_red_branch, wave 0): −1508 cyc on the init wait site
  // (5794 → 4286 cyc).
  s_wait_tensorcnt 2
  wgp_barrier()

  // QOVL-DEFER-FIX: Q_global_load_finalize MUST run BEFORE the K_LDS_load
  // loop below. Q_global_load_issue staged raw Q HBM into v_K[0][0..15] and
  // the cndmask in _finalize reads it to produce v_Q. K_LDS_load(msb=0, 0)
  // would overwrite all of v_K[0][0..31] from LDS, destroying the Q staging
  // and corrupting v_Q (→ wrong S, wrong LSE, wrong O). Original comment
  // "K TDMs land in LDS not VGPRs" missed that K_LDS_load IS a VGPR write.
  // Running _finalize here still gives Q HBM full overlap with the
  // wait_tensorcnt 2 + barrier above (the dominant cold-TDM window).
  Q_global_load_finalize()

  // Preload K buf 0 for the first QK. Later iterations preload their K
  // buffer at the END of the previous iter's gemm_pv_phase (KHOIST), so the
  // K LDS retire latency overlaps the next iter's qk_phase prologue. After
  // VINIT-PAR the barrier already published V buf 0 too, so iter 0's
  // qk_phase V_LDS_load(0) is safe without an extra barrier.
  for var msb in [0:NUM_MSB_SEGMENTS - 1]
    K_LDS_load(msb, 0)
  end
  // OPT-C: s_wait_dscnt 0 here remains redundant — gemm_qk_phase drains
  // dscnt before consuming v_K in WMMA QK.
end

// ============================================================================
// Section 18: Core Loop (Software Pipelined)
// ============================================================================
// Per-iteration structure (processes one buffer-half = 1024 tokens across 4 waves):
//
//   1. GEMM_QK phase: wait current K TDM (issued by prev iter), current K
//      LDS->VGPR, next K TDM prefetch, QK, wait current V TDM (issued by
//      prev iter), current V LDS->VGPR
//   2. Mask, softmax, P shuffle
//   3. Zero PV accumulator
//   4. GEMM_PV phase: next V TDM prefetch, PV
//   5. Fold PV result into accumulated output
//
// KHOIST: K wait + K_LDS_load live at the prior iter's gemm_pv_phase tail
// (one iter earlier than KDEFER). The K LDS retire latency (~1500 cyc) now
// overlaps the remainder of pa_fold_R_iter + the next iter's qk_phase
// prologue, fenced by an s_wait_dscnt 0 at the top of pa_gemm_qk's drain
// site. Iter 0's K is staged by load_initial_data.
// VINPV: V TDM issued in gemm_pv_phase by V-loader waves (2/3)  // K TDM issued
// in gemm_qk_phase by K-loader waves (0/1).
// DBLPRE: load_initial_data preloads BOTH buf 0 + buf 1  // each iter's K/V
// prefetch targets buf_idx (consumed by iter N+2). Steady-state per-loader-
// wave inflight = 4 TDMs (= 64 KB). K wait / V wait use s_wait_tensorcnt 2
// to drain the older pair while keeping the newer pair inflight.

function gemm_qk_phase(param buf_idx, param next_buf_idx, param do_prefetch, param is_last)
  // BTPF-HOIST-PV-K (Opt-29): K_TDM_lookup_issue moved from here to the prior
  // pv_phase tail (load_initial_data tail for iter 0). At that earlier site
  // the kmcnt drain inside K_TDM_load_half overlaps the full pv_phase tail +
  // pa_fold_R_iter + next qk_phase prologue. Under SYMPIPE the K_TDM_load_half
  // consumer also moved later (to qk_phase tail post-pa_gemm_qk), giving the
  // BT lookup even more cover.

  // BTMERGE (Opt-42): V BT lookup eliminated — V reuses K's lookup result
  // (s_V_phys_blk_idx is copied inside K_TDM_load_half).

  // SYMPIPE (Opt-32): V tensorcnt wait + dedicated V barrier — moved here from
  // pv_phase entry (partial revert of Opt-9 VWAIT-HOIST and Opt-25 KMERGE
  // barrier fuse). V wait drains iter N-2's V TDM (= the V LDS buf this iter
  // will consume in pv_phase). Drain hide window now = V_LDS_load issue +
  // K_LDS_permute + pa_gemm_qk + K_TDM_load_half + masking/softmax/zero_R +
  // pv entry compute, instead of pv_phase head alone under VWAIT-HOIST.
  //
  // VLDS-DEFER (Opt-37): V_LDS_load moved from here to pv_phase head (right
  // after K barrier, before pa_gemm_pv consumer). v_V is read ONLY by
  // pa_gemm_pv (not pa_gemm_qk which reads v_K), so V_LDS_load is
  // structurally deferrable. With the deferral, the natural-retire window
  // between this V wait and the relocated V_LDS_load is
  //   pa_gemm_qk + masking + softmax + pa_zero_R + K wait + K barrier
  //   (~several thousand cyc), large enough for iter N-2's V_TDM to retire
  // by itself. So wait_tensorcnt 2 (matching K wait) becomes safe — no
  // longer needs to actively drain iter N-2's V_TDM the way wait 1 did
  // under SYMPIPE-LDSCOH. Collapses V barrier stall ~1,545→~11 cyc/hit.
  //
  // UNILOAD: every wave has K+V TDMs inflight. Per-wave issue order under
  // UNILOAD is K, V, K, V, ... — iter N qk-head sees 2N+4 issues (init 4 +
  // 2 per prior iter). wait_tensorcnt 2 drains through index 2N+1 (= iter N-2's
  // V from prior pv-tail), guaranteeing V buf_idx is in LDS for pv-head's
  // V_LDS_load while keeping the newer K+V pair inflight.
  s_wait_tensorcnt 2

  // Dedicated V barrier marks the V-loader rendezvous point; V_LDS_load is
  // deferred to pv_phase head under VLDS-DEFER.

  // Current KV absolute byte/token offset for per-row border mask.
  s_sub_i32  s_kv_cur_offset, s_page_idx, s_KV_batch_start
  s_lshl_b32 s_kv_cur_offset, s_kv_cur_offset, PAGE_SIZE_LOG2

  // VLDS-REHOIST (Opt-41): v_V is read ONLY by pa_gemm_pv, so V_LDS issue has
  // no RAW with qk WMMAs. Drain at pv-head's s_wait_dscnt 0.
  //
  // UNIDS (Opt-52): pure per-WMMA uniform distribution. 64 V b64 spread
  // 2 b64/WMMA across all 32 qk WMMAs (was: 32 upfront msb 0,1 + 32
  // distributed msb 2,3 across WMMAs 4..11 under VDS3). Goal: smaller
  // in-flight ds_load count at pv-head dscnt 0 (HEAD top stall).
  // Mapping w in 0..31:
  //   msb_v   = w / 8                 // 0..3
  //   k_batch = (w % 8) / 4           // 0..1
  //   jp_base = (w % 4) * 2           // 0,2,4,6  (2 consecutive jp per WMMA)
  //
  // DSCNT-OVERLAP (Opt): V addr-gen is independent of the prior-pv K loads
  // drained by the s_wait_dscnt 0 below, so hoist it ABOVE the drain. Its 4
  // v_add latencies (and the va_vdst settle) now overlap the ds_load_b64
  // retire instead of serializing after it — the drain hide window absorbs
  // the addr-gen for free.
  for var msb in [0:NUM_MSB_SEGMENTS - 1]
    V_LDS_addr_setup(msb, buf_idx)
  end

  // Drain prior pv_phase's K_LDS_ds_issue (or load_initial_data's K_LDS_load
  // on iter 0) so pa_gemm_qk below safely reads v_K. The drain is now
  // overlapped by the hoisted V addr-gen above; explicit drain still required
  // since natural distance does not fully cover ds_load_b64 retire.
  s_wait_dscnt 0
  s_wait_alu { va_vdst: 0 }

  // LDSB64-CO: K data already in WMMA-A layout from ds_load_b64 (no permute).

  var qk_rlt = START_RESULT
  for var w in [0:31]
    qk_rlt = issue_n(#pa_gemm_qk(), 1, qk_rlt)
    var msb_v   = w / 8
    var k_batch = (w % 8) / 4
    var jp_base = (w % 4) * 2
    var addr_idx = msb_v * 2 + buf_idx
    for var jp_off in [0:1]
      var jp  = jp_base + jp_off
      var j   = jp * 2
      var idx = k_batch * 16 + j
      var k6  = (j / 8) % 2
      var k5  = (j / 4) % 2
      var k4  = (j / 2) % 2
      var offset = k_batch * 8 * V_TILE_DIM0 \
                 + k6 * 4 * V_TILE_DIM0 \
                 + k5 * 2 * V_TILE_DIM0 \
                 + k4 * V_TILE_DIM0 \
                 + msb_v * V_DIM_PER_MSB * 16
      set_vgpr_msb(QUIET, v_V[msb_v], v_V_LDS_issue_addr)
      ds_load_b64 v_8bit(v_V[msb_v][idx]), v_V_LDS_issue_addr[addr_idx] offset: offset
    end
    // MSB-CO: s_set_vgpr_msb cannot co-execute with ds_load. The ds_load_b64
    // above are followed at the next w by pa_gemm_qk's s_set_vgpr_msb (QK
    // operands). Break that ds_load -> s_set_msb adjacency with a VALU so the
    // set_msb starts a fresh co-issue group.
    v_nop
  end
  issue_all(#pa_gemm_qk(), qk_rlt)

  // SYMPIPE: K_TDM_load_half(buf_idx) moved to AFTER pa_gemm_qk (was before).
  // K TDM cold latency hide = pa_border_mask + softmax + pa_zero_R + pv_phase
  // head + K_LDS_addr_setup + HYBRID body + pa_gemm_pv + pv tail + pa_fold_R
  // + next iter qk head up to its V wait. K_TDM_load_half's internal
  // s_wait_kmcnt 0 (for the BT data) no longer stalls pa_gemm_qk entry.
  // K_TDM target = buf_idx (= LDS slot just consumed by THIS iter's K reads;
  // refilled here for iter N+2). WAR-safe: TDM cold latency >> dscnt drain
  // for any outstanding K ds_loads.
  if do_prefetch && !is_last
    // UNILOAD: all 4 waves issue K_TDM here. Page advance moved to pv_tail so
    // K and V loads within an iter target the same page.
    K_TDM_load_half(buf_idx)
    // VTDM-MID (Opt-55A): V TDM deferred to after pa_border_mask() in
    // core_loop_iteration. K TDM alone occupies the TDM pipe during masking,
    // then V TDM starts after masking. This avoids LDS write bandwidth
    // contention (8 concurrent TDMs → 4) while still giving V TDM a hide
    // window of softmax + shuffle_P + pa_zero_R + pv_phase (~2500-3500 cyc).
  end
end

function gemm_pv_phase(param buf_idx, param next_buf_idx, param do_prefetch, param is_last)
  // BTPF-VE: V block-table scalar loads issued at qk_phase head.
  // BTPF-HOIST-PV-K: K block-table scalar loads issued at THIS phase's tail
  // (consumed by next iter's qk_phase K_TDM_load_half after pa_gemm_qk).

  // SYMPIPE (Opt-32): K tensorcnt wait + dedicated K barrier (separate from
  // the V barrier now at qk_phase entry — reverts Opt-25 KMERGE barrier fuse).
  // K wait drains iter N-2's K TDM via FIFO  // K LDS buf next_buf_idx (which
  // K_LDS_ds_issue below reads) was loaded by iter N-1's qk_phase K TDM,
  // naturally drained by the time we reach K_LDS_ds_issue (it's not what this
  // wait targets — this wait just keeps inflight bounded). Drain hide window
  // = K_LDS_addr_setup + HYBRID body + pa_gemm_pv + pv tail.
  //
  // Per-wave tensorcnt semantics: K-loaders (waves 0/1) only have K TDMs
  // outstanding so this wait is a no-op for V-loaders  // V-loaders still hit
  // the barrier so all 4 waves rendezvous.
  //
  // Iter 0: skip the whole entry block (load_initial_data already preloaded
  // K buf 0+1 + staged v_K and published via VINIT-PAR barrier).
  // PEELAST: !is_last gates everything (no next qk_phase needs K).
  if !is_last
    // Iter 0: skip — load_initial_data already preloaded K buf 0+1 and the
    // VINIT-PAR barrier published them cross-wave.
    s_cmp_eq_u32 s_loop_idx, 0
    if buf_idx == 0
      s_cbranch_scc1 pv_phase_skip_k_sync_buf0
    else
      s_cbranch_scc1 pv_phase_skip_k_sync_buf1
    end

    if buf_idx == 0
pv_phase_skip_k_sync_buf0:
    else
pv_phase_skip_k_sync_buf1:
    end
  end

  // VLDS-REHOIST (Opt-41): V_LDS_load moved back to qk_phase head — see
  // comment there. v_V ds_loads overlap pa_gemm_qk WMMA. The dscnt drain
  // below covers them along with K_LDS_ds_issue from this and prior phases.
  //s_wait_dscnt 0

  // VMASK: zero stale/OOB V bytes (tokens >= seq_len) now that v_V is coherent
  // and before any PV WMMA reads it, so a padding-page fp8-NaN cannot turn the
  // border-masked 0*V into NaN. Self-gated: full pages branch out immediately.
  s_wait_tensorcnt 2   // OPT53: tensorcnt 1 at pv-head
  apply_V_mask()

  // UNIDS (Opt-52): pure per-WMMA uniform distribution. 64 K b64 spread
  // 4 b64/WMMA across all 16 pv WMMAs (was: 32 upfront msb 0,1 + 32
  // distributed msb 2,3 across WMMAs 0..7 under KLDS-EARLIER). Goal:
  // reduce in-flight ds_load count at next qk-head dscnt 0 by pacing
  // issues evenly through the WMMA train.
  // Mapping w in 0..15:
  //   msb_k = w / 4    // 0..3
  //   n_sub = w % 4    // 0..3
  // VTDM-EARLY (Opt-55): V TDM now issued at qk_phase tail (after K TDM).
  // The s_wait_kmcnt 0 that was here for V_TDM_setup_step (PVSU Opt-54) is
  // no longer needed — K_TDM_load_half already drained kmcnt for the BT
  // lookup, and K_TDM_lookup_step's s_load is consumed by NEXT iter's
  // K_TDM_load_half (which has its own s_wait_kmcnt 0).

  if !is_last
    // 1+2: addr_setup for all 4 msbs, then drain so ds_issue can read addr.
    for var msb in [0:NUM_MSB_SEGMENTS - 1]
      K_LDS_addr_setup(msb, next_buf_idx)
    end
    s_wait_alu { va_vdst: 0 }

    // VTDM-EARLY (Opt-55): V_TDM_setup_step removed from SALU table — V TDM
    // is now issued at qk_phase tail. Remaining SALU budget = 5 (K lookup) +
    // 1 (page advance) = 6 across 16 WMMA windows. Plenty of headroom.
    var salu_rlts
    if do_prefetch && !is_last
      salu_rlts = [START_RESULT, START_RESULT]
      // LOOKFIX: page_advance MUST precede the K block-table lookup so the loop's
      // lookup targets the POST-advance page (= the page the next K_TDM_load_half
      // consumes), matching the preload's advance-then-lookup order. The old
      // [lookup, advance] order looked up the pre-advance page, so a multi-iter
      // split's last real page was loaded into a buffer the drain never consumes
      // -> drain reprocessed the prior page (argmax dropped at large q*k scale).
      var salu_calls = [#page_advance_step, #K_TDM_lookup_step]

      var rlt = START_RESULT
      for var w in [0:15]
        rlt = issue_n(#pa_gemm_pv(), 1, rlt)
        var msb_k    = w / 4
        var n_sub    = w % 4
        var addr_idx = msb_k * 2 + next_buf_idx
        for var pair in [0:3]
          var idx    = n_sub * 8 + pair * 2
          var offset = msb_k * K_LDS_MSB_STRIDE \
                     + n_sub * K_LDS_NSUB_STRIDE \
                     + pair * K_LDS_DHI_STRIDE
          set_vgpr_msb(QUIET, v_K[msb_k], v_K_LDS_issue_addr)
          ds_load_b64 v_8bit(v_K[msb_k][idx]), v_K_LDS_issue_addr[addr_idx] offset: offset
        end
        salu_rlts = issue_n_table(salu_calls, salu_rlts, 1)
        // MSB-CO: break the K-LDS ds_load -> next-w pa_gemm_pv s_set_vgpr_msb
        // adjacency (s_set_vgpr_msb cannot co-execute with ds_load). When the
        // SALU table is exhausted (high w) nothing separates them; this v_nop
        // forces the set_msb into a fresh co-issue group. Hidden under WMMA.
        v_nop
      end
      issue_all(#pa_gemm_pv(), rlt)
      // Drain any remaining SALU work (defensive — total budget ≤ 16).
      for var i in [0:len(salu_calls) - 1]
        var step_rlt = salu_rlts[i * INST_RESULT_NUM: (i + 1) * INST_RESULT_NUM - 1]
        while is_running(step_rlt)
          step_rlt = salu_calls[i](step_rlt)
        end
      end
    else
      // No V_TDM / page-advance to drip (is_last or !do_prefetch). Just
      // K_TDM_lookup_step (if !is_last) gets distributed.
      salu_rlts = [START_RESULT]
      var salu_calls = [#K_TDM_lookup_step]

      var rlt = START_RESULT
      for var w in [0:15]
        rlt = issue_n(#pa_gemm_pv(), 1, rlt)
        var msb_k    = w / 4
        var n_sub    = w % 4
        var addr_idx = msb_k * 2 + next_buf_idx
        for var pair in [0:3]
          var idx    = n_sub * 8 + pair * 2
          var offset = msb_k * K_LDS_MSB_STRIDE \
                     + n_sub * K_LDS_NSUB_STRIDE \
                     + pair * K_LDS_DHI_STRIDE
          set_vgpr_msb(QUIET, v_K[msb_k], v_K_LDS_issue_addr)
          ds_load_b64 v_8bit(v_K[msb_k][idx]), v_K_LDS_issue_addr[addr_idx] offset: offset
        end
        salu_rlts = issue_n_table(salu_calls, salu_rlts, 1)
        // MSB-CO: break the K-LDS ds_load -> next-w pa_gemm_pv s_set_vgpr_msb
        // adjacency (s_set_vgpr_msb cannot co-execute with ds_load). When the
        // SALU table is exhausted (high w) nothing separates them; this v_nop
        // forces the set_msb into a fresh co-issue group. Hidden under WMMA.
        v_nop
      end
      issue_all(#pa_gemm_pv(), rlt)
      for var i in [0:len(salu_calls) - 1]
        var step_rlt = salu_rlts[i * INST_RESULT_NUM: (i + 1) * INST_RESULT_NUM - 1]
        while is_running(step_rlt)
          step_rlt = salu_calls[i](step_rlt)
        end
      end
    end
  else
    // ====== No-K path (compile-time, peeled last iter only) ======
    // is_last → no K_TDM_lookup, no V_TDM, no page advance. Just pv WMMAs.
    issue_all(#pa_gemm_pv())
  end
end

function core_loop_iteration(param buf_idx, param next_buf_idx, param first_iter, param do_prefetch, param is_last)
  // PEELAST (Opt-28): is_last is a compile-time param threaded through
  // gemm_qk_phase / gemm_pv_phase to elide is-last runtime gates in the
  // main-loop body and drop the wmmaco K-enabled vs no-K cbranch. Peeled
  // last iter uses is_last=TRUE (and do_prefetch=FALSE).
  //
  // ========== GEMM_QK Phase ==========
  gemm_qk_phase(buf_idx, next_buf_idx, do_prefetch, is_last)

  // ========== Masking + Softmax Phase ==========
  pa_border_mask()
  s_wait_dscnt 0

  // VTDM-MID (Opt-55A): V TDM issued here, after masking, separated from K TDM
  // by the full pa_border_mask() compute (~30-40 VALU). K TDM has had time to
  // progress through the TDM pipe alone, avoiding LDS write bandwidth doubling.
  // V hide window from here = softmax (reduce + exp_chain + cvt) + pv_phase.
  // NSM removes shuffle_P/pa_zero_R but the per-msb softmax is larger, so the
  // hide window is no shorter than before.
  // s_V_phys_blk_idx is still valid from K_TDM_load_half's BTMERGE copy.
  if do_prefetch && !is_last
    V_TDM_load_half(buf_idx)
  end

  // ---- NSM softmax (per-msb staged; replaces per-m pa_fuesed_softmax) ----
  // Per-msb reduction: 4 sequential calls. msb=0/1/2 stage A only; msb=3 also
  // does the cross-msb tail → produces v_curr_max[0/1].
  for var msb in [0:NUM_MSB_SEGMENTS - 1]
    issue_all(#pa_softmax_reduce_msb(msb), set_inst_user_data(START_RESULT, first_iter))
  end

  // P3a: per-msb exp chain COMPUTE (D rescale, per-rb fma/exp/add/mul,
  // P_quant in v_SP[msb][rb*32..rb*32+31]). NO cvt here — cvt is in P3b.
  // msb=0 also does L *= delta_max; msb=3 folds row_sum partials into v_L[rb].
  //
  // WILLASMX: plain per-msb exp chain. The quant-mul broadcast is inlined in
  // willa's reduce_msb (no separate pa_quant_broadcast / exp_chain(0) split).
  for var msb in [0:NUM_MSB_SEGMENTS - 1]
    issue_all(#pa_softmax_exp_chain_msb(msb), set_inst_user_data(START_RESULT, first_iter))
  end

  // P3b: WILLACVT — per-msb cvt P_quant → FP8 (BOTH row-bands per call) into the
  // 2-seg GEMM_PV layout (v_SP[msb/2], offset rb*32+...). Single ASCENDING-msb
  // pass (4 calls). Still a 2nd pass AFTER all 4 exp_chain calls (cvt writes the
  // v_SP P area while exp_chain still reads/writes the compute area).
  //   Ascending order satisfies the cross-block WAR: msb=0 writes seg0 (its own
  //   source) and finishes reading it before msb=1 writes seg0's upper half;
  //   msb=2/3 write seg1 reading seg2/3 (disjoint). The intra-call msb=0
  //   self-alias is handled inside pa_softmax_cvt_msb via ALL_I group ordering.
  for var msb in [0:NUM_MSB_SEGMENTS - 1]
    issue_all(#pa_softmax_cvt_msb(msb), set_inst_user_data(START_RESULT, first_iter))
  end

  // ========== GEMM_PV Phase ==========
  // pa_shuffle_P() removed: NSM cvt writes the GEMM_PV-shuffled layout directly.
  // pa_zero_R_iter() removed: pa_gemm_pv's k_batch=0 WMMAs use literal 0 as C
  // operand (D = A*B + 0 = A*B), so v_R_iter doesn't need pre-zeroing.
  gemm_pv_phase(buf_idx, next_buf_idx, do_prefetch, is_last)
  // FOLDWAIT (rootcause fix): the PV WMMAs write v_R_iter; pa_fold_R_iter reads
  // v_R_iter. Disassembly showed NO va_vdst wait between them — the fold relied
  // on natural instruction spacing to cover WMMA latency, which only holds in the
  // steady pipeline state. At pipeline fill (first steady iter) / drain (last
  // iter) the fold read stale v_R_iter, giving per-iteration weights [1,1,2,..,0]
  // (proven by reconstruction). Drain the matrix/VALU counter so the fold always
  // reads the completed PV result.
  s_wait_alu { va_vdst: 0 }
  issue_all(#pa_fold_R_iter())

  // Advance compute-side page pointer (used by mask in NEXT iter).
  s_add_i32     s_page_idx, s_page_idx, WAVES

  // Loop control: PEELAST drops the inc+cmp here for main-loop callsites —
  // the top-level loop now does its own peel-check (loop_idx == loop_cnt-1)
  // BEFORE recursing. is_last=TRUE peeled call needs no loop control at all
  // since the next code path is core_loop_exit. We still increment so that
  // post-loop drain code that relied on s_loop_idx == s_loop_cnt sees a
  // consistent value.
  s_add_i32     s_loop_idx, s_loop_idx, 1
end

// ============================================================================
// Section 19: Cross-Wave Reduction & Output Finalization
// ============================================================================
// All 4 waves have processed disjoint subsets of KV pages. They now hold per-row
// partial (max_w, L_w, D_w). Combine via LDS:
//
//   global_max[r]     = max_w max_w[r]
//   correction[w, r]  = exp2(scl_log2e[m(r)] * (max_w[r] - global_max[r]))
//   L_final[r]        = Σ_w correction[w, r] * L_w[r]
//   D_final[r, :]     = Σ_w correction[w, r] * D_w[r, :]
//
// Final output per row: D_final * value_scale / L_final → bf16 → store.
//
// LDS layout (reuses K region, free after all GEMM):
//   MAX : 4 waves × 2 M-tiles × 32 lanes × 4 B =   1 KB   @ K_LDS_BASE + 0
//   L   : same layout                         =   1 KB   @ K_LDS_BASE + 1024
//   D   : 4 waves × R_VGPR_SIZE × 128 B       = 32 KB   @ K_LDS_BASE + 2048

var REDUCE_LDS_BASE        = K_LDS_BASE
var REDUCE_MAX_OFFSET      = 0
var REDUCE_MAX_STRIDE_WAVE = G1_M_TILES * 32 * 4                   // 256 B
var REDUCE_MAX_STRIDE_M    = 32 * 4                                // 128 B
var REDUCE_L_OFFSET        = REDUCE_MAX_OFFSET + WAVES * REDUCE_MAX_STRIDE_WAVE   // 1024
var REDUCE_R_OFFSET        = REDUCE_L_OFFSET + WAVES * REDUCE_MAX_STRIDE_WAVE     // 2048
var REDUCE_R_STRIDE_WAVE   = R_VGPR_SIZE * BYTES_PER_VGRP          // 8192 B

function cross_wave_reduce
  // ---- Phase 0: per-wave cross-lane reduce of L so each lane holds its row's true sum ----
  // XWR (Opt-31) Phase 0 fold: G1_M_TILES=2, issue both permlanex16s into
  // separate scratch (v_tmp1, v_tmp3) so a single s_wait_alu drains both
  // permlanex16's longer writeback before either v_add_f32 consumes them.
  // (v_tmp3 is overwritten by Phase 1 address compute below, but only after
  // its v_add here retires under the same wait.) Without this wait the X
  // would propagate via v_L→ds_store→another wave's ds_load and surface as
  // RAS_FIT_*_ded_unknown.
  set_vgpr_msb(QUIET, v_tmp1, v_L[0])
  v_permlanex16_b32 v_tmp1, v_8bit(v_L[0]), s_permlanex16_sel[0], s_permlanex16_sel[1]
  set_vgpr_msb(QUIET, v_tmp3, v_L[1])
  v_permlanex16_b32 v_tmp3, v_8bit(v_L[1]), s_permlanex16_sel[0], s_permlanex16_sel[1]
  s_wait_alu { va_vdst: 0 }
  set_vgpr_msb(QUIET, v_L[0], v_L[0], v_tmp1)
  v_add_f32 v_8bit(v_L[0]), v_8bit(v_L[0]), v_tmp1
  set_vgpr_msb(QUIET, v_L[1], v_L[1], v_tmp3)
  v_add_f32 v_8bit(v_L[1]), v_8bit(v_L[1]), v_tmp3

  // ---- Phase 1: prepare LDS addresses ----
  // v_tmp0 = REDUCE_LDS_BASE + lane * 4                     (for all reads)
  // v_tmp2 = v_tmp0 + s_wave_id * REDUCE_MAX_STRIDE_WAVE    (write addr for max/L)
  // v_tmp3 = v_tmp0 + s_wave_id * REDUCE_R_STRIDE_WAVE      (write addr for D)
  set_vgpr_msb(QUIET, v_tmp0, v0)
  v_lshlrev_b32 v_tmp0, 2, v0
  v_add_nc_u32  v_tmp0, v_tmp0, REDUCE_LDS_BASE

  s_lshl_b32    s_tmp0, s_wave_id, 8                 // * 256
  set_vgpr_msb(QUIET, v_tmp2, v_tmp0)
  v_add_nc_u32  v_tmp2, v_tmp0, s_tmp0

  s_lshl_b32    s_tmp1, s_wave_id, 13                // * 8192
  set_vgpr_msb(QUIET, v_tmp3, v_tmp0)
  v_add_nc_u32  v_tmp3, v_tmp0, s_tmp1

  // Ensure v_tmp0/v_tmp2/v_tmp3 (LDS addresses) and v_max[m]/v_L[m] (Phase 0
  // permlanex16+add results) retire before they are consumed by ds_store as
  // address/data. wgp_barrier alone does not flush VALU writeback.
  s_wait_alu { va_vdst: 0 }

  // ---- Phase 2: barrier, then write per-wave max/L/D to LDS ----
  wgp_barrier()

  for var m in [0:G1_M_TILES - 1]
    // ds_store: addr=v_tmp2 -> SRC0 slot, data=v_max[m]/v_L[m] -> SRC1 slot.
    set_vgpr_msb(QUIET, v0, v_tmp2, v_max[m])
    ds_store_b32 v_tmp2, v_8bit(v_max[m]) offset: REDUCE_MAX_OFFSET + m * REDUCE_MAX_STRIDE_M
    set_vgpr_msb(QUIET, v0, v_tmp2, v_L[m])
    ds_store_b32 v_tmp2, v_8bit(v_L[m])   offset: REDUCE_L_OFFSET   + m * REDUCE_MAX_STRIDE_M
  end

  for var seg in [0:VGPR_SEG_NUM - 1]
    for var i in [0:R_VGPR_SECT_SIZE - 1]
      var gidx = seg * R_VGPR_SECT_SIZE + i
      // addr=v_tmp3 -> SRC0 slot, data=v_R[seg] -> SRC1 slot.
      set_vgpr_msb(QUIET, v0, v_tmp3, v_R[seg])
      ds_store_b32 v_tmp3, v_8bit(v_R[seg][i]) offset: REDUCE_R_OFFSET + gidx * BYTES_PER_VGRP
    end
  end

  s_wait_dscnt 0
  wgp_barrier()

  // ---- Phase 3: read max from all 4 waves, compute global max and per-wave correction ----
  // v_corr[w*2 + m] will hold correction factor for wave w, M-tile m.
  for var m in [0:G1_M_TILES - 1]
    // Read wave w's max into v_corr[w*2+m][0]
    for var w in [0:WAVES - 1]
      set_vgpr_msb(QUIET, v_corr[w * G1_M_TILES + m], v_tmp0)
      ds_load_b32 v_8bit(v_corr[w * G1_M_TILES + m][0]), v_tmp0 offset: REDUCE_MAX_OFFSET + w * REDUCE_MAX_STRIDE_WAVE + m * REDUCE_MAX_STRIDE_M
      v_nop   // MSB-CO: break ds_load_b32 -> next-iter s_set_vgpr_msb adjacency
    end
  end
  s_wait_dscnt 0

  for var m in [0:G1_M_TILES - 1]
    // global_max = max over 4 waves (per-row, already lane-consistent per wave)
    // XWR (Opt-P3-TREE): pairwise tree max — dep chain depth 2 instead of 3.
    // v_tmp2 reusable here (was Phase 2 write addr, already retired).
    set_vgpr_msb(QUIET, v_tmp1, v_corr[m], v_corr[1 * G1_M_TILES + m])
    v_max_f32 v_tmp1, v_8bit(v_corr[m][0]), v_8bit(v_corr[1 * G1_M_TILES + m][0])
    set_vgpr_msb(QUIET, v_tmp2, v_corr[2 * G1_M_TILES + m], v_corr[3 * G1_M_TILES + m])
    v_max_f32 v_tmp2, v_8bit(v_corr[2 * G1_M_TILES + m][0]), v_8bit(v_corr[3 * G1_M_TILES + m][0])
    set_vgpr_msb(QUIET, v_tmp1, v_tmp1, v_tmp2)
    v_max_f32 v_tmp1, v_tmp1, v_tmp2

    // correction[w, m] = exp2(scl_log2e[m] * (max_w - global_max))
    // XWR (Opt-31) Phase 3 v_mov hoist: the v_max[m] = v_tmp1 copy moved to
    // AFTER this per-w loop so the sub→mul→exp chain can issue back-to-back
    // without an extra v_mov in the inter-iter critical path. v_max[m] is
    // not read inside this loop, so the move is safe.
    for var w in [0:WAVES - 1]
      set_vgpr_msb(QUIET, v_corr[w * G1_M_TILES + m], v_corr[w * G1_M_TILES + m], v_tmp1)
      v_sub_f32 v_8bit(v_corr[w * G1_M_TILES + m][0]), v_8bit(v_corr[w * G1_M_TILES + m][0]), v_tmp1
      set_vgpr_msb(QUIET, v_corr[w * G1_M_TILES + m], v_corr[w * G1_M_TILES + m], v_scl_log2e[m])
      v_mul_f32 v_8bit(v_corr[w * G1_M_TILES + m][0]), v_8bit(v_corr[w * G1_M_TILES + m][0]), v_8bit(v_scl_log2e[m])
      set_vgpr_msb(QUIET, v_corr[w * G1_M_TILES + m], v_corr[w * G1_M_TILES + m])
      v_exp_f32 v_8bit(v_corr[w * G1_M_TILES + m][0]), v_8bit(v_corr[w * G1_M_TILES + m][0])
    end

    // Keep v_max consistent with the globally reduced L/D. SplitLSE is stored
    // later as global_max * scale + log(global_L)  // using wave-local max here
    // makes LSE systematically too small when another wave owns the row max.
    // (Hoisted below the per-w loop; v_tmp1 still holds the global max.)
    set_vgpr_msb(QUIET, v_max[m], v_tmp1)
    v_mov_b32 v_8bit(v_max[m]), v_tmp1
  end

  // v_exp_f32 is transcendental (longer writeback latency). Phase 4 below
  // immediately uses v_corr[*] as a v_fma_f32 source, so flush VALU writeback
  // before consumption to avoid reading stale/X values under sched_mode 2.
  s_wait_alu { va_vdst: 0 }

  // ---- Phase 4: read L from all waves, sum with correction ----
  // XWR (Opt-31) Phase 4 parallelize: mirror Phase 5's pattern — issue ALL
  // G1_M_TILES * WAVES = 8 ds_loads into v_K[0][0..7] scratch (v_K is free
  // here: K data no longer needed), single s_wait_dscnt 0 covers all 8, then
  // 8 v_fma_f32s. Replaces 8 serialized dscnt fences with 1.
  for var m in [0:G1_M_TILES - 1]
    for var w in [0:WAVES - 1]
      set_vgpr_msb(QUIET, v_K[0], v_tmp0)
      ds_load_b32 v_8bit(v_K[0][m * WAVES + w]), v_tmp0 offset: REDUCE_L_OFFSET + w * REDUCE_MAX_STRIDE_WAVE + m * REDUCE_MAX_STRIDE_M
      v_nop   // MSB-CO: break ds_load_b32 -> next-iter s_set_vgpr_msb adjacency
    end
  end
  s_wait_dscnt 0
  for var m in [0:G1_M_TILES - 1]
    // Start with 0  // accumulate corrected L per wave
    set_vgpr_msb(QUIET, v_L[m])
    v_mov_b32 v_8bit(v_L[m]), 0
    for var w in [0:WAVES - 1]
      // v_fma_f32 dst, src0=v_K[0][m*WAVES+w], src1=v_corr, src2=v_L[m].
      set_vgpr_msb(QUIET, v_L[m], v_K[0], v_corr[w * G1_M_TILES + m], v_L[m])
      v_fma_f32 v_8bit(v_L[m]), v_8bit(v_K[0][m * WAVES + w]), v_8bit(v_corr[w * G1_M_TILES + m][0]), v_8bit(v_L[m])
    end
  end

  // ---- Phase 5: read D from all waves, sum with correction (per segment → per M-tile) ----
  // XWR-P5PIPE: software-pipelined evolution of Opt-P5-PAR. The 8 D batches
  // (VGPR_SEG_NUM=4 segs × R_VGPR_SECT_SIZE/I_BATCH=2 = 8) each get a DISTINCT
  // 32-VGPR load buffer: seg's two batches use v_K[seg] then v_V[seg]. BOTH
  // live in segment `seg`, so the consume fma's set_vgpr_msb spans the same
  // window as v_R[seg] EXACTLY as the original v_K[seg] form did (no new msb
  // shape). v_V is free here — V data is dead after the last gemm_pv, same as
  // v_K. All 8 buffers distinct (and consecutive batches always differ), so
  // batch k+1's 32 ds_loads can be in flight while batch k's 32 fmas run.
  //
  // Each fence stays a FULL s_wait_dscnt 0 (NO partial-count wait — same safety
  // convention as the rest of the kernel; the reorder cannot change results,
  // only timing). Because k+1 is issued one fma-batch before its drain, every
  // dscnt 0 after the first drains loads that already had a ~32-fma window to
  // retire — converting Opt-P5-PAR's 8 COLD fences into 1 cold + 7 hidden.
  // Max in-flight stays 32 (k drained at top before k+1 issued), so LDS
  // load-FIFO pressure is unchanged vs Opt-P5-PAR.
  var I_BATCH       = KV_VGPR_PER_MSB / WAVES              // 8
  var XWR_PER_SEG   = R_VGPR_SECT_SIZE / I_BATCH           // 2 batches per seg
  var XWR_NBATCH    = VGPR_SEG_NUM * XWR_PER_SEG           // 8
  // Per-batch load buffer (index = batch k). xwr_buf[2*seg+b] is in segment seg.
  var xwr_buf = [v_K[0], v_V[0], v_K[1], v_V[1], v_K[2], v_V[2], v_K[3], v_V[3]]

  // Prologue: issue batch 0's 32 loads (seg 0, i_base 0 → v_K[0]).
  for var i_off in [0:I_BATCH - 1]
    var gidx = 0 * R_VGPR_SECT_SIZE + 0 + i_off
    for var w in [0:WAVES - 1]
      var idx = i_off * WAVES + w
      set_vgpr_msb(QUIET, xwr_buf[0], v_tmp0)
      ds_load_b32 v_8bit(xwr_buf[0][idx]), v_tmp0 offset: REDUCE_R_OFFSET + w * REDUCE_R_STRIDE_WAVE + gidx * BYTES_PER_VGRP
    end
  end

  for var k in [0:XWR_NBATCH - 1]
    var seg    = k / XWR_PER_SEG
    var i_base = (k % XWR_PER_SEG) * I_BATCH
    var m      = seg / (VGPR_SEG_NUM / G1_M_TILES)   // M-tile index for this D segment

    // Drain THIS batch's loads (issued in the prologue or by the prior iter).
    s_wait_dscnt 0

    // Issue NEXT batch's 32 loads so they fly under this batch's 32 fmas.
    if k + 1 < XWR_NBATCH
      var nseg    = (k + 1) / XWR_PER_SEG
      var ni_base = ((k + 1) % XWR_PER_SEG) * I_BATCH
      for var i_off in [0:I_BATCH - 1]
        var gidx = nseg * R_VGPR_SECT_SIZE + ni_base + i_off
        for var w in [0:WAVES - 1]
          var idx = i_off * WAVES + w
          set_vgpr_msb(QUIET, xwr_buf[k + 1], v_tmp0)
          ds_load_b32 v_8bit(xwr_buf[k + 1][idx]), v_tmp0 offset: REDUCE_R_OFFSET + w * REDUCE_R_STRIDE_WAVE + gidx * BYTES_PER_VGRP
        end
      end
      // MSB-CO: break the last next-batch ds_load -> the consume loop's
      // s_set_vgpr_msb adjacency (set_vgpr_msb cannot co-execute with ds_load).
      v_nop
    end

    // Consume THIS batch. FMAINTLV: zero all 8 accumulators, then iterate
    // w-MAJOR so the 8 fmas within each w step write 8 DISTINCT v_R[seg][i]
    // (independent — no RAW between consecutive fmas), hiding v_fma writeback
    // latency. For a fixed i the w=0..3 order is preserved, so the FP
    // accumulation is bit-identical to the prior i-major form. Bonus: for a
    // fixed w, v_corr[w*G1_M_TILES+m] and xwr_buf[k] are constant across the 8
    // i, so set_vgpr_msb(QUIET) is emitted once per w instead of per fma.
    for var i_off in [0:I_BATCH - 1]
      var i = i_base + i_off
      set_vgpr_msb(QUIET, v_R[seg], v_R[seg])
      v_mov_b32 v_8bit(v_R[seg][i]), 0
    end
    for var w in [0:WAVES - 1]
      for var i_off in [0:I_BATCH - 1]
        var i   = i_base + i_off
        var idx = i_off * WAVES + w
        // v_fma_f32 dst, src0=xwr_buf[k], src1=v_corr, src2=v_R[seg]. Match order.
        set_vgpr_msb(QUIET, v_R[seg], xwr_buf[k], v_corr[w * G1_M_TILES + m], v_R[seg])
        v_fma_f32 v_8bit(v_R[seg][i]), v_8bit(xwr_buf[k][idx]), v_8bit(v_corr[w * G1_M_TILES + m][0]), v_8bit(v_R[seg][i])
      end
    end
  end

  // XWR-EXIT-BARRIER: the reduce region (REDUCE_LDS_BASE == K_LDS_BASE, spanning
  // tiles 0/1/2) is READ by every wave above, fenced only by per-wave
  // s_wait_dscnt 0 — there was NO cross-wave barrier after the Phase-2/3 reads.
  // After returning, wave 1/2/3 skip the store and re-enter work_loop_start,
  // issuing the next work-item's K/V TDM into their own LDS tiles (1/2/3); those
  // tiles overlap the reduce-R region (+2048..+34816 B). A fast wave's next-iter
  // TDM write could land while a slow wave is still reading the reduce region ->
  // poisoned cross-wave O. The 3486 barrier only guards the WRITES, not the
  // reads. Add a final barrier so all waves finish their reduce reads before any
  // wave can advance and overwrite that LDS. Placed at the END of reduce (not at
  // work_done) so wave 0's store still overlaps wave 1/2/3's next-iter prefetch
  // — safe because R_store stages only into tile 0 (wave 0's own UNILOAD tile).
  wgp_barrier()
end

// ----------------------------------------------------------------------------
// Output finalize: apply value_scale, divide by L, convert to bf16.
// Runs on all waves (v_R/v_L already globally reduced), but only wave 0 stores.
// ----------------------------------------------------------------------------
function pa_normalize_output_fp32 (param do_sink)
  reset_vgpr_msb()

  // Apply value_scale and divide by L. Leaves v_R in FP32 for either final
  // bf16 output or persistent SplitO output.
  //
  // SINK: when ENABLE_SINK == 1 && do_sink == 1, merge per-q-head
  // sink logit into L before the rcp(L) step:
  //   new_max   = max(v_max[m], v_SINK)
  //   row_scale = exp2((v_max[m] - new_max) * scl_log2e[m])
  //   sink_term = exp2((v_SINK    - new_max) * scl_log2e[m])
  //   L         = L * row_scale + sink_term
  //   v_max[m]  = new_max
  // Then fold row_scale into rcp(L) before broadcasting. The flag is toggled
  // by callers (set 1 around pa_finalize_output's call, left 0 on the
  // split-KV partial path so host reduction doesn't double-count sink).
  set_vgpr_msb(QUIET)
  v_mov_b32 v_tmp0, s_value_scale
  v_mov_b32 v_tmp1, s_value_scale

  for var msb in [0:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_R[msb], v_R[msb], v_tmp0)
    for var i in [0:2:R_VGPR_SECT_SIZE - 1]
      v_pk_mul_f32 v_8bit(v_R[msb][i]), v_8bit(v_R[msb][i]), v_tmp0
    end
  end

  // Step 2: Normalize D = D * (1/L) per M-tile (L already global).
  // In causal split-KV, an early MTP row can have no valid tokens in a later
  // split. Then L is 0 and D is 0  // force inv_L to 0 to avoid 0 * inf -> NaN.

  // SINK stash: v_SINK shares the size-1 v_L[0]'s overrun slot v_L[0][1] (the
  // v_pk_mul broadcast partner). The per-m 1/L broadcast for m=0
  // (v_mov v_L[0][1], v_L[0][0]) would clobber v_SINK before the m=1 merge reads
  // it (-> sink=0 -> max(S,0) -> V*exp(scl*S) on negative-score rows). Copy it
  // once into the now-dead v_SINK_addr[0] (only used for the prologue load) and
  // read both per-m merges from there. No extra VGPR (segments at the 256 cap).
  if ENABLE_SINK == 1 && do_sink == 1
    s_wait_loadcnt 0
    set_vgpr_msb(QUIET, v_SINK_addr[0], v_SINK)
    v_mov_b32 v_8bit(v_SINK_addr[0]), v_8bit(v_SINK)
  end

  for var m in [0:G1_M_TILES - 1]
    var l_msb = m

    // ---- SINK merge (only on the final bf16 path: do_sink == 1) ----
    if ENABLE_SINK == 1 && do_sink == 1
      // v_SINK was stashed into v_SINK_addr[0] above (clobber-safe).
      // new_max = max(v_max[m], v_SINK)            -> v_tmp0
      set_vgpr_msb(QUIET, v_tmp0, v_max[m], v_SINK_addr[0])
      v_max_f32 v_8bit(v_tmp0), v_8bit(v_max[m]), v_8bit(v_SINK_addr[0])

      // row_scale = exp2((v_max[m] - new_max) * v_scl_log2e[m])
      // Live until after rcp(L) below  // park in v_p_quant_mul.
      set_vgpr_msb(QUIET, v_tmp1, v_max[m], v_tmp0)
      v_sub_f32 v_8bit(v_tmp1), v_8bit(v_max[m]), v_8bit(v_tmp0)
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1, v_scl_log2e[m])
      v_mul_f32 v_8bit(v_tmp1), v_8bit(v_tmp1), v_8bit(v_scl_log2e[m])
      s_wait_alu { va_vdst: 0 }
      set_vgpr_msb(QUIET, v_p_quant_mul[0][0], v_tmp1)
      v_exp_f32 v_8bit(v_p_quant_mul[0][0]), v_8bit(v_tmp1)

      // sink_term = exp2((v_SINK - new_max) * v_scl_log2e[m])  -> v_tmp1
      set_vgpr_msb(QUIET, v_tmp1, v_SINK_addr[0], v_tmp0)
      v_sub_f32 v_8bit(v_tmp1), v_8bit(v_SINK_addr[0]), v_8bit(v_tmp0)
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1, v_scl_log2e[m])
      v_mul_f32 v_8bit(v_tmp1), v_8bit(v_tmp1), v_8bit(v_scl_log2e[m])
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1)
      v_exp_f32 v_8bit(v_tmp1), v_8bit(v_tmp1)

      // L = L * row_scale + sink_term
      s_wait_alu { va_vdst: 0 }
      set_vgpr_msb(QUIET, v_L[l_msb], v_L[l_msb], v_p_quant_mul[0][0], v_tmp1)
      v_fma_f32 v_8bit(v_L[l_msb]), v_8bit(v_L[l_msb]), v_8bit(v_p_quant_mul[0][0]), v_8bit(v_tmp1)

      // v_max[m] = new_max
      set_vgpr_msb(QUIET, v_max[m], v_tmp0)
      v_mov_b32 v_8bit(v_max[m]), v_8bit(v_tmp0)
    end

    // 1 / L_global, guarded for empty causal split rows.
    set_vgpr_msb(QUIET, v0, v_L[l_msb])
    v_cmp_eq_f32 vcc, v_8bit(v_L[l_msb]), 0
    set_vgpr_msb(QUIET, v_L[l_msb], v_L[l_msb])
    v_rcp_f32 v_8bit(v_L[l_msb]), v_8bit(v_L[l_msb])
    // v_rcp_f32 is transcendental (longer writeback latency than VALU).
    // The very next instruction reads v_L[l_msb] in v_cndmask_b32, separated
    // only by a SALU set_vgpr_msb. Under sched_mode 2 the trans pipe may
    // not have retired, producing X/stale 1/L that propagates into v_R via
    // v_pk_mul_f32 below.
    s_wait_alu { va_vdst: 0 }
    set_vgpr_msb(QUIET, v_L[l_msb], v_L[l_msb])
    v_cndmask_b32 v_8bit(v_L[l_msb]), v_8bit(v_L[l_msb]), 0, vcc

    // SINK: fold row_scale into 1/L before broadcasting.
    if ENABLE_SINK == 1 && do_sink == 1
      set_vgpr_msb(QUIET, v_L[l_msb], v_L[l_msb], v_p_quant_mul[0][0])
      v_mul_f32 v_8bit(v_L[l_msb]), v_8bit(v_L[l_msb]), v_8bit(v_p_quant_mul[0][0])
    end

    // Duplicate for v_pk_mul_f32
    v_mov_b32 v_8bit(v_L[l_msb][1]), v_8bit(v_L[l_msb][0])

    for var r_seg in [2 * m : 2 * m + 1]
      set_vgpr_msb(QUIET, v_R[r_seg], v_R[r_seg], v_L[l_msb])
      for var i in [0:2:R_VGPR_SECT_SIZE - 1]
        v_pk_mul_f32 v_8bit(v_R[r_seg][i]), v_8bit(v_R[r_seg][i]), v_8bit(v_L[l_msb])
      end
    end
  end
end

function pa_finalize_output
  pa_normalize_output_fp32(1)   // do_sink=1: final bf16 path merges sink

  // Convert FP32 -> bfloat16
  for var msb in [0:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_R[msb], v_R[msb], v_R[msb])
    for var i in [0:2:R_VGPR_SECT_SIZE - 1]
      v_cvt_pk_bf16_f32 v_8bit(v_R[msb][i/2]), v_8bit(v_R[msb][i]), v_8bit(v_R[msb][i + 1])
    end
  end
end

function store_partial_results
  reset_vgpr_msb()

  // buffer_store_* requires an SGPR/M0 soffset operand on this assembler.
  s_mov_b32 m0, 0

  // SINK-SPLIT: the OWNER of this row (s_KV_start == s_KV_batch_start, i.e. the
  // work item covering the row's FIRST KV chunk; also the direct-O case) merges
  // the per-row sink into v_L/v_max and folds row_scale into v_R HERE — before the
  // SplitLSE/SplitO stores — so the owner's stored partial carries the sink
  // exactly once. Non-owner splits skip it, so the (sink-free) reduce sums the
  // sink in once via the owner's partial. Mirrors pa_normalize's do_sink merge but
  // keeps fp32 partials and folds row_scale directly into v_R (pa_normalize(0)
  // below then applies value_scale * 1/L'). v_SINK was loaded ONLY on the owner.
  if ENABLE_SINK == 1
    s_cmp_eq_i32 s_KV_start, s_KV_batch_start            // row's first KV chunk?
    s_cbranch_scc0 skip_split_sink                       // non-owner -> no sink
    s_mov_b32 exec_lo, 0xFFFFFFFF                        // merge all rows
    s_wait_loadcnt 0                                     // sink load (prologue) ready
    // stash v_SINK (shares v_L[0]'s overrun slot) into the now-dead v_SINK_addr[0]
    set_vgpr_msb(QUIET, v_SINK_addr[0], v_SINK)
    v_mov_b32 v_8bit(v_SINK_addr[0]), v_8bit(v_SINK)
    for var m in [0:G1_M_TILES - 1]
      // new_max = max(v_max[m], v_SINK)  -> v_tmp0
      set_vgpr_msb(QUIET, v_tmp0, v_max[m], v_SINK_addr[0])
      v_max_f32 v_8bit(v_tmp0), v_8bit(v_max[m]), v_8bit(v_SINK_addr[0])
      // row_scale = exp2((v_max[m]-new_max)*scl) -> v_p_quant_mul[m][0] (kept for v_R)
      set_vgpr_msb(QUIET, v_tmp1, v_max[m], v_tmp0)
      v_sub_f32 v_8bit(v_tmp1), v_8bit(v_max[m]), v_8bit(v_tmp0)
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1, v_scl_log2e[m])
      v_mul_f32 v_8bit(v_tmp1), v_8bit(v_tmp1), v_8bit(v_scl_log2e[m])
      s_wait_alu { va_vdst: 0 }
      set_vgpr_msb(QUIET, v_p_quant_mul[m][0], v_tmp1)
      v_exp_f32 v_8bit(v_p_quant_mul[m][0]), v_8bit(v_tmp1)
      // sink_term = exp2((v_SINK-new_max)*scl) -> v_tmp1
      set_vgpr_msb(QUIET, v_tmp1, v_SINK_addr[0], v_tmp0)
      v_sub_f32 v_8bit(v_tmp1), v_8bit(v_SINK_addr[0]), v_8bit(v_tmp0)
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1, v_scl_log2e[m])
      v_mul_f32 v_8bit(v_tmp1), v_8bit(v_tmp1), v_8bit(v_scl_log2e[m])
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1)
      v_exp_f32 v_8bit(v_tmp1), v_8bit(v_tmp1)
      // L = L*row_scale + sink_term
      s_wait_alu { va_vdst: 0 }
      set_vgpr_msb(QUIET, v_L[m], v_L[m], v_p_quant_mul[m][0], v_tmp1)
      v_fma_f32 v_8bit(v_L[m]), v_8bit(v_L[m]), v_8bit(v_p_quant_mul[m][0]), v_8bit(v_tmp1)
      // v_max[m] = new_max
      set_vgpr_msb(QUIET, v_max[m], v_tmp0)
      v_mov_b32 v_8bit(v_max[m]), v_8bit(v_tmp0)
      // fold row_scale into v_R[2m],v_R[2m+1] (O was accumulated rel. to old max)
      set_vgpr_msb(QUIET, v_p_quant_mul[m], v_p_quant_mul[m])
      v_mov_b32 v_8bit(v_p_quant_mul[m][1]), v_8bit(v_p_quant_mul[m][0])
      for var r_seg in [2 * m : 2 * m + 1]
        set_vgpr_msb(QUIET, v_R[r_seg], v_R[r_seg], v_p_quant_mul[m])
        for var i in [0:2:R_VGPR_SECT_SIZE - 1]
          v_pk_mul_f32 v_8bit(v_R[r_seg][i]), v_8bit(v_R[r_seg][i]), v_8bit(v_p_quant_mul[m])
        end
      end
    end
  skip_split_sink:
    reset_vgpr_msb()
  end

  // ---- Store SplitLSE FP32 before v_L is changed to reciprocal by normalization.
  // Host reduce expects partial_lse[partial_o_loc + mtp_layer][kv_head*gqa + gqa_id].
  for var m in [0:G1_M_TILES - 1]
    // Store only valid MTP rows. Otherwise inactive rows (for example m=1 when
    // mtp=1) write partial_idx+2/+3 and can overwrite another split's valid rows.
    if m == 0
      s_cmp_ge_u32 s_mtp, 1
      s_cselect_b32 s_tmp0, 0xFFFFFFFF, 0x00FF00FF
    else
      s_cmp_ge_u32 s_mtp, 2
      s_cselect_b32 s_tmp0, 0x00FF00FF, 0
      s_cmp_ge_u32 s_mtp, 3
      s_cselect_b32 s_tmp0, 0xFFFFFFFF, s_tmp0
    end
    s_mov_b32 exec_lo, s_tmp0

    reset_vgpr_msb()
    set_vgpr_msb(QUIET, v_tmp3, v_L[m])
    v_log_f32 v_tmp3, v_8bit(v_L[m])
    // Use per-m vaddr/vdata VGPRs (v_LSE_addr[m] / v_LSE_data[m]) instead of
    // shared v_tmp1 / v_tmp2: iteration m+1's VALU now writes a different
    // VGPR than the store of iteration m read, so no VM_VSRC WAR forms and
    // no s_wait_alu { vm_vsrc: 0 } is needed at loop bottom.
    set_vgpr_msb(QUIET, v_LSE_data[m], v_max[m], v_scl_log2e[m])
    v_mul_f32 v_LSE_data[m], v_8bit(v_max[m]), v_8bit(v_scl_log2e[m])
    // v_log_f32 (trans) writes v_tmp3 only ~3 instructions before
    // v_add_f32 reads it. Trans pipe writeback latency may not be covered
    // under sched_mode 2  // flush before consumption.
    s_wait_alu { va_vdst: 0 }
    set_vgpr_msb(QUIET, v_LSE_data[m], v_LSE_data[m], v_tmp3)
    v_add_f32 v_LSE_data[m], v_LSE_data[m], v_tmp3
    v_mul_f32 v_LSE_data[m], v_LSE_data[m], s_loge2

    // row = (v0 & 0xf) + m * 16  // mtp_layer = row >> 3  // gqa_id = row & 7.
    set_vgpr_msb(QUIET, v_tmp0, v0)
    v_and_b32 v_tmp0, v0, 0xf
    if m > 0
      v_add_nc_u32 v_tmp0, v_tmp0, m * 16
    end
    // v_lshrrev_b32 dst, imm, vsrc reads vsrc from SRC1.
    set_vgpr_msb(QUIET, v_LSE_addr[m], v0, v_tmp0)
    v_lshrrev_b32 v_LSE_addr[m], 3, v_tmp0
    set_vgpr_msb(QUIET, v_tmp0, v_tmp0)
    v_and_b32 v_tmp0, v_tmp0, 7

    set_vgpr_msb(QUIET, v_LSE_addr[m], v_LSE_addr[m])
    v_add_nc_u32 v_LSE_addr[m], v_LSE_addr[m], s_partial_idx
    v_mul_lo_u32 v_LSE_addr[m], v_LSE_addr[m], s_KV_nheads
    v_add_nc_u32 v_LSE_addr[m], v_LSE_addr[m], s_KV_head
    v_mul_u32_u24 v_LSE_addr[m], v_LSE_addr[m], GQA_RATIO
    set_vgpr_msb(QUIET, v_LSE_addr[m], v_LSE_addr[m], v_tmp0)
    v_add_nc_u32 v_LSE_addr[m], v_LSE_addr[m], v_tmp0
    v_lshlrev_b32 v_LSE_addr[m], 2, v_LSE_addr[m]

    // For buffer_store, the data VGPR is encoded in VDST/srcD and the
    // vaddr VGPR is SRC0/srcA. Keep vaddr in segment 0  // set dst only for data.
    // VALU→VMEM RAW on v_LSE_addr[m] / v_LSE_data[m] still requires va_vdst
    // flush  // the VM_VSRC WAR has been eliminated by the per-m VGPR split.
    s_wait_alu { va_vdst: 0 }
    set_vgpr_msb(QUIET, v_LSE_data[m], v_LSE_addr[m])
    buffer_store_dword v_LSE_data[m], v_LSE_addr[m], s_regs(s_PartialLSE_addr, 0), m0 offen:1
  end
  s_mov_b32 exec_lo, 0xFFFFFFFF

  // Normalize O after LSE is safely stored. do_sink=0: split-KV partial
  // path. Sink merge is deferred to the host so it's only counted once
  // across all splits (host reduces partial_LSE/O across splits).
  pa_normalize_output_fp32(0)
  reset_vgpr_msb()

  // ---- Store SplitO FP32.
  // Host reduce expects partial_o[partial_o_loc + mtp_layer][kv_head*gqa + gqa_id][dim].
  for var seg in [0:VGPR_SEG_NUM - 1]
    var m_tile = seg / 2
    var hdim_half = seg % 2
    // Match SplitLSE validity: m_tile 0 covers mtp layers 0/1, m_tile 1 covers
    // layers 2/3. Only active layers may store, or partial rows overlap.
    if m_tile == 0
      s_cmp_ge_u32 s_mtp, 1
      s_cselect_b32 s_tmp0, 0xFFFFFFFF, 0x00FF00FF
    else
      s_cmp_ge_u32 s_mtp, 2
      s_cselect_b32 s_tmp0, 0x00FF00FF, 0
      s_cmp_ge_u32 s_mtp, 3
      s_cselect_b32 s_tmp0, 0xFFFFFFFF, s_tmp0
    end
    s_mov_b32 exec_lo, s_tmp0

    for var i in [0:R_VGPR_SECT_SIZE - 1]
      reset_vgpr_msb()
      var col_base = hdim_half * 32 + (i / 8) * 16 + (i % 8)
      set_vgpr_msb(QUIET, v_tmp0, v0)
      v_and_b32 v_tmp0, v0, 0xf
      if m_tile > 0
        v_add_nc_u32 v_tmp0, v_tmp0, m_tile * 16
      end
      // v_lshrrev_b32 dst, imm, vsrc reads vsrc from SRC1.
      set_vgpr_msb(QUIET, v_tmp1, v0, v_tmp0)
      v_lshrrev_b32 v_tmp1, 3, v_tmp0                 // mtp_layer
      set_vgpr_msb(QUIET, v_tmp0, v_tmp0)
      v_and_b32 v_tmp0, v_tmp0, 7                     // gqa_id

      set_vgpr_msb(QUIET, v_tmp1, v_tmp1)
      v_add_nc_u32 v_tmp1, v_tmp1, s_partial_idx
      v_mul_lo_u32 v_tmp1, v_tmp1, s_KV_nheads
      v_add_nc_u32 v_tmp1, v_tmp1, s_KV_head
      v_mul_u32_u24 v_tmp1, v_tmp1, GQA_RATIO
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1, v_tmp0)
      v_add_nc_u32 v_tmp1, v_tmp1, v_tmp0
      v_mul_u32_u24 v_tmp1, v_tmp1, V_H_DIM * 4

      // v_lshrrev_b32 dst, imm, vsrc reads vsrc from SRC1.
      set_vgpr_msb(QUIET, v_tmp0, v0, v0)
      v_lshrrev_b32 v_tmp0, 4, v0
      v_lshlrev_b32 v_tmp0, 5, v_tmp0                 // lane[4] * 8 cols * 4B
      v_add_nc_u32 v_tmp1, v_tmp1, v_tmp0
      v_add_nc_u32 v_tmp1, v_tmp1, col_base * 4
      // For buffer_store, the data VGPR is encoded in VDST/srcD and the
      // vaddr VGPR is SRC0/srcA. v_R[seg] may live in a high VGPR segment  //
      // v_tmp1 must stay in segment 0 because it is the byte offset.
      // v_tmp1 (vaddr) just produced by v_add_nc_u32  // v_R[seg][i] (data)
      // produced earlier by pa_normalize_output_fp32's v_pk_mul_f32 chain.
      // Flush before buffer_store consumes them under sched_mode 2.
      s_wait_alu { va_vdst: 0 }
      set_vgpr_msb(QUIET, v_R[seg], v_tmp1)
      buffer_store_dword v_8bit(v_R[seg][i]), v_tmp1, s_regs(s_PartialO_addr, 0), m0 offen:1
      // SplitO inner loop iterates VGPR_SEG_NUM * R_VGPR_SECT_SIZE = 64 times,
      // making per-iteration vaddr VGPRs prohibitively expensive. Keep the
      // VM_VSRC drain here so the next iteration's v_lshrrev_b32 v_tmp1 is
      // safe under SCHED_MODE 2.
      s_wait_alu { vm_vsrc: 0 }
    end
  end
  s_mov_b32 exec_lo, 0xFFFFFFFF
end

function R_store_to_global
  // Output layout: [batch, num_heads, head_dim] bf16, matches Q.
  //   num_heads = mtp_layers * kv_heads * gqa_ratio   (mtp-major)
  //   Row index within batch = mtp_lvl * (kv_heads * gqa_ratio) + kv_head * gqa_ratio + gqa
  // Base global address for this (batch, kv_head, mtp=0):
  //   R_addr + batch * R_batch_stride + kv_head * gqa_ratio * R_head_stride
  s_mul_i32    s_tmp0, s_tg_idx, s_R_batch_stride
  s_mul_i32    s_tmp1, s_tg_idy, s_gqa_ratio
  s_mul_i32    s_tmp1, s_tmp1, V_H_DIM * R_BPP
  s_add_i32    s_tmp0, s_tmp0, s_tmp1
  s_add_u32    s_R_addr[0], s_R_addr[0], s_tmp0
  s_addc_u32   s_R_addr[1], s_R_addr[1], 0
  s_and_b32    s_R_addr[1], s_R_addr[1], 0x1ffffff    // 25-bit aperture mask

  // ---- Phase 1: Store D to row-major LDS ----
  // For GEMM_PV we call WMMA as A=V, B=P, so WMMA-D is D[M=head_dim, N=query].
  // The D layout is lane={M[3],N[3:0]}, vgpr=M[2:0]. Therefore:
  //   row = N = lane[3:0]
  //   col = M = lane[4]*8 + packed-vgpr contribution
  // After bf16 packing, v_R[seg][0..3] cover one 16-col tile's cols 0..7
  // and lanes 16..31 cover cols 8..15. v_R[seg][4..7] cover the next
  // 16-col tile. A ds_store_b128 per lane writes eight bf16 columns for
  // that row, producing the row-major LDS image consumed by the async store.
  var R_TILE_DIM0     = V_H_DIM * R_BPP          // 128
  var R_TILE_DIM0_PAD = R_TILE_DIM0 + LDS_PADDING  // 144

  set_vgpr_msb(QUIET)
  // Base for row=N, col group selected by lane[4]: row*(128+pad) + lane[4]*16B.
  v_and_b32      v_tmp0, v0, 0xf
  v_mul_u32_u24  v_tmp0, v_tmp0, R_TILE_DIM0_PAD
  v_lshrrev_b32  v_tmp1, 4, v0
  v_lshlrev_b32  v_tmp1, 4, v_tmp1
  v_add_nc_i32   v_tmp0, v_tmp0, v_tmp1
  v_add_nc_i32   v_tmp0, v_tmp0, K_LDS_BASE

  // Ensure v_tmp0 (LDS write address) and v_R[msb] (just produced by
  // v_cvt_pk_bf16_f32 in pa_finalize_output) retire before ds_store consumes
  // them as address/data. Otherwise X-data may be written into LDS and later
  // poison the global_store_async_from_lds_b64 read pipe (LDSO/lane_xbar DED).
  s_wait_alu { va_vdst: 0 }

  for var msb in [0:VGPR_SEG_NUM - 1]
    var m_tile = msb / 2                    // query rows 0..15 / 16..31
    var hdim_half = msb % 2                 // cols 0..31 / 32..63
    var seg_offset = m_tile * 16 * R_TILE_DIM0_PAD + hdim_half * 64
    set_vgpr_msb(QUIET, v0, v_tmp0, v_R[msb])
    for var i in [0:4:R_VGPR_SECT_SIZE / 2 - 1]
      // i=0 stores cols {0..7 or 8..15}  // i=4 stores cols {16..23 or 24..31}.
      ds_store_b128 v_tmp0, v_8bit(v_R[msb][i]) offset: seg_offset + i * 8
    end
  end
  s_wait_dscnt 0

  // ---- Phase 2: Async LDS-to-global store, per MTP layer ----
  // For each active mtp_lvl (0..s_mtp):
  //   Write 8 gqa rows × 128 bytes = 1024 bytes to
  //     s_R_addr + mtp_lvl * s_R_mtp_stride
  //   using 4 × global_store_async_from_lds_b64 (256 bytes / call = 2 rows).
  //
  // Per-call layout (32 lanes × 8 bytes = 256 bytes = 2 rows × 128 bytes):
  //   lanes  0..15 : row R    bytes (l & 0xf) * 8 .. +7
  //   lanes 16..31 : row R+1  bytes (l & 0xf) * 8 .. +7
  // LDS rows are padded to R_TILE_DIM0_PAD (144), so per-lane LDS offset:
  //   lds_off = (l >> 4) * R_TILE_DIM0_PAD + (l & 0xf) * 8
  // Global memory is unpadded (128 bytes/row), so:
  //   mem_off = (l >> 4) * R_TILE_DIM0 + (l & 0xf) * 8
  //           = (l >> 4) * 128 + (l & 0xf) * 8

  set_vgpr_msb(QUIET)
  // v_tmp0 = LDS source base (padding-aware): (l>>4)*144 + (l&0xf)*8 + K_LDS_BASE
  v_and_b32      v_tmp0, v0, 0xf
  v_lshlrev_b32  v_tmp0, 3, v_tmp0                       // (l & 0xf) * 8
  v_lshrrev_b32  v_tmp1, 4, v0
  v_mul_u32_u24  v_tmp1, v_tmp1, R_TILE_DIM0_PAD         // (l >> 4) * 144
  v_add_nc_i32   v_tmp0, v_tmp0, v_tmp1
  v_add_nc_i32   v_tmp0, v_tmp0, K_LDS_BASE

  // v_tmp1 = global dest base (unpadded): (l>>4)*128 + (l&0xf)*8 = l*8
  v_lshlrev_b32  v_tmp1, 3, v0

  // Emit 4 mtp layers unrolled, each guarded by s_mtp >= mtp_lvl.
  // The instruction does not accept offset_mem/offset_lds modifiers, so we
  // bake all per-chunk/per-mtp offsets directly into v_tmp0 (LDS src) and
  // v_tmp1 (global dst). Each chunk covers 2 rows.
  //   per-chunk LDS step = 2 * R_TILE_DIM0_PAD
  //   per-chunk MEM step = 2 * R_TILE_DIM0
  //   per-mtp  LDS step = 8 * R_TILE_DIM0_PAD  (added at start of each mtp,
  //                                              after the chunk loop reset)
  for var mtp_lvl in [0:3]
    if mtp_lvl > 0
      s_cmp_ge_u32  s_mtp, mtp_lvl
      s_cbranch_scc0 r_store_done
      s_add_u32     s_R_addr[0], s_R_addr[0], s_R_mtp_stride
      s_addc_u32    s_R_addr[1], s_R_addr[1], 0
      s_and_b32     s_R_addr[1], s_R_addr[1], 0x1ffffff   // 25-bit aperture mask
      // Advance LDS pointer by 8 rows (one MTP block)  // reverse the 4-chunk
      // backward step that brought v_tmp0 back to the start of prev mtp's
      // first row -> need: +8 rows from prev mtp's start = +8*144 from prev
      // mtp's base. After the prev chunk loop v_tmp0 is at +8 rows already
      // (= prev_base + 8 rows), so just add 0 here? No: chunk loop adds 4
      // times per_chunk_lds = 4*288 = 1152 = 8 rows. So v_tmp0 already
      // points at next mtp's base. Nothing to do.
    end
    for var chunk in [0:3]
      s_wait_alu { va_vdst: 0 }
      set_vgpr_msb(QUIET, v0, v_tmp1, v_tmp0)
      global_store_async_from_lds_b64 v_tmp1, v_tmp0, s_R_addr
      // The async LDSO/lane_xbar DMA reads v_tmp1 (global vaddr) and
      // v_tmp0 (LDS source) over a window that outlasts a normal VMEM
      // source-read. The v_add_nc_u32 pair below WARs both registers  // on
      // silicon this corrupts the in-flight store's address operands and
      // produces an illegal memory access. (Emu collapses the async store
      // so this WAR is invisible there.) Drain VM_VSRC before the v_add.
      s_wait_alu { vm_vsrc: 0 }
      // Advance LDS / global pointers by 2 rows for the next chunk.
      // (For the last chunk of the last mtp this is a harmless dead update.)
      set_vgpr_msb(QUIET, v_tmp0, v_tmp0)
      v_add_nc_u32  v_tmp0, v_tmp0, 2 * R_TILE_DIM0_PAD
      set_vgpr_msb(QUIET, v_tmp1, v_tmp1)
      v_add_nc_u32  v_tmp1, v_tmp1, 2 * R_TILE_DIM0
    end
    // Reset global offset for the next MTP layer (s_R_addr is advanced by
    // s_R_mtp_stride at the top of the next iter, which already accounts
    // for the inter-MTP gap). v_tmp1 has been incremented by 4 chunks =
    // 8 rows = 1024 bytes  // we need it to restart at l*8 for next mtp.
    set_vgpr_msb(QUIET, v_tmp1, v_tmp1)
    v_add_nc_u32  v_tmp1, v_tmp1, -8 * R_TILE_DIM0
  end

r_store_done:
end

// ============================================================================
// Section 20: Main Shader Entry Point
// ============================================================================

shader main
  type(CS)
  wave_size(32)
  vgpr_count(1024)
  user_sgpr_count(2)

  tgid_x_en(1)
  tgid_y_en(1)
  tgid_z_en(1)

  set_sched_mode(2)   // Expert scheduling mode

  // ===== Load kernel arguments =====
  s_and_b32            s1, s1, 0x1ffffff

  // ABI: softmax_scale (by value) sits at 0x60, just after CtxLen; the per-tensor
  // scale POINTERS and all following args are therefore each shifted +0x10
  // relative to the pre-softmax_scale layout (QScale 0x70 .. Sink 0x160).
  s_load_dwordx2       s_R_addr,           s[0:1], 0x0
  s_load_dwordx2       s_Q_addr,           s[0:1], 0x10
  s_load_dwordx2       s_K_addr,           s[0:1], 0x20
  s_load_dwordx2       s_V_addr,           s[0:1], 0x30
  s_load_dwordx2       s_KVIndices_addr,   s[0:1], 0x40
  s_load_dwordx2       s_CtxLen_addr,      s[0:1], 0x50
  s_load_dword         s_KV_nheads,        s[0:1], 0xA0
  s_load_dword         s_Q_mtp_stride,     s[0:1], 0xB0    // one FP8 Q MTP layer in bytes
  s_load_dword         s_K_blk_stride,     s[0:1], 0xC0
  s_load_dword         s_K_head_stride,    s[0:1], 0xD0
  s_load_dword         s_mtp,              s[0:1], 0xE0
  s_load_dword         s_gqa_ratio,        s[0:1], 0xF0
  // 0x100 QOIndptr is accepted for PA_PS interface compatibility but unused  //
  // q/o layout is fixed by mtp/gqa for this decode kernel.
  s_load_dwordx2       s_KVIndptr_addr,    s[0:1], 0x110
  s_load_dwordx2       s_WorkIdx_addr,     s[0:1], 0x120
  s_load_dwordx2       s_WorkInfo_addr,    s[0:1], 0x130
  s_load_dwordx2       s_PartialO_addr,    s[0:1], 0x140
  s_load_dwordx2       s_PartialLSE_addr,  s[0:1], 0x150

  // W1: hoist the 3 scale-address loads up here so all 14 dwordx2 args batch
  // into a single s_wait_kmcnt 0 below (was: 11 + wait + 3 + wait).
  s_load_dwordx2 s_R_base_addr, s[0:1], 0x70   // QScale_addr
  s_load_dwordx2 s_tmp0,        s[0:1], 0x80   // KScale_addr (s_tmp0:s_tmp1)
  s_load_dwordx2 s_tmp2,        s[0:1], 0x90   // VScale_addr (s_tmp2:s_tmp3)

  // ===== SPI input processing =====
  v_and_b32            v0, 0x1f, v0

  get_grid_coords()

  s_wait_kmcnt 0    // single wait covers args + scale-addresses

  for var addr in [s_R_addr, s_Q_addr, s_K_addr, s_V_addr, s_KVIndices_addr, s_CtxLen_addr, s_KVIndptr_addr, s_WorkIdx_addr, s_WorkInfo_addr, s_PartialO_addr, s_PartialLSE_addr, s_R_base_addr]
    s_and_b32 addr[1], addr[1], 0x1ffffff
  end
  s_and_b32 s_tmp1, s_tmp1, 0x1ffffff
  s_and_b32 s_tmp3, s_tmp3, 0x1ffffff

  // Issue scale value loads  // wait deferred (W2) until the first consumer below.
  s_load_dword s_query_scale, s_R_base_addr, 0x0
  s_load_dword s_key_scale,   s_tmp0,        0x0
  s_load_dword s_value_scale, s_tmp2,        0x0

  // WHOIST: pull WorkIdx load up here alongside the scale-value loads so the
  // W2 s_wait_kmcnt 0 below drains BOTH groups in parallel. The 3 scale-value
  // loads issued just above have already SAMPLED s_tmp0 as KScale_addr — we
  // can now overwrite s_tmp0 with the WorkIdx offset without affecting them.
  // Their writebacks target s_query/key/value_scale, disjoint from s_work_start.
  // Saves the dedicated ~1300 cyc WorkIdx wait that was firing right before
  // work_loop_start in ATT 256_6 (PC=7548).
  s_lshl_b32     s_tmp0, s_tg_idx, 2
  s_load_dwordx2 s_work_start, s_WorkIdx_addr, s_tmp0

  // IPREFETCH: warm I$ for the hot path (main entry tail + load_initial_data +
  // first core_loop_iteration + the core_loop body). 100 KB sized for the
  // PEELAST layout — 5 inlined callsites of core_loop_iteration (iter 0, odd,
  // even, peeled_last_buf1, peeled_last_buf0) span ~97 KB of binary from
  // byte ~700 to ~98000. The original 60 KB only covered the first ~3.2
  // callsites, leaving peeled_last_buf{0,1} (last ~37 KB) un-prefetched —
  // observed as last-iter I$ miss in att_dump_b64_08_1. Wave 0 only.
  //
  // PLACEMENT: this fires AFTER the kArgs/scale-address kmcnt wait and AFTER
  // the 3 scale-value loads have ISSUED. Reasons:
  //   1. kArg/scale-addr loads targeted s_tmp0/s_tmp1/s_tmp2  // they MUST be
  //      drained before we clobber those SGPRs as prefetch scratch, otherwise
  //      a late writeback could overwrite our PC value and the next
  //      s_prefetch_inst would I-fetch from a garbage (scale-pointer) address
  //      and trigger an illegal memory access on silicon.
  //   2. The 3 scale-value loads SAMPLE s_tmp0/s_tmp2 at issue, then write to
  //      DIFFERENT SGPRs (s_query/key/value_scale). So clobbering s_tmp0..2
  //      after the loads have issued is harmless to them.
  // IPREFETCH-FIT64K: shrunk from 100 KB to 64 KB to match I$ capacity. The
  // prior 100 KB prefetch overshot the I$, so the last 36 KB of prefetched
  // lines evicted the first 36 KB of the body before the core loop reached
  // them, regressing hot-PC fetch idle. 64 KB now covers the front of the
  // body up to byte ~0x10184 (within core_loop).
  //
  // IPREFTUNE (retune for this build, ATT b64 nsm.dso.cvthilat): measured PCs
  // are site0 ~0x1c6c (v7276), steady core_loop v26580..v59496, peeled-last
  // iters v~60000..73000, endpgm v108352. 64 KB from v7276 reaches v73044 —
  // 13.6 KB PAST steady core_loop_exit, into the peeled-last region that sites
  // 1/3 ALREADY prefetch. When the resident window exceeds I$, that redundant
  // tail evicts the core_loop ENTRY (observed: fetch idle at loop top v26580,
  // not at loop end). Trim to 52 KB so the window ends at steady core_loop_exit
  // (v7276+53248=v60524); peeled-last stays covered by sites 1/3.
  prefetch_instructions(0, 52*1024)

  s_mov_b64 s_R_base_addr, s_R_addr
  init_buffer_default(s_PartialO_addr)
  init_buffer_default(s_PartialLSE_addr)

  // ===== Compute derived constants =====
  // Fold scalar Q/K scales, softmax_scale and log2(e) into s_key_scale once so
  // the softmax path consumes query_scale * key_scale * softmax_scale * log2(e).
  // s_log2e is only kept for existing softmax math that needs ln(2).
  s_mov_b32   s_log2e,     kLog2eF32       // temporary for ln(2)=1/log2(e)
  set_vgpr_msb(QUIET)
  v_mov_b32   v_tmp0, s_log2e
  v_rcp_f32   v_tmp1, v_tmp0
  v_readfirstlane_b32 s_loge2, v_tmp1
  // softmax_scale (by-value f32 kernarg, 0x60). The SGPR file is full, so reuse
  // the temporary s_tmp0: it is dead here (last touched by the wave-0 prefetch)
  // and is re-initialized fresh below in the stride math. Issued before the W2
  // wait so that wait drains it alongside the 3 scale-value loads.
  s_load_dword s_tmp0, s[0:1], 0x60
  // W2: slid scale-value wait down here — covers the 3 s_load_dwords above plus
  // the softmax_scale load, overlapping their latency with init_buffer_default
  // + log2e setup.
  s_wait_kmcnt 0
  v_mov_b32   v_tmp0, s_key_scale
  v_mov_b32   v_tmp1, s_query_scale
  set_vgpr_msb(QUIET, v_tmp0, v_tmp0, v_tmp1)
  v_mul_f32   v_tmp0, v_tmp0, v_tmp1
  v_mov_b32   v_tmp1, s_log2e
  set_vgpr_msb(QUIET, v_tmp0, v_tmp0, v_tmp1)
  v_mul_f32   v_tmp0, v_tmp0, v_tmp1
  v_mov_b32   v_tmp1, s_tmp0               // softmax_scale (by-value, 0x160)
  set_vgpr_msb(QUIET, v_tmp0, v_tmp0, v_tmp1)
  v_mul_f32   v_tmp0, v_tmp0, v_tmp1
  v_readfirstlane_b32 s_key_scale, v_tmp0
  s_mov_b32   s_log2e, kOneF32

  // PA_PS stride_Q is one Q MTP layer in bytes:
  //   kv_heads * gqa * head_dim * sizeof(FP8).
  // R uses the same logical layout but BF16 elements, so derive a separate
  // output stride instead of aliasing the FP8 Q stride.
  s_add_i32   s_tmp0, s_mtp, 1
  s_mul_i32   s_Q_batch_stride, s_Q_mtp_stride, s_tmp0
  s_lshl_b32  s_R_mtp_stride, s_Q_mtp_stride, 1
  s_mul_i32   s_R_batch_stride, s_R_mtp_stride, s_tmp0

  // WHOIST: WorkIdx s_load_dwordx2 was hoisted above into the W2 wait batch.
  // s_work_start / s_work_end are already valid here (drained by W2's
  // s_wait_kmcnt 0 along with the scale-value loads).

work_loop_start:
  s_cmp_lt_i32        s_work_start, s_work_end
  s_cbranch_scc0      program_exit

  // VGPR-MSB RE-ENTRY FIX: work_loop_start is a branch target. On the back-edge
  // from a split work item, the partial-store tail leaves the HW VGPR MSB at
  // dst_msb=3 (last s_set_vgpr_msb before the back-edge). The per-work setup
  // below — notably the ENABLE_SINK address build `v_and v_SINK_addr[0], v0, 7`
  // — reads v0 (lane id, segment 0) and other scratch assuming MSB=0, but its
  // set_vgpr_msb(QUIET,...) is ELIDED because the compile-time tracker assumes
  // the prologue's MSB=0 (it can't see the back-edge state). Result on varlen
  // re-entry: v0 is read from segment 3 (garbage) -> wild per-lane sink address
  // -> page fault. Force MSB back to 0 here so runtime matches the tracker on
  // every iteration (no-op cost on the first, prologue-entered iteration).
  reset_vgpr_msb()

  // Load ps::WORK_INFO (8 dwords).
  s_lshl_b32          s_tmp0, s_work_start, 5
  s_load_dwordx8      s_batch_idx, s_WorkInfo_addr, s_tmp0

  // IPREFETCH-WL: re-warm I$ for the main loop body (work_loop_start ..
  // core_loop_exit). The initial prefetch_instructions(0, 100*1024) issued
  // before work_loop_start has long been evicted by the time we re-enter
  // for the 2nd+ outer iteration (ATT att_dump_b64_h64_16k_no_warm showed
  // ~5 kcyc of icache-miss idle in the 2nd outer iter at PCs 0x099fc,
  // 0x0c438→0x0df84, 0x02cc4 — all inside the original prefetch range but
  // ~90k cycles stale). Re-issuing here fires from work_loop_start's PC
  // so it covers the full body.
  //
  // PLACEMENT: AFTER the s_load_dwordx8 has issued (it already sampled
  // s_tmp0 as offset, so we can clobber s_tmp0..s_tmp2 as prefetch scratch)
  // and BEFORE the s_wait_kmcnt 0, so the ~15 s_prefetch_inst issues hide
  // under the WorkInfo load latency. Wave 0 only (gated inside the function).
  // IPREFETCH-FIT64K: shrunk from 100 KB to 64 KB to match I$ capacity. See
  // the matching comment at site 0 (prefetch_instructions(0, ...)).
  //
  // IPREFTUNE (retune for this build): site2 ~v7584; 64 KB reaches v73120,
  // 13.6 KB past steady core_loop_exit (v59496) into the peeled-last region
  // (covered by sites 1/3). Trim to 52 KB (reach v60832) so site2's tail no
  // longer evicts the core_loop entry from I$ on re-warm. See site 0 note.
  prefetch_instructions(2, 52*1024)

  s_wait_kmcnt 0

  // W4: issue the dependent CtxLen + KVIndptr loads ASAP so their latency
  // overlaps the SALU work below (mask + mov chain), then wait once at the
  // bottom. Same wait count as before but the loads now run in parallel with
  // ~5 SALU insts instead of serially after them.
  s_lshl_b32          s_tmp0, s_batch_idx, 2
  s_load_dword        s_seq_len, s_CtxLen_addr, s_tmp0
  s_load_dword        s_KV_batch_start, s_KVIndptr_addr, s_tmp0

  // SINK: reload ptr_Sink from kArg into scratch s_tmp0:s_tmp1. CtxLen +
  // KVIndptr have already SAMPLED s_tmp0 above so it can be overwritten now.
  // Sharing the existing s_wait_kmcnt 0 below avoids any extra wait.
  if ENABLE_SINK == 1
    s_load_dwordx2    s_tmp0, s[0:1], 0x160
  end

  // WorkInfo layout: batch, partial_o_loc, qo_start, qo_end, kv_start,
  // kv_end, kv_offset, q_head_range. q_head_range low 16 bits is q head start.
  s_and_b32           s_Q_head_range, s_Q_head_range, 0xffff
  // D64 decode requires GQA=8, so kv_head = q_head_start / 8.
  s_lshr_b32          s_KV_head, s_Q_head_range, 3
  s_mov_b32           s_tg_idx, s_batch_idx
  s_mov_b32           s_tg_idy, s_KV_head
  s_mov_b64           s_R_addr, s_R_base_addr

  // Wait for CtxLen + KVIndptr (+ optional SINK_buf) loads issued above.
  s_wait_kmcnt 0

  // SINK: build a 64-bit per-lane address in v_SINK_addr[0:1] and issue
  // the per-lane sink-logit load via the (vaddr64, off) form — the only
  // global_load form used elsewhere in this kernel.
  //   addr_lo[lane] = s_tmp0 + (q_head_start + (lane & 7)) * 4
  //   addr_hi[lane] = s_tmp1 + carry
  // The load's writeback to v_SINK is awaited inside pa_normalize_output_fp32
  // (s_wait_loadcnt 0 there, hidden under the full K-loop runtime).
  if ENABLE_SINK == 1
    s_and_b32     s_tmp1, s_tmp1, 0x1ffffff              // 25-bit aperture mask
    // MSB SELF-CONTAIN: the sink address build reads v0 (lane id, segment 0). The
    // set_vgpr_msb(QUIET,...) below is elided when the tracker already reads 0, so
    // it relies on the upstream work_loop_start reset_vgpr_msb() (which forces the
    // back-edge's inherited MSB=3 back to 0). Force it locally so this path is
    // self-contained — a future edit inserting MSB code between work_loop_start and
    // here can't reintroduce the segment-3 garbage-v0 page fault. Cost: 1 SALU.
    reset_vgpr_msb()
    set_vgpr_msb(QUIET, v_SINK_addr[0], v0)
    v_and_b32     v_SINK_addr[0], v0, 7
    v_lshlrev_b32 v_SINK_addr[0], 2, v_SINK_addr[0]      // (lane & 7) * 4
    s_lshl_b32    s_tmp2, s_Q_head_range, 2              // q_head_start * 4
    s_add_u32     s_tmp0, s_tmp0, s_tmp2                 // base += q_head_start*4
    s_addc_u32    s_tmp1, s_tmp1, 0                      // propagate carry
    s_wait_alu { va_vdst: 0 }
    set_vgpr_msb(QUIET, v_SINK_addr, v_SINK_addr[0])
    v_add_co_u32       v_SINK_addr[0], vcc, s_tmp0, v_SINK_addr[0]
    v_add_co_ci_u32    v_SINK_addr[1], vcc, s_tmp1, 0, vcc
    s_wait_alu { va_vdst: 0 }                            // vmem reads v_SINK_addr
    set_vgpr_msb(QUIET, v_SINK, v_SINK_addr)
    // SINK-OWNER: the sink is a per-row virtual logit that must be added to the
    // softmax denominator EXACTLY ONCE per row. A row's KV range may be split
    // across several work items; the OWNER is the one covering the row's first KV
    // chunk, identified by s_KV_start == s_KV_batch_start (the scheduler always
    // emits the first chunk with cur_block==0 -> kv_start == kvp[batch]; this also
    // covers the direct-O case, partial_o_loc==-1, which is the whole tile). Load
    // the sink ONLY on the owner; non-owner splits skip it and skip the merge in
    // store_partial_results, so the sink is never double-counted. (set_vgpr_msb is
    // not branched over, so VGPR-MSB tracking is intact.)
    s_cmp_eq_i32   s_KV_start, s_KV_batch_start          // owner = row's first KV chunk?
    s_cbranch_scc0 skip_sink_load                        // non-owner -> skip the load
    global_load_b32 v_SINK, v_SINK_addr, off             // vaddr64, off
  skip_sink_load:
  end

  // Exclusive token boundary for this work within the current batch.
  s_sub_i32           s_KV_work_end_token, s_KV_end, s_KV_batch_start
  s_lshl_b32          s_KV_work_end_token, s_KV_work_end_token, PAGE_SIZE_LOG2
  s_min_i32           s_KV_work_end_token, s_KV_work_end_token, s_seq_len

  // Work-local loop count in pages. Waves process pages kv_start+wave_id,
  // kv_start+wave_id+4, ...
  s_sub_i32     s_tmp0, s_KV_end, s_KV_start       // pages in this work
  s_sub_i32     s_total_pages_m1, s_KV_end, 1
  s_add_i32     s_loop_cnt, s_tmp0, WAVES - 1
  s_lshr_b32    s_loop_cnt, s_loop_cnt, WAVES_LOG2

  s_add_i32     s_page_idx, s_KV_start, s_wave_id
  s_mov_b32     s_loop_idx, 0

  // NOTE: no early-exit. All 4 waves must participate in wgp_barrier /
  // cross_wave_reduce. Waves whose starting page is out-of-range are kept
  // correct by (a) s_min_i32 clamp on s_tdm_page before every TDM load and
  // (b) pa_border_mask() zeroing contributions from OOB tokens.

  // ===== Set up LDS wave offsets & loader-side state =====
  // UNILOAD (Opt-40): each of the 4 waves loads 1 K tile + 1 V tile per iter
  // (was: waves 0/1 each loaded 2 K, waves 2/3 each loaded 2 V). Each wave owns
  // exactly one physical tile per buffer-half, used for BOTH its TDM store and
  // its compute read (s_TDM_wave_offset == s_LDS_wave_offset), so the page it
  // processes is always s_loader_base_page = s_KV_start + w (advances by WAVES).
  //
  // SMXBC LDS-SEGMENT-CONFLICT FIX: tile placement is bit-swapped, NOT monotonic.
  // The 4 waves run on SIMD 0/1/2/3, paired {0,2} and {1,3}; the HW forbids both
  // SIMD pairs touching the same 64KB LDS segment simultaneously. Buffers are
  // based at 32KB, so each 64KB buffer's midpoint lands exactly on a segment
  // boundary (low 32KB = one segment, high 32KB = the next). A monotonic
  // wave->tile map (w*16KB) puts SIMD0+SIMD1 in the low segment and SIMD2+SIMD3
  // in the high segment => BOTH pairs hit each segment => conflict every iter.
  // Bit-swapping wave_id (0,1,2,3 -> 0,2,1,3) confines pair {0,2} to tiles {0,1}
  // (low segment) and pair {1,3} to tiles {2,3} (high segment): no segment is
  // shared by two pairs. Swapping the offset (not the page) keeps the page math
  // and the producer/consumer slot-content invariant byte-identical.
  //   swapped = ((w & 1) << 1) | (w >> 1)     // 0->0 1->2 2->1 3->3
  s_lshr_b32    s_tmp1, s_wave_id, 1              // bit1 of wave_id
  s_and_b32     s_tmp0, s_wave_id, 1             // bit0 of wave_id
  s_lshl_b32    s_tmp0, s_tmp0, 1               // bit0 << 1
  s_or_b32      s_tmp0, s_tmp0, s_tmp1          // bit-swapped wave (0,2,1,3)
  s_lshl_b32    s_TDM_wave_offset, s_tmp0, 14   // *16KB = LDS_BLOCK_SIZE
  s_mov_b32     s_LDS_wave_offset, s_TDM_wave_offset
  s_add_i32     s_loader_base_page, s_KV_start, s_wave_id

  // ===== Initialize VGPRs =====
  set_vgpr_msb(QUIET, v_NEG_INF)
  v_mov_b32     v_8bit(v_NEG_INF), NEG_INF

  for var i in [0:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_max[i])
    v_mov_b32   v_8bit(v_max[i]), MAX_INIT   // MAXINIT: was MIN_F32 (scl*MIN_F32 overflowed → NaN at large scale)
  end

  for var i in [0:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_L[i])
    v_mov_b32   v_8bit(v_L[i]), 0
  end

  for var msb in [0:VGPR_SEG_NUM - 1]
    set_vgpr_msb(QUIET, v_R[msb])
    for var i in [0:2:R_VGPR_SECT_SIZE - 1]
      v_mov_b32 v_8bit(v_R[msb][i]), 0
      v_mov_b32 v_8bit(v_R[msb][i + 1]), 0
    end
  end

  s_mov_b32 s_permlanex16_sel[0], 0x76543210
  s_mov_b32 s_permlanex16_sel[1], 0xfedcba98

  // ===== TDM Initialization =====
  K_TDM_init()
  V_TDM_init()

  // ===== Generate LDS read addresses =====
  K_LDS_rd_addr_gen()

  // ===== Load Q directly into VGPRs =====
  // QOVL-DEFER: Q global_load issues async here; the wait + cndmask into v_Q
  // are deferred to Q_global_load_finalize AFTER load_initial_data. Q's HBM
  // fetch (~2730 cyc cold per outer iter in att_dump_b64_08_1 PC 1836) now
  // overlaps load_initial_data's tensorcnt wait (~4588 cyc cold, PC 3036).
  // Q_apply_per_tensor_scale only touches s_key_scale / v_scl_log2e — it does
  // NOT read v_Q — so it safely runs while Q is still in flight. v_K[0:1] is
  // tied up as Q staging across this window, but K TDMs land in LDS (not
  // VGPRs) so there is no aliasing.

  // BTEARLY: hoist iter-0's first K BT lookup (the s_load_dword of s_phys_blk_idx)
  // out of load_initial_data to HERE, so its kmcnt drains while Q_compute_addr +
  // Q_global_load_issue + Q_apply run, letting load_initial_data's first
  // K_TDM_load_half(0) issue its TDM sooner (its cold ~7k tensorcnt wait then
  // starts earlier and overlaps more prologue work). Trace: this BT kmcnt
  // stalled ~1901 cyc inside load_initial_data; here it overlaps Q setup.
  // SAFE: inputs ready (s_total_pages_m1 @top, s_loader_base_page=s_KV_start+wave_id
  // set above, s_KVIndices_addr is an arg); s_loader_base_page is NOT advanced
  // before load_initial_data's K_TDM_load_half(0), so the page is identical; the
  // Q functions don't touch s_phys_blk_idx/s_tdm_page_aux, and the lookup's
  // s_tmp0-2 are consumed by its own s_load so later clobbering is harmless.
  K_TDM_lookup_issue()

  Q_compute_addr()
  Q_global_load_issue()
  Q_apply_per_tensor_scale()

  // ===== Load initial K/V data =====
  // QOVL-DEFER-FIX: Q_global_load_finalize is invoked INSIDE load_initial_data
  // (between the wait_tensorcnt 2 + barrier and the K_LDS_load loop) so v_K
  // staging is consumed before K_LDS_load overwrites it. Overlap with the
  // dominant cold-TDM window is preserved.
  load_initial_data()

  // V LDS read addresses and per-row border mask were prepared inside
  // load_initial_data() while the initial K/V TDMs were in flight.

  // ===== Unified first iteration + PEELAST peeled-last codepaths =====
  // DBLPRE: init already loaded buf 0 AND buf 1 for both K and V. Iter 0
  // prefetches K_TDM_load_half(buf_idx=0) and V_TDM_load_half(buf_idx=0) for
  // iter 2's consumption (deepening the inflight pipeline back up to 4 TDMs
  // per loader wave). Both run under do_prefetch=TRUE.
  //
  // PEELAST (Opt-28): the last iter is peeled into a separate codepath
  // (peeled_last_buf0 / peeled_last_buf1) so the main-loop body can compile
  // with is_last=FALSE — eliding 5 internal is-last runtime gates per iter
  // (BTPF-K, BTPF-V, K-TDM, K-wait, V-TDM) plus the wmmaco K-enabled/no-K
  // cbranch. loop_cnt==1 is rare and falls through the normal path: iter 0
  // wastes a K prefetch (do_prefetch=TRUE), then the early-exit below skips
  // the peeled_last call. Dropping the single_iter_path callsite saves ~18KB
  // of inlining bloat (kernel was overflowing SBRA ±128KB branch range).

  // DEPEEL (TDM-OOB): the last/overflow iterations are NO LONGER peeled. Every
  // iteration runs the full body with do_prefetch=TRUE / is_last=FALSE; the
  // next-iter K/V TDM prefetch auto-nops on overflow pages via the TDM-OOB-NOP
  // in K_TDM_load_half / V_TDM_load_half (DIM1+TILE0/1 = 0 when loader page >
  // s_total_pages_m1). The consumed page is still clamped + border-masked, and a
  // nop'd prefetch buffer is never consumed (no next iter). This removes the two
  // peeled_last_buf0/buf1 codepaths AND the per-iter peel-check (s_add/s_cmp_lt/
  // s_cbranch ×2 sites) — replaced by a plain counted back-edge. 2x odd/even
  // unroll kept for compile-time buf_idx (LDS double-buffer half).
  //
  // s_loop_idx is incremented at the END of core_loop_iteration, so after iter N
  // it holds N+1. Loop while s_loop_idx < s_loop_cnt.

  core_loop_iteration(0, 1, TRUE, TRUE, FALSE)  // iter 0 (buf0), first; s_loop_idx -> 1

core_loop_start:
  s_cmp_ge_i32  s_loop_idx, s_loop_cnt
  s_cbranch_scc1 core_loop_exit                 // done (also handles loop_cnt==1)
  core_loop_iteration(1, 0, FALSE, TRUE, FALSE) // odd iter (buf1)
  s_cmp_ge_i32  s_loop_idx, s_loop_cnt
  s_cbranch_scc1 core_loop_exit                 // done after an odd iter
  core_loop_iteration(0, 1, FALSE, TRUE, FALSE) // even iter (buf0)
  s_branch core_loop_start

core_loop_exit:
  // XWR-IPF: the de-peel dropped the peeled-body I$ prewarm for the post-loop
  // tail (cross_wave_reduce + finalize/store). Because that tail is reached by a
  // branch out of the loop, it is COLD in the stragglers' per-SIMD I$ after the
  // ~80 KB main loop. Re-added as a single all-waves prefetch just below (sized
  // to endpgm - site PC for this exact build). Loop-body sites 0/2 unaffected.

  // DBLPRE: the last gemm_qk/pv_phase still issued a K/V prefetch (iter
  // loop_cnt-2's "wasted" prefetch into the unused half — kept to preserve
  // uniform inflight depth through iter loop_cnt-1's KHOIST/V wait). Drain
  // those leftover TDMs before cross_wave_reduce reuses K/V LDS as scratch.
  s_wait_idle

  // XWR-IPF: warm the post-loop tail I$ on ALL waves (each warms its own SIMD).
  // Issued here so the async s_prefetch_inst overlap cross_wave_reduce's Phase-0/1
  // VALU and the Phase-2 wgp_barrier. HW lookahead enable stays wave-0-only.
  // SIZE (verified kernel.text, this build): site PC 0xCE28, cross_wave_reduce
  // entry 0xCE78, s_endpgm 0x10EB4. Need >= 0x10EB4-0xCE28 = 16524 B; 18*1024
  // reaches 0x115E8 (1908 B past endpgm) which lands inside the mapped 2048-NOP
  // guard, so it can never fault. Recompute if code size changes.
  prefetch_instructions(1, 18*1024, 0, 1)

  // ===== Cross-Wave Reduction (combine 4 waves' partial max/L/D) =====
  cross_wave_reduce()

  // SINK-DOMAIN (Triton / GPT-OSS match): the in-kernel sink merge multiplies the
  // sink by scl_log2e (= query*key*softmax*log2e = s_eff*log2e), i.e. it treats the
  // sink as a RAW pre-scale logit -> contributes exp(sink*s_eff). Triton/GPT-OSS
  // define the sink as a SCALED-domain logit (compared directly to (q.k)*s_eff) ->
  // exp(sink). Pre-divide the loaded sink by s_eff ONCE here (sink load issued in
  // the prologue is long complete) so the merge's *s_eff cancels:
  //   exp((sink/s_eff)*s_eff) = exp(sink).  Callers now pass self.sinks directly.
  // s_eff = s_key_scale * ln2   (s_key_scale = query*key*softmax*log2e; s_loge2=ln2).
  // Unconditional (compile-gated): non-owner split items never read v_SINK, so a
  // divided-garbage value there is inert.
  if ENABLE_SINK == 1
    s_wait_loadcnt 0
    reset_vgpr_msb()
    v_mov_b32   v_tmp0, s_key_scale
    v_mul_f32   v_tmp0, v_tmp0, s_loge2          // s_eff
    s_wait_alu { va_vdst: 0 }
    v_rcp_f32   v_tmp0, v_tmp0                   // 1 / s_eff
    s_wait_alu { va_vdst: 0 }
    v_mul_f32   v_SINK, v_SINK, v_tmp0           // sink := sink / s_eff (scaled-domain)
  end

  // ===== Output current work =====
  // partial_idx == -1: this work covers the final KV chunk for its Q tile and
  // can write final bf16 O. Otherwise write FP32 SplitO/SplitLSE for host reduce.
  s_cmp_eq_i32 s_partial_idx, -1
  s_cbranch_scc0 partial_output_path

  pa_finalize_output()
  s_cmp_eq_u32  s_wave_id, 0
  s_cbranch_scc0 work_done
  R_store_to_global()
  s_branch work_done

partial_output_path:
  s_cmp_eq_u32  s_wave_id, 0
  s_cbranch_scc0 work_done
  store_partial_results()

work_done:
  s_wait_idle
  wgp_barrier()
  s_add_i32 s_work_start, s_work_start, 1
  s_branch work_loop_start

program_exit:
  s_wait_idle
  s_endpgm

  // ICACHE-GUARD (NSM): the per-msb staged softmax shrank the binary ~19 KB
  // (endpgm PC 0x189C0 ~= 100800 vs baseline ~120 KB), moving the executed tail
  // (cross_wave_reduce / pa_normalize / pa_finalize_output near program_exit)
  // close to the end of the mapped code region. With HW instruction prefetch
  // enabled (set_inst_prefetch(1), never disabled), the prefetcher reads ahead
  // of the PC and ran off the end into an UNMAPPED page → GCVM page fault,
  // client SQC(inst), no-retry. Surfaced as an IMA at batch 32/64 only because
  // the persistent work-loop re-enters this tail per work-item. Baseline didn't
  // fault because its larger code kept the tail far from the mapped boundary.
  // Fix: append a mapped NOP guard so any read-ahead past the real tail lands
  // in valid mapped instructions. 2048 s_nop = 8 KB, well over the look-ahead
  // distance and the ~1.5 KB boundary shortfall. Never executed (after endpgm).
  for var _guard in [0:2047]
    s_nop 0
  end

  // ===== Compilation Statistics =====
  print "Max allocated SGPR: ", _sgpr_max
  for var i in [0:VGPR_SEG_NUM - 1]
    _vgpr_next[i] -= VGPR_SEG_SIZE * i
  end
  print "Max allocated VGPR per segment: ", _vgpr_next

end
